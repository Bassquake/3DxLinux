# systemd *user* unit: the LCD Manager for the SpacePilot PRO LCD (Linux LCDMon).
# Takes the LCD over from 3dxlinuxd while running and starts the LCD applets.
# Enable with:  systemctl --user enable --now 3dxlinux-lcdmgr
[Unit]
Description=3dxlinuxd LCD Manager (LCD applets for the SpacePilot PRO)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/3dxlinux-lcdmgr
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
