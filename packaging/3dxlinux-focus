#!/bin/sh
# 3dxlinux-focus - tell 3dxlinuxd which application has the keyboard focus, so it can
# switch per-application profiles (/etc/3dxlinux.d/*.conf), like 3DxWare does.
#
# Runs in your desktop session (see 3dxlinux-focus.service). Supported:
#   KDE Plasma (Wayland or X11)  through a KWin script (3dxlinux-focus-kwin)
#   sway                         needs swaymsg and jq
#   other X11 desktops           needs xprop   (Debian/Ubuntu: x11-utils)
# Elsewhere (e.g. GNOME on Wayland) 3dxlinuxd falls back to the newest spacenavd
# client (e.g. Blender), and 3dxlinux-focus exits quietly.
DXLINUX_CTL=${DXLINUX_CTL:-3dxlinuxctl}
export DXLINUX_CTL
last=""

# FreeCAD: keep 3dxlinuxd's add-on loader in place (the keys follow the workbench)
command -v 3dxlinux-freecad-addon >/dev/null 2>&1 && 3dxlinux-freecad-addon install >/dev/null 2>&1

kwin_helper() { # 3dxlinux-focus-kwin: installed in lib/3dxlinux, or next to us in the source tree
	here=$(dirname "$(readlink -f "$0")")
	for p in "$here/../lib/3dxlinux/3dxlinux-focus-kwin" /usr/lib/3dxlinux/3dxlinux-focus-kwin \
		 /usr/local/lib/3dxlinux/3dxlinux-focus-kwin "$here/3dxlinux-focus-kwin"; do
		[ -f "$p" ] && { echo "$p"; return 0; }
	done
	return 1
}

app_of_pid() {
	[ -n "$1" ] || return 0
	readlink "/proc/$1/exe" 2>/dev/null | sed 's#.*/##; s/ (deleted)$//'
}

send() { # send APP [PID], skipping repeats
	[ -n "$1" ] || return 0
	[ "$1" = "$last" ] && return 0
	last=$1
	$DXLINUX_CTL focus "$1" ${2:+"$2"} >/dev/null 2>&1 || true
}

if [ -z "${SWAYSOCK:-}" ] && k=$(kwin_helper) && python3 "$k" --check 2>/dev/null; then
	# KDE: on Wayland only KWin knows the active window (xprop below would see
	# XWayland windows only)
	exec python3 "$k" "$@"
elif [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
	swaymsg -m -t subscribe '["window"]' |
	jq --unbuffered -r 'select(.change == "focus") |
		"\(.container.pid // "") \(.container.app_id // .container.window_properties.class // "")"' |
	while read -r pid app; do
		a=$(app_of_pid "$pid")
		send "${a:-$app}" "$pid"
	done
elif [ -n "${DISPLAY:-}" ] && command -v xprop >/dev/null 2>&1; then
	xprop -spy -root _NET_ACTIVE_WINDOW | while read -r line; do
		win=${line##* }
		case "$win" in 0x0|""|*"not found"*) continue ;; esac
		pid=$(xprop -id "$win" _NET_WM_PID 2>/dev/null | sed -n 's/.*= *//p')
		app=$(app_of_pid "$pid")
		if [ -z "$app" ]; then # no PID or another PID namespace (Flatpak): use WM_CLASS
			app=$(xprop -id "$win" WM_CLASS 2>/dev/null | sed -n 's/.*= "[^"]*", "\(.*\)"/\1/p')
		fi
		send "$app" "$pid"
	done
else
	echo "3dxlinux-focus: this desktop is not supported (KDE Plasma, sway, or X11 with xprop);" \
	     "3dxlinuxd follows the newest spacenavd client instead" >&2
	exit 0 # not a failure: the service must not restart it over and over
fi
