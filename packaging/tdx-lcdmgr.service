# systemd *user* unit: the LCD Manager for the SpacePilot PRO LCD (Linux LCDMon).
# Takes the LCD over from tdxd while running and starts the LCD applets.
# Enable with:  systemctl --user enable --now tdx-lcdmgr
[Unit]
Description=tdxd LCD Manager (LCD applets for the SpacePilot PRO)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/tdx-lcdmgr
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
