# systemd *user* unit: the 3Dconnexion icon in the system tray (settings panel,
# log file). Enable with:  systemctl --user enable --now 3dxlinux-tray
[Unit]
Description=3Dconnexion icon in the system tray (3DxLinux)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/3dxlinux-tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
