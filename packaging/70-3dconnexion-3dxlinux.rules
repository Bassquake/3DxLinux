# 3dxlinuxd: access to 3Dconnexion devices for the logged-in user and the 3dxlinuxd service.
# Numbered before 73-seat-late.rules: that is where systemd turns TAG+="uaccess"
# into the logged-in user's ACL. In a later file (it was 99-) the tag comes too
# late and only root can open the LCD - 3dxlinux-lcdmgr, which runs as the user,
# then can't draw and the LCD keeps its idle "SpacePilot PRO" picture.
# hidraw nodes (motion + buttons) for Logitech-era (046d) and 3Dconnexion (256f) devices
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c6[0-2][0-9a-f]", MODE="0660", GROUP="input", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="256f", MODE="0660", GROUP="input", TAG+="uaccess"
# Bluetooth 3Dconnexion devices (no ATTRS{idVendor} on the parent chain)
KERNEL=="hidraw*", KERNELS=="0005:256F:*", MODE="0660", GROUP="input", TAG+="uaccess"

# LCDs on the vendor interface, accessed through usbfs: SpacePilot Pro, SpaceMouse Enterprise, Giotto
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="046d", ATTR{idProduct}=="c629", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="256f", ATTR{idProduct}=="c633", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="256f", ATTR{idProduct}=="c63c", MODE="0660", GROUP="input", TAG+="uaccess"

# uinput for the virtual output device
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"

# The kernel's own input device for the 3D mouse (hid-generic) is classed as a
# mouse (ID_INPUT_MOUSE), so the desktop moved the cursor with the cap. 3dxlinuxd
# reads the device through hidraw and makes its own; hide this one from
# libinput. Only real USB/Bluetooth devices: 3dxlinuxd's virtual ones have no
# USB/Bluetooth parent and stay visible.
# Not the CadMouse, the keyboards and the Universal Receiver (256f:c650-c66f):
# they are ordinary mice and keyboards, and hiding them left the CadMouse
# unable to move the cursor. (A 3D mouse paired to a Universal Receiver would
# stay visible too; untested.)
SUBSYSTEM!="input", GOTO="tdxd_input_end"
ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c65[0-9a-f]", GOTO="tdxd_input_end"
ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c66[0-9a-f]", GOTO="tdxd_input_end"
KERNELS=="0005:256F:C65[0-9A-F].*", GOTO="tdxd_input_end"
KERNELS=="0005:256F:C66[0-9A-F].*", GOTO="tdxd_input_end"
KERNEL=="event*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c6[0-2][0-9a-f]", ENV{LIBINPUT_IGNORE_DEVICE}="1"
KERNEL=="event*", ATTRS{idVendor}=="256f", ENV{LIBINPUT_IGNORE_DEVICE}="1"
KERNEL=="event*", KERNELS=="0005:256F:*", ENV{LIBINPUT_IGNORE_DEVICE}="1"
LABEL="tdxd_input_end"
