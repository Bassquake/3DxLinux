#!/bin/sh
# tdx-focus - tell tdxd which application has the keyboard focus, so it can
# switch per-application profiles (/etc/tdxd.d/*.conf), like 3DxWare does.
#
# Runs in your desktop session (see tdx-focus.service). Supported:
#   X11 / XWayland desktops   needs xprop   (Debian/Ubuntu: x11-utils)
#   sway                      needs swaymsg and jq
# Elsewhere tdxd falls back to the newest spacenavd client (e.g. Blender).
TDXCTL=${TDXCTL:-tdxctl}
last=""

app_of_pid() {
	[ -n "$1" ] || return 0
	readlink "/proc/$1/exe" 2>/dev/null | sed 's#.*/##; s/ (deleted)$//'
}

send() { # send APP [PID], skipping repeats
	[ -n "$1" ] || return 0
	[ "$1" = "$last" ] && return 0
	last=$1
	$TDXCTL focus "$1" ${2:+"$2"} >/dev/null 2>&1 || true
}

if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
	swaymsg -m -t subscribe '["window"]' |
	jq --unbuffered -r 'select(.change == "focus") |
		"\(.container.pid // "") \(.container.app_id // .container.window_properties.class // "")"' |
	while read -r pid app; do
		a=$(app_of_pid "$pid")
		send "${a:-$app}" "$pid"
	done
elif [ -n "${DISPLAY:-}" ] && command -v xprop >/dev/null 2>&1; then
	xprop -spy -root _NET_ACTIVE_WINDOW | while read -r line; do
		win=${line##* }
		case "$win" in 0x0|""|*"not found"*) continue ;; esac
		pid=$(xprop -id "$win" _NET_WM_PID 2>/dev/null | sed -n 's/.*= *//p')
		app=$(app_of_pid "$pid")
		if [ -z "$app" ]; then # no PID or another PID namespace (Flatpak): use WM_CLASS
			app=$(xprop -id "$win" WM_CLASS 2>/dev/null | sed -n 's/.*= "[^"]*", "\(.*\)"/\1/p')
		fi
		send "$app" "$pid"
	done
else
	echo "tdx-focus: needs X11 (xprop) or sway (swaymsg + jq); without it tdxd follows" \
	     "the newest spacenavd client instead" >&2
	exit 1
fi
