# systemd *user* unit: reports the focused application to tdxd for
# per-application profiles. Enable with:  systemctl --user enable --now tdx-focus
[Unit]
Description=Report the focused application to tdxd (per-application profiles)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/tdx-focus
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
