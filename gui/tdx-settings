def rounded_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def fg_color(widget):
    c = widget.get_style_context().get_color(Gtk.StateFlags.NORMAL)
    return c.red, c.green, c.blue


def draw_device(widget, cr, has_lcd=True):
    """A stylised six-axis controller: wedge base, keypad, LCD, round cap."""
    w, h = widget.get_allocated_width(), widget.get_allocated_height()
    s = min(w / 360.0, h / 200.0)
    cr.translate((w - 360 * s) / 2, (h - 200 * s) / 2)
    cr.scale(s, s)
    # shadow
    cr.save()
    cr.translate(180, 182)
    cr.scale(1, 0.12)
    cr.arc(0, 0, 160, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgba(0, 0, 0, 0.18)
    cr.fill()
    # base body
    cr.move_to(30, 170)
    cr.curve_to(20, 120, 60, 70, 120, 64)
    cr.line_to(250, 58)
    cr.curve_to(310, 56, 345, 110, 335, 168)
    cr.curve_to(330, 180, 40, 182, 30, 170)
    cr.close_path()
    cr.set_source_rgb(0.20, 0.21, 0.23)
    cr.fill_preserve()
    cr.set_source_rgb(0.08, 0.08, 0.09)
    cr.set_line_width(2)
    cr.stroke()
    # top face highlight
    cr.move_to(52, 150)
    cr.curve_to(50, 110, 82, 82, 126, 78)
    cr.line_to(246, 72)
    cr.curve_to(296, 70, 320, 110, 316, 150)
    cr.close_path()
    cr.set_source_rgb(0.29, 0.30, 0.33)
    cr.fill()
    # LCD
    if has_lcd:
        rounded_rect(cr, 66, 90, 74, 52, 4)
        cr.set_source_rgb(0.05, 0.07, 0.09)
        cr.fill()
        rounded_rect(cr, 70, 94, 66, 44, 2)
        cr.set_source_rgb(0.12, 0.43, 0.70)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 0.75)
        for i in range(4):
            cr.rectangle(76, 101 + i * 9, 10 + (i * 7) % 30 + 14, 3)
        cr.fill()
    # key rows
    cr.set_source_rgb(0.14, 0.14, 0.16)
    for r in range(2):
        for c in range(5):
            rounded_rect(cr, 152 + c * 13, 96 + r * 26, 10, 18, 2)
    cr.fill()
    cr.set_source_rgb(0.14, 0.14, 0.16)
    for r in range(4):
        rounded_rect(cr, 292, 88 + r * 15, 16, 11, 2)
    cr.fill()
    # cap
    cx, cy = 236, 104
    cr.save()
    cr.translate(cx, cy + 22)
    cr.scale(1, 0.32)
    cr.arc(0, 0, 44, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgb(0.10, 0.10, 0.11)
    cr.fill()
    cr.rectangle(cx - 44, cy - 6, 88, 28)
    cr.set_source_rgb(0.17, 0.18, 0.19)
    cr.fill()
    cr.save()
    cr.translate(cx, cy - 6)
    cr.scale(1, 0.32)
    cr.arc(0, 0, 44, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgb(0.36, 0.37, 0.40)
    cr.fill()
    # accent ring
    cr.save()
    cr.translate(cx, cy + 22)
    cr.scale(1, 0.32)
    cr.arc(0, 0, 47, 0.1, math.pi - 0.1)
    cr.restore()
    cr.set_source_rgb(0.25, 0.55, 0.95)
    cr.set_line_width(2.5)
    cr.stroke()


def arrow_head(cr, x, y, ang, size=5):
    cr.move_to(x, y)
    cr.line_to(x - size * math.cos(ang - 0.5), y - size * math.sin(ang - 0.5))
    cr.line_to(x - size * math.cos(ang + 0.5), y - size * math.sin(ang + 0.5))
    cr.close_path()
    cr.fill()


def draw_axis_glyph(widget, cr, axis):
    """Puck plus arrow for one of the six axes (original drawing)."""
    w, h = widget.get_allocated_width(), widget.get_allocated_height()
    cr.translate(w / 2, h / 2)
    r, g, b = fg_color(widget)
    # puck
    cr.save()
    cr.scale(1, 0.4)
    cr.arc(0, 4 / 0.4, 10, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgba(r, g, b, 0.30)
    cr.fill()
    cr.set_source_rgb(0.20, 0.50, 0.90)
    cr.set_line_width(2)
    if axis == 0:  # pan left/right
        cr.move_to(-14, -4); cr.line_to(14, -4); cr.stroke()
        arrow_head(cr, 16, -4, 0); arrow_head(cr, -16, -4, math.pi)
    elif axis == 1:  # zoom in/out (toward / away from the user)
        cr.move_to(-9, 6); cr.line_to(9, -12); cr.stroke()
        arrow_head(cr, 11, -14, -math.pi / 4); arrow_head(cr, -11, 8, 3 * math.pi / 4)
    elif axis == 2:  # pan up/down
        cr.move_to(0, -15); cr.line_to(0, 6); cr.stroke()
        arrow_head(cr, 0, -17, -math.pi / 2); arrow_head(cr, 0, 8, math.pi / 2)
    elif axis == 3:  # tilt: rotate about the left/right axis
        cr.save(); cr.scale(0.45, 1); cr.arc(0, -4, 12, -2.4, 2.4); cr.restore(); cr.stroke()
        arrow_head(cr, -4, 5, 2.6)
    elif axis == 4:  # roll: rotate about the front/back axis
        cr.arc(0, -4, 12, math.pi + 0.5, 2 * math.pi - 0.5); cr.stroke()
        arrow_head(cr, 10.5, -9.8, 0.75)
    else:  # spin: rotate about the vertical axis
        cr.save(); cr.scale(1, 0.4); cr.arc(0, -16 / 0.4 * 0.4, 13, 0.3, math.pi * 1.7)
        cr.restore(); cr.stroke()
        arrow_head(cr, 12, -2, 0.2)


def draw_keycap(widget, cr, text):
    w, h = widget.get_allocated_width(), widget.get_allocated_height()
    rounded_rect(cr, 1.5, 1.5, w - 3, h - 3, 5)
    cr.set_source_rgb(0.22, 0.23, 0.25)
    cr.fill_preserve()
    cr.set_source_rgb(0.10, 0.10, 0.11)
    cr.set_line_width(1)
    cr.stroke()
    layout = widget.create_pango_layout(text)
    layout.set_alignment(Pango.Alignment.CENTER)
    size = 7 if "\n" in text or len(text) > 4 else 8 if len(text) > 2 else 10
    layout.set_font_description(Pango.FontDescription("Sans Bold %d" % size))
    tw, th = layout.get_pixel_size()
    cr.move_to((w - tw) / 2, (h - th) / 2)
    cr.set_source_rgb(0.93, 0.93, 0.95)

    PangoCairo.show_layout(cr, layout)


def draw_lcd_preview(widget, cr, labels, title, page):
    """Mirror of tdx_render_keys_page() (src/process.c): 320x240, 5 keys per page."""

    w, h = widget.get_allocated_width(), widget.get_allocated_height()
    s = min(w / 320.0, h / 240.0)
    cr.translate((w - 320 * s) / 2, (h - 240 * s) / 2)
    cr.scale(s, s)

    def rgb(v):
        cr.set_source_rgb(((v >> 16) & 255) / 255.0, ((v >> 8) & 255) / 255.0,
                          (v & 255) / 255.0)

    def text(x, y, t, px, col):
        lay = widget.create_pango_layout(t)
        lay.set_font_description(Pango.FontDescription("Monospace Bold %dpx" % px))
        rgb(col)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, lay)

    rgb(0x101418); cr.rectangle(0, 0, 320, 240); cr.fill()
    rgb(0x1F6FB2); cr.rectangle(0, 0, 320, 28); cr.fill()
    text(8, 4, title.upper(), 16, 0xFFFFFF)
    for r in range(5):
        k = page * 5 + r
        y = 38 + r * 40
        rgb(0x2A3038); cr.rectangle(6, y, 36, 32); cr.fill()
        n = str(k + 1)
        text(24 - 6 * len(n), y + 3, n, 22, 0xFFC040)
        text(52, y + 3, labels[k].upper()[:15], 22, 0xE6E6E6)


