            a = Gtk.Label(label=k, xalign=0)
            a.get_style_context().add_class("dim-label")
            b = Gtk.Label(label=v, xalign=0)
            grid.attach(a, 0, r, 1, 1)
            grid.attach(b, 1, r, 1, 1)
        grid.show_all()

