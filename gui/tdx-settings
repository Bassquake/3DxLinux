# application

class App:
    def __init__(self, args):
        self.args = args
        self.store = Store(args.config, args.profile_dir)
        sock = args.socket or self.store.base.get("control_socket", "/run/tdxd.sock")
        self.daemon = Daemon(sock, args.status_file)
        self.status = self.daemon.status()
        self.panels = []
        self.windows = {}
        self.save_state = ""
        self.save_timer = None
        self.main = self.win = None
        prof = args.profile
        if prof is None and self.status.get("profile") not in (None, "default"):
            prof = self.status["profile"]
        if prof:
            self.store.select(prof)
        self.store.listeners.append(self.on_changed)

    # ---- saving
    def on_changed(self):
        for p in self.panels:
            p.refresh()
        if all(writable(f.path) for f in self.store.files() if f.dirty):
            if self.save_timer:
                GLib.source_remove(self.save_timer)
            self.save_timer = GLib.timeout_add(600, self.flush)
            self.set_save_state("")
        else:
            self.set_save_state("Unsaved – saved when you close (administrator password)")

    def set_save_state(self, text):
        self.save_state = text
        if self.main:
            self.main.save_label.set_text(text)

    def flush(self, *_):
        self.save_timer = None
        if self.args.no_save:
            return False
        errors = [e for e in (write_file(f) for f in self.store.files() if f.dirty) if e]
        if errors:
            self.set_save_state("Not saved: " + errors[0])
            return False
        rc, out = self.daemon.request("reload")
        self.set_save_state("Saved" + ("" if rc == 0 else
                                       " – tdxd not reloaded (%s)" % out.strip()[:60]))
        GLib.timeout_add(800, self.poll_status)
        return False

    def poll_status(self):
        self.status = self.daemon.status()
        for p in self.panels:
            p.refresh()
        return False

    # ---- profiles
    def switch_profile(self, name):
        if self.store.dirty():
            self.flush()
        self.store.select(name)
        self.poll_status()

    def new_profile(self):
        dlg = Gtk.Dialog(title="New application profile", transient_for=self.win, modal=True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Create", Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_border_width(12)
        box.set_spacing(6)
        box.add(Gtk.Label(label="Application (process name, glob patterns allowed):", xalign=0))
        e = Gtk.Entry()
        app = self.status.get("app")
        e.set_text(app if app and app != "-" else "")
        e.set_activates_default(True)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box.add(e)
        dlg.show_all()
        ok = dlg.run() == Gtk.ResponseType.OK
        match = e.get_text().strip()
        dlg.destroy()
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", match.split(",")[0].replace("*", "")).strip("-.")
        if ok and name:
            if self.store.dirty():
                self.flush()
            self.store.create_profile(name, match)
            self.on_changed()
        else:
            self.main.refresh()

    # ---- windows
    def window(self, cls):
        if cls in self.windows:
            self.windows[cls].present()
            return
        panel = cls(self)
        w = Gtk.Window(title=panel.title, transient_for=self.win)
        w.set_resizable(False)
        w.add(panel.box)
        panel.close.connect("clicked", lambda *_: w.destroy())
        w.connect("destroy", lambda *_: self.closed(cls, panel))
        w.show_all()
        self.windows[cls] = w

    def closed(self, cls, panel):
        self.windows.pop(cls, None)
        self.panels.remove(panel)
        if self.store.dirty():
            self.flush()

    def show_advanced(self):
        self.window(AdvancedPanel)

    def show_buttons(self):
        self.window(ButtonsPanel)

    def show_lcd(self):
        self.window(LcdPanel)

    def show_about(self):
        self.window(AboutPanel)

    def quit(self):
        if self.store.dirty():
            self.flush()
        Gtk.main_quit()

    def run(self):
        self.main = MainPanel(self)
        self.win = Gtk.Window(title=MainPanel.title)
        self.win.set_resizable(False)
        self.win.set_default_size(440, -1)
        self.win.add(self.main.box)
        self.win.connect("delete-event", lambda *_: (self.quit(), True)[1])
        self.win.show_all()
        Gtk.main()

    # ---- --snapshot
    def snapshot(self, outdir):
        os.makedirs(outdir, exist_ok=True)
        self.main = MainPanel(self)
        self.win = None
        shots = [("main", self.main)] + [(n, c(self)) for n, c in (
            ("advanced", AdvancedPanel), ("buttons", ButtonsPanel),
            ("lcd", LcdPanel), ("about", AboutPanel))]
        for name, panel in shots:
            off = Gtk.OffscreenWindow()
            off.add(panel.box)
            off.show_all()
            for _ in range(50):
                while Gtk.events_pending():
                    Gtk.main_iteration()
            # paint the theme background ourselves (OffscreenWindow leaves the margins bare)
            import cairo
            w, h = off.get_allocated_width(), off.get_allocated_height()
            surf = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
            cr = cairo.Context(surf)
            Gtk.render_background(off.get_style_context(), cr, 0, 0, w, h)
            a = panel.box.get_allocation()
            cr.translate(a.x, a.y)
            panel.box.draw(cr)
            path = os.path.join(outdir, "tdx-settings-%s.png" % name)
            surf.write_to_png(path)
            print(path, "%dx%d" % (w, h))


def main():
    ap = argparse.ArgumentParser(description="Settings panel for the tdxd 3Dconnexion driver")
    ap.add_argument("-c", "--config", default="/etc/tdxd.conf", help="base configuration file")
    ap.add_argument("--profile-dir", help="per-application profiles (default: profile_dir)")
    ap.add_argument("-p", "--profile", help="edit this profile instead of the active one "
                                            "('' for the default settings)")
    ap.add_argument("-s", "--socket", help="tdxd control socket (default: control_socket)")
    ap.add_argument("--snapshot", metavar="DIR", help="render every window to DIR/*.png and exit")
    ap.add_argument("--status-file", help=argparse.SUPPRESS)  # canned `tdxctl status` (tests)
    ap.add_argument("--no-save", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("-V", "--version", action="version", version="tdx-settings " + APP_VERSION)
    args = ap.parse_args()
    app = App(args)
    if args.snapshot:
        app.snapshot(args.snapshot)
        return 0
    app.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
