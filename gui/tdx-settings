        for d in devs:
            l = Gtk.Label(xalign=0)
            l.set_markup("<b>%s</b>   FW: %s   [%s:%s]   %s" % (
                GLib.markup_escape_text(d["name"]), d["firmware"], d["vid"], d["pid"], d["node"]))
            self.devices.add(l)
        self.devices.show_all()
        self.fill(self.files, [
            ("Settings", self.store.base.path),
            ("Profiles", self.store.profile_dir),
            ("Control socket", self.app.daemon.socket),
        ])


