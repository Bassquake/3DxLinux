class Panel:
    """A 3DxWare-style window body: painted background + absolutely placed widgets.

    `self.box` is the root widget (also used by --snapshot)."""

    title = ""
    subtitle = None
    size = (470, 430)
    header_h = 67

    def __init__(self, app):
        self.app = app
        self.store = app.store
        self.updating = False
        self.lines = []
        w, h = self.size
        # EventBox root: clicks that no control takes bubble up here and move
        # the (undecorated) window, like dragging 3DxWare's panel anywhere.
        self.box = Gtk.EventBox()
        self.box.get_style_context().add_class("tdx")
        self.box.set_size_request(w, h)
        self.box.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.box.connect("button-press-event", self.on_drag)
        overlay = Gtk.Overlay()
        self.box.add(overlay)
        self.bg = Gtk.DrawingArea()
        self.bg.set_size_request(w, h)
        self.bg.connect("draw", lambda _w, cr: paint_background(cr, w, h, self.header_h,
                                                               self.lines))
        overlay.add(self.bg)
        self.fix = Gtk.Fixed()
        overlay.add_overlay(self.fix)
        overlay.set_overlay_pass_through(self.fix, False)
        # window buttons (the windows are undecorated, like 3DxWare's)
        self.min_btn = Gtk.Button(label="" if ASSETS.ui("SmartUI_BTN_Min") else "–")
        self.min_btn.get_style_context().add_class("tdx-min")
        self.close_btn = Gtk.Button(label="" if ASSETS.ui("SmartUI_BTN_Close") else "✕")
        self.close_btn.get_style_context().add_class("tdx-close")
        for b in (self.min_btn, self.close_btn):
            b.set_can_focus(False)
            b.set_size_request(29, 22)
        self.put(self.min_btn, w - 58, 5)
        self.put(self.close_btn, w - 29, 5)
        self.min_btn.connect("clicked", lambda *_: self.box.get_toplevel().iconify())
        self.header()
        self.build()
        self.refresh()
        app.panels.append(self)

    def put(self, widget, x, y):
        self.fix.put(widget, int(x), int(y))
        return widget

    def on_drag(self, _w, ev):
        if ev.button == 1 and ev.type == Gdk.EventType.BUTTON_PRESS:
            win = self.box.get_toplevel()
            if isinstance(win, Gtk.Window) and not isinstance(win, Gtk.OffscreenWindow):
                win.begin_move_drag(ev.button, int(ev.x_root), int(ev.y_root), ev.time)
        return False

    # ---- header: [subtitle] / app icon + profile title (click: choose profile)
    def header(self):
        ty = 41 if self.subtitle is None else 59
        if self.subtitle is not None:
            self.put(lab(self.subtitle, "tdx-sub"), 34, 37)
        self.icon_slot = Gtk.Box()
        self.put(self.icon_slot, 30, ty)  # level with the title's capitals
        self.title_btn = Gtk.Button()
        self.title_btn.get_style_context().add_class("tdx-title-btn")
        self.title_btn.set_can_focus(False)
        self.title_label = lab("", "tdx-title")
        self.title_btn.add(self.title_label)
        self.title_btn.set_tooltip_text("Settings for this profile – click to choose another")
        self.title_btn.connect("clicked", lambda b: self.app.profile_menu(b))
        self.put(self.title_btn, 52, ty - 3)

    def refresh_header(self):
        st = self.store
        if st.profile:
            name = os.path.basename(st.profile.path)[:-5]
            icon_app = (st.profile.get("match") or name).split(",")[0].strip().strip("*")
        else:
            name, icon_app = "All Applications", None
        self.title_label.set_text(name)
        for c in self.icon_slot.get_children():
            self.icon_slot.remove(c)
        self.icon_slot.add(app_icon(icon_app))
        self.icon_slot.show_all()

    def build(self):
        raise NotImplementedError

    def refresh(self):
        pass

    def guard(self, fn):
        """Wrap a signal handler so it does not fire while refresh() sets widgets."""
        def h(*a):
            if not self.updating:
                fn(*a)
        return h

    def section(self, text, x0, x1, y):
        """Section caption with the grey rule under it (rule at y)."""
        self.put(lab(text, "tdx-section"), x0 + 4, y - 22)
        self.lines.append((x0, x1, y))


