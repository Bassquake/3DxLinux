            l.set_text("%s: %s" % (k, v))
        src, at = look_source(), look_imported_at()
        when = time.strftime(" on %d %b %Y, %H:%M", time.localtime(at)) if at else ""
        self.look.set_text(
            "Imported from %s%s." % (src, when) if src else
            "Not imported: plain drawings are used. Import the artwork from your "
            "3DxWare installer (.exe).")
        for c in self.devbox.get_children():
            self.devbox.remove(c)
        devs = st.get("devices", [])
        if not devs:
            self.devbox.add(lab("None connected", "tdx-dim"))
        for d in devs:
            row = Gtk.Box(spacing=5)
            row.pack_start(lab("<span foreground='#555555'><b>%s</b> FW: %s</span>" % (
                GLib.markup_escape_text(d["name"]), d["firmware"]), markup=True),
                False, False, 0)
            sup = SUPPORT_TEXT.get(ASSETS.device(d.get("pid")).get("support"))
            if sup:
                ic = image_widget(ASSETS.ui("SmartUI_Alert_Icon_grey"))
                if ic:
                    row.pack_start(ic, False, False, 0)
                row.pack_start(lab(sup, "tdx-dim"), False, False, 0)
            self.devbox.add(row)
        self.devbox.show_all()


