def install_css(assets):
    prov = Gtk.CssProvider()
    prov.load_from_data(css_for(assets).encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)


def paint_background(cr, w, h, header_h, lines=()):
    """White header, blue rule, light body, footer with the logo strip."""
    cr.set_source_rgb(1, 1, 1)
    cr.paint()
    cr.set_source_rgb(*BODY)
    cr.rectangle(0, header_h, w, h - header_h - FOOTER_H)
    cr.fill()
    cr.set_source_rgb(*BLUE_LINE)
    cr.rectangle(0, header_h, w, 1)
    cr.fill()
    for (x0, x1, y) in lines:  # section rules
        cr.set_source_rgb(*SECTION_LINE)
        cr.rectangle(x0, y, x1 - x0, 1)
        cr.fill()
    foot = ASSETS.surface(ASSETS.ui("ButtonConfigBottom"))
    if foot:
        cr.save()
        cr.rectangle(0, h - FOOTER_H, w, FOOTER_H)
        cr.clip()
        cr.set_source_surface(foot, 0, h - FOOTER_H)
        cr.paint()
        cr.restore()
    else:
        cr.set_source_rgb(*FOOT_LINE)
        cr.rectangle(0, h - FOOTER_H, w, 1)
        cr.fill()
        cr.set_source_rgb(0.45, 0.45, 0.45)
        cr.select_font_face("sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(17)
        cr.move_to(30, h - FOOTER_H + 37)
        cr.show_text("tdxd")
    cr.set_source_rgb(0.62, 0.62, 0.62)  # 1px window frame
    cr.set_line_width(1)
    cr.rectangle(0.5, 0.5, w - 1, h - 1)
    cr.stroke()


def image_widget(path, size=None):
    """Gtk.Image of a PNG, optionally scaled to fit size x size."""
    from gi.repository import GdkPixbuf
    if not path:
        return None
    try:
        if size:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        else:
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
    except GLib.Error:
        return None
    return Gtk.Image.new_from_pixbuf(pb)


def lab(text, cls=None, xalign=0.0, markup=False):
    l = Gtk.Label(xalign=xalign)
    if markup:
        l.set_markup(text)
    else:
        l.set_text(text)
    if cls:
        for c in cls.split():
            l.get_style_context().add_class(c)
    return l


def flat_button(text, w, h=27):
    b = Gtk.Button(label=text)
    b.get_style_context().add_class("tdx-btn")
    b.set_size_request(w, h)
    b.set_can_focus(False)
    return b


def log_scale(width, lo=-1.0, hi=1.0):
    """Slider over log10(value); 0 = 1.0x."""
    sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 0.01)
    sc.set_draw_value(False)
    sc.set_size_request(width, 20)
    sc.add_mark(0, Gtk.PositionType.BOTTOM, None)
    sc.set_can_focus(False)
    return sc


def drawing(width, height, func, *args):
    da = Gtk.DrawingArea()
    da.set_size_request(width, height)
    da.connect("draw", lambda w, cr: func(w, cr, *args) or False)
    return da


def app_icon(app, size=16):
    """Icon of the focused application from the icon theme, else the 3Dx glyph."""
    theme = Gtk.IconTheme.get_default()
    for n in ([app.lower(), app] if app else []):
        try:
            if theme.has_icon(n):
                return Gtk.Image.new_from_pixbuf(theme.load_icon(n, size, 0))
        except GLib.Error:
            pass
    img = image_widget(ASSETS.ui("Install_3dxicon"), size)
    return img or Gtk.Image.new_from_icon_name("input-mouse", Gtk.IconSize.MENU)


class DevicePhoto(Gtk.Box):
    """The device photo, redrawn when another device (or none) is connected.
    @which: the device to show (default: the first 3D mouse)."""

    def __init__(self, app, which=None):
        super().__init__()
        self.app, self.key = app, ()
        self.which = which or (lambda: (self.app.status.get("devices") or [None])[0])
        self.update()

    def update(self):
        dev = self.which()
        key = (dev.get("vid"), dev.get("pid")) if dev else None
        if key == self.key:
            return
        self.key = key
        for c in self.get_children():
            self.remove(c)
        w = device_image(dev)
        self.add(w)
        w.show_all()


def device_image(dev, w=200, h=120):
    """The device photo from the installer (Base.xml <Image>), else a drawing."""
    info = ASSETS.device(dev.get("pid")) if dev else {}
    path = ASSETS.icon(info.get("image")) if info else None
    if not path and not dev:
        path = ASSETS.icon("SPP_Head.png")
    img = image_widget(path)
    return img or drawing(w, h, lambda wd, cr: draw_device(wd, cr, True))


def device_entries(st):
    """Every device the device chooser lists, in 3DxWare's order: the 3D mice,
    then for each wireless receiver its paired devices and the receiver itself.
    Each gets a "kind" (3d, paired, receiver) and a "key" that stays the same
    while it is connected."""
    out = [dict(d, kind="3d", key=("3d", d["vid"], d["pid"], d["node"]))
           for d in st.get("devices", [])]
    for i, r in enumerate(st.get("receivers", [])):
        for p in r["paired"]:
            if p.get("active", True):  # paired but not heard from: off, or not used yet
                out.append(dict(p, kind="paired", key=("paired", p["pid"], p["id"])))
        out.append(dict(r, kind="receiver", key=("receiver", r["vid"], r["pid"], i)))
    return out


def device_name(dev):
    return dev["name"].replace(" PRO", " Pro") if dev else "No device connected"


def battery_icon(level, charging):
    """3DxWare's battery picture for @level percent (None: not reported yet)."""
    if charging:
        return "SmartUI_Battery_Charging_1"
    if level is None:
        return "SmartUI_Battery_Unknown"
    for least, name in ((88, "100"), (63, "75"), (38, "50"), (15, "25"), (6, "Low")):
        if level >= least:
            return "SmartUI_Battery_" + name
    return "SmartUI_Battery_Critical"


def battery_text(dev):
    if dev.get("charging"):
        return "Battery charging" + (" (%d%%)" % dev["battery"] if dev.get("battery") else "")
    if dev.get("battery") is None:
        return "Battery level not reported yet (move the mouse)"
    return "Battery %d%%" % dev["battery"]


