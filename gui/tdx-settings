def log_scale(lo=-1.0, hi=1.0):
    """Slider over log10(value); 0 = 1.0x."""
    sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 0.01)
    sc.set_draw_value(False)
    sc.add_mark(0, Gtk.PositionType.BOTTOM, None)
    sc.set_hexpand(True)
    return sc


def frame(title, child):
    fr = Gtk.Frame(label=title)
    fr.get_label_widget().set_markup("<b>%s</b>" % GLib.markup_escape_text(title))
    child.set_margin_start(10)
    child.set_margin_end(10)
    child.set_margin_top(6)
    child.set_margin_bottom(8)
    fr.add(child)
    return fr


def drawing(width, height, func, *args):
    da = Gtk.DrawingArea()
    da.set_size_request(width, height)
    da.connect("draw", lambda w, cr: func(w, cr, *args) or False)
    return da


class Panel:
    """Base for the windows: builds its content into a Box (so it can be snapshotted)."""

    title = ""

    def __init__(self, app):
        self.app = app
        self.store = app.store
        self.updating = False
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for side in ("start", "end", "top", "bottom"):
            getattr(self.box, "set_margin_" + side)(14)
        self.build()
        self.refresh()
        app.panels.append(self)

    def build(self):
        raise NotImplementedError

    def refresh(self):
        pass

    def guard(self, fn):
        """Wrap a signal handler so it does not fire while refresh() sets widgets."""
        def h(*a):
            if not self.updating:
                fn(*a)
        return h


