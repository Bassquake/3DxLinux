def look_source():
    """The installer the artwork in use came from (its SOURCE file), or None."""
    if not ASSETS.dir:
        return None
    try:
        with open(os.path.join(ASSETS.dir, "SOURCE")) as f:
            m = re.match(r"Extracted from (\S+)", f.readline())
        return m.group(1) if m else os.path.basename(ASSETS.dir)
    except OSError:
        return os.path.basename(ASSETS.dir)


def look_imported_at():
    """When the artwork in use was imported (its SOURCE file's time), or None."""
    try:
        return os.path.getmtime(os.path.join(ASSETS.dir, "SOURCE")) if ASSETS.dir else None
    except OSError:
        return None


def import_summary(lines):
    """The importer's output -> 'N images from <installer> into <dir>'."""
    n = sum(int(m.group(1)) for m in (re.match(r"(\d+) .*(images|icons)", l) for l in lines) if m)
    dest = next((l[6:] for l in reversed(lines) if l.startswith("wrote ")), "")
    prof = next((m for m in (re.match(r"(\d+) application profiles", l) for l in lines) if m), None)
    what = "%d images" % n + (" and %s application key settings" % prof.group(1) if prof else "")
    return what + (" into " + dest if dest else "")


def find_extractor():
    """The command that runs tools/extract_3dxware_ui.py: installed, or from the source tree."""
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(here, "tdx-extract-3dxware-ui"),
              os.path.join(here, "..", "tools", "extract_3dxware_ui.py"),
              shutil.which("tdx-extract-3dxware-ui")):
        if p and os.path.isfile(p):
            return [sys.executable, os.path.realpath(p)]
    return None


def message(parent, kind, text, secondary=None):
    d = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=kind,
                          buttons=Gtk.ButtonsType.OK, text=text)
    if secondary:
        d.format_secondary_text(secondary)
    d.run()
    d.destroy()


def import_look(parent, app):
    """Pick the 3DxWare installer and extract its artwork for this user
    (~/.local/share/tdxd/3dxware-ui, no password), then restart the LCD
    Manager and this panel so both show it."""
    cmd = find_extractor()
    if not cmd:
        message(parent, Gtk.MessageType.ERROR, "The importer is missing",
                "tdx-extract-3dxware-ui was not found. Reinstall tdxd.")
        return
    if not (shutil.which("7z") or shutil.which("7za") or shutil.which("7zz")):
        message(parent, Gtk.MessageType.WARNING, "Importing needs 7-Zip",
                "Install the p7zip-full package (Fedora: p7zip) with your software "
                "app, then try again.")
        return
    fc = Gtk.FileChooserDialog(title="Choose the 3DxWare installer", transient_for=parent,
                               action=Gtk.FileChooserAction.OPEN, modal=True)
    fc.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Import", Gtk.ResponseType.OK)
    filt = Gtk.FileFilter()
    filt.set_name("3DxWare installer (*.exe)")
    filt.add_pattern("*.exe")
    filt.add_pattern("*.EXE")
    fc.add_filter(filt)
    dl = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
    if dl and os.path.isdir(dl):
        fc.set_current_folder(dl)
    ok = fc.run() == Gtk.ResponseType.OK
    path = fc.get_filename()
    fc.destroy()
    if not ok or not path:
        return

    # progress: the importer takes a while (installer -> MSI -> CAB -> images)
    dlg = Gtk.Dialog(title="Importing the 3DxWare look", transient_for=parent, modal=True)
    dlg.set_deletable(False)
    box = dlg.get_content_area()
    box.set_border_width(16)
    box.set_spacing(10)
    row = Gtk.Box(spacing=10)
    spin = Gtk.Spinner()
    spin.start()
    row.pack_start(spin, False, False, 0)
    row.pack_start(Gtk.Label(label="Reading %s…" % os.path.basename(path), xalign=0), False, False, 0)
    box.add(row)
    step = Gtk.Label(label="", xalign=0)
    step.get_style_context().add_class("dim-label")
    box.add(step)
    dlg.set_default_size(420, -1)
    dlg.show_all()
    lines = []

    def run():
        try:
            p = subprocess.Popen(cmd + [path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 text=True, errors="replace")
            for line in p.stdout:
                lines.append(line.rstrip())
                GLib.idle_add(step.set_text, line.strip()[:80])
            rc = p.wait()
        except OSError as e:
            lines.append(str(e))
            rc = -1
        GLib.idle_add(done, rc)

    def done(rc):
        dlg.destroy()
        if rc != 0:
            message(parent, Gtk.MessageType.ERROR, "The import failed",
                    "\n".join(lines[-4:]) or "The importer stopped with code %d." % rc)
            return False
        # the LCD Manager and its applets load the artwork when they start
        subprocess.call(["systemctl", "--user", "try-restart", "tdx-lcdmgr.service"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # FreeCAD's key sets came with the import: make sure FreeCAD loads them
        here = os.path.dirname(os.path.realpath(__file__))
        fc = next((p for p in (os.path.join(here, "tdx-freecad-addon"),
                               os.path.join(here, "..", "packaging", "tdx-freecad-addon"),
                               shutil.which("tdx-freecad-addon")) if p and os.path.isfile(p)), None)
        if fc:
            subprocess.call(["sh", fc, "install"], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
        # tdxd reads the imported application profiles (yours, as the one asking)
        ctl = find_program("tdxctl")
        if ctl:
            subprocess.call([ctl, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        message(parent, Gtk.MessageType.INFO, "The 3DxWare look is imported",
                "%s, from %s.\n\nThe settings panel restarts now to show it, and the "
                "LCD Manager restarts too." % (import_summary(lines), os.path.basename(path)))
        app.restart(show_about=True)
        return False

    import threading
    threading.Thread(target=run, daemon=True).start()


