def asset_dirs():
    env = os.environ.get("TDX_UI_ASSETS")
    here = os.path.dirname(os.path.realpath(__file__))
    return ([env] if env else []) + [
        os.path.expanduser("~/.local/share/tdxd/3dxware-ui"),
        os.path.join(here, "..", "share", "tdxd", "3dxware-ui"),
        "/usr/local/share/tdxd/3dxware-ui", "/usr/share/tdxd/3dxware-ui"]


class Assets:
    def __init__(self, path=None):
        self.dir = None
        for d in ([path] if path else asset_dirs()):
            if d and os.path.isdir(os.path.join(d, "ui")):
                self.dir = os.path.realpath(d)
                break
        self.devices = {}
        if self.dir:
            try:
                import json
                with open(os.path.join(self.dir, "devices.json")) as f:
                    self.devices = json.load(f)
            except (OSError, ValueError):
                pass
        self._surf = {}

    def ui(self, name):
        if not self.dir:
            return None
        p = os.path.join(self.dir, "ui", name + ".png")
        return p if os.path.isfile(p) else None

    def icon(self, name):
        if not self.dir or not name:
            return None
        p = os.path.join(self.dir, "icons", name)
        return p if os.path.isfile(p) else None

    def surface(self, path):
        if path and path not in self._surf:
            try:
                self._surf[path] = cairo.ImageSurface.create_from_png(path)
            except (cairo.Error, OSError):
                self._surf[path] = None
        return self._surf.get(path)

    def device(self, pid):
        return self.devices.get((pid or "").lower(), {})


def window_icon_files(folder, prefix):
    """<folder>/<prefix>_<size>.png, smallest first (extract_3dxware_ui.py
    takes them from the Windows program's icon)."""
    try:
        names = os.listdir(folder) if folder else []
    except OSError:
        return []
    found = []
    for n in names:
        m = re.match(re.escape(prefix) + r"_(\d+)\.png$", n)
        if m:
            found.append((int(m.group(1)), os.path.join(folder, n)))
    return [p for _s, p in sorted(found)]


def set_window_icons(files, theme_name):
    """Taskbar / title-bar icon for every window of this program, like the
    Windows version's; the generic input-mouse icon without the artwork."""
