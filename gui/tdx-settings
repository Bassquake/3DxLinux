        self.restore.connect("clicked", self.on_restore)
        self.close = self.put(flat_button("Close", 94), 686, 688)

    def assignment(self, v3dk):
        """(kind, value): ('action', name) | ('keys', [names]) | ('app', None)"""
        a = self.store.get("action_" + v3dk)
        if a and a.lower() != "none":
            return "action", a.lower()
        k = chord_names(self.store.get("key_" + v3dk))
        if k:
            return "keys", k
        return "app", None

    def preset_of(self, keys):
        for name, preset in KEY_PRESETS:
            if preset and chord_names(preset) == keys:
                return name
        return None

    def app_keys(self):
        """The application's own names for its keys, when that application is
        the profile shown here: {V3DK: name}."""
        app, keys = self.app.daemon.app_keys()
        prof = self.store.profile
        if not app or not prof:
            return app, {}
        name = os.path.basename(prof.path)[:-5]
        pats = re.split(r"[,\s]+", prof.get("match") or name)
        if any(p and fnmatch.fnmatch(app.lower(), p.lower()) for p in pats):
            return app, keys
        return app, {}

    def describe(self, v3dk, fn):
        if v3dk in self.own:  # the application runs its own command for this key
            return self.own[v3dk]
        kind, val = self.assignment(v3dk)
        if kind == "action":
            return ACTION_LABEL.get(val, val)
        if kind == "keys":
            # a profile that sends an application's shortcut can name it for the
            # LCD (lcd_label_V3DK_TOP = Top View): "Top View (2)"
            name = self.store.get("lcd_label_" + v3dk)
            keys = self.preset_of(val) or pretty_chord(val)
            return "%s (%s)" % (name, keys) if name else keys
        return fn

    def icon_for(self, v3dk):
        kind, val = self.assignment(v3dk)
        if kind == "action":
            return ASSETS.icon(ACTION_ICON.get(val))
        if kind == "keys":
            p = self.preset_of(val)
            return ASSETS.icon(PRESET_ICON.get(p)) if p else ASSETS.icon("Keyboard.png")
        return ASSETS.icon(v3dk + ".png")  # view buttons: V3DK_TOP.png, ...

    def refresh(self):
        self.refresh_header()
        self.own_app, self.own = self.app_keys()
        for v3dk, (l, fn, slot) in self.rows.items():
            kind, _ = self.assignment(v3dk)
            l.set_text(self.describe(v3dk, fn))
            if v3dk in self.own:
                tip = ("%s's own command for this key (its tdxd add-on; it changes with "
                       "the workbench)" % self.own_app)
            else:
                tip = "Sent to the application" if kind == "app" else None
            l.get_parent().get_parent().set_tooltip_text(tip)
            for c in slot.get_children():
                slot.remove(c)
            img = image_widget(self.icon_for(v3dk), 16)
            if img:
                slot.add(img)
                img.show()

    def popup(self, widget, item):
        v3dk, _cap, fn = item
        menu = Gtk.Menu()

        def add(m, label, cb):
            mi = Gtk.MenuItem(label=label)
            mi.connect("activate", lambda *_: cb())
            m.append(mi)
            return mi

        add(menu, "%s (send to application)" % fn, lambda: self.assign(v3dk, "app", None))
        menu.append(Gtk.SeparatorMenuItem())
        drv = Gtk.Menu()
        for name, label in ACTIONS:
            add(drv, label, lambda n=name: self.assign(v3dk, "action", n))
        mi = Gtk.MenuItem(label="Driver")
        mi.set_submenu(drv)
        menu.append(mi)
        kb = Gtk.Menu()
        for label, chord in KEY_PRESETS:
            if label is None:
                kb.append(Gtk.SeparatorMenuItem())
                continue
            add(kb, "%s  (%s)" % (label, pretty_chord(chord_names(chord))),
                lambda c=chord: self.assign(v3dk, "keys", chord_names(c)))
        mi = Gtk.MenuItem(label="Keyboard")
        mi.set_submenu(kb)
        menu.append(mi)
        add(menu, "Custom keystroke…", lambda: self.capture(v3dk, fn))
        menu.show_all()
        menu.popup_at_widget(widget, Gdk.Gravity.NORTH_EAST, Gdk.Gravity.NORTH_WEST, None)

    def capture(self, v3dk, fn):
        dlg = KeyCaptureDialog(self.box.get_toplevel(), fn)
        if dlg.run() == Gtk.ResponseType.OK and dlg.keys:
            self.assign(v3dk, "keys", dlg.keys)
        dlg.destroy()

    def assign(self, v3dk, kind, val):
        st = self.store
        t = st.target
        akey, kkey = "action_" + v3dk, "key_" + v3dk
        in_profile = st.profile is not None
        # the daemon checks action_ first, then key_
        if kind == "action":
            t.set(akey, val)
            t.remove(kkey)
        elif kind == "keys":
            t.set(kkey, chord_value(val))
            if in_profile and (st.base.get(akey) or "none").lower() != "none":
                t.set(akey, "none")
            else:
                t.remove(akey)
        else:
            for key in (akey, kkey):
                if in_profile and (st.base.get(key) or "none").lower() != "none":
                    t.set(key, "none")
                else:
                    t.remove(key)
        st.changed()

    def on_restore(self, _b):
        t = self.store.target
        prefixes = ("key_", "action_", "lcd_label_")  # and the names that went with them
        for k in [k for p in prefixes for k in t.keys_with_prefix(p)]:
            t.remove(k)
        if self.store.profile:
            # back to the keys the profile came with (FreeCAD's view keys, an
            # imported 3DxWare profile), as 3DxWare restores an application's own
            # defaults; a profile you made yourself has none: the base's keys
            name = os.path.basename(self.store.profile.path)[:-5]
            src = self.store.shipped_path(name)
            if src:
                for k, v in ConfFile(src).items():
                    if k.lower().startswith(prefixes):
                        t.set(k, v)
        else:
            for k, v in DEFAULT_KEYS.items():
                t.set("key_" + k, v)
            for k, v in DEFAULT_ACTIONS.items():
                t.set("action_" + k, v)
            for i, v in enumerate(DEFAULT_LABELS):  # the LCD names that go with them
                t.set("lcd_label_%d" % (i + 1), v)
        self.store.changed()


