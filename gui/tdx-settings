        self.removing = None  # slot asked to be removed, until it is gone
        self.shown = None

    def paired(self):
        r = (self.app.status.get("receivers") or [{}])[0]
        return r.get("paired", [])

    def refresh(self):
        self.refresh_header()
        self.photo.update()
        devs = self.paired()
        if self.removing is not None and not any(d["slot"] == self.removing for d in devs):
            self.msg.set_text("Removed.")
            self.removing = None
        self.count.set_text("Currently paired devices (%d/5)" % len(devs))
        key = tuple((d["slot"], d["pid"], d["id"]) for d in devs) + (self.removing,)
        if key == self.shown:
            return
        self.shown = key
        for c in self.grid.get_children():
            self.grid.remove(c)
        for i, d in enumerate(devs):
            t = PairedTile(d, self.on_remove, d["slot"] == self.removing)
            self.grid.attach(t, i % 2, i // 2, 1, 1)
        self.grid.show_all()

    def on_remove(self, dev):
        if self.removing is not None:
            return
        name = device_name(dev)
        text = "The receiver forgets this device; Add device pairs it again."
        if "CadMouse" in name:
            text += " If it is the mouse you are using, it stops working until then."
        if not confirm(self.box.get_toplevel(), "Remove %s?" % name, text, "Remove"):
            return
        rc, out = self.app.daemon.request("unpair", str(dev["slot"]))
        if rc:
            self.msg.set_text(out.strip().replace("error: ", "").capitalize())
            return
        self.removing = dev["slot"]
        self.msg.set_text("Removing %s…" % name)
        self.shown = None
        self.refresh()


class KeyCaptureDialog(Gtk.Dialog):
    """Press a key combination; records evdev key names (hardware keycode - 8)."""

    def __init__(self, parent, button_name):
        super().__init__(title="Keystroke for " + button_name, transient_for=parent, modal=True)
        self.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        self.set_response_sensitive(Gtk.ResponseType.OK, False)
        self.keys = []
        box = self.get_content_area()
        box.set_border_width(14)
        box.set_spacing(8)
        box.add(Gtk.Label(label="Press the key combination to send:"))
        self.shown = Gtk.Label()
        self.shown.set_markup("<span size='x-large'>…</span>")
        box.add(self.shown)
        self.connect("key-press-event", self.on_key)
        self.show_all()

    def on_key(self, _w, ev):
        code = ev.hardware_keycode - 8  # X11/Wayland keycodes are evdev + 8
        name = CODE_NAMES.get(code, str(code))
        mods = []
        st = ev.state
        if st & Gdk.ModifierType.CONTROL_MASK:
            mods.append("LEFTCTRL")
        if st & Gdk.ModifierType.SHIFT_MASK:
            mods.append("LEFTSHIFT")
        if st & Gdk.ModifierType.MOD1_MASK:
            mods.append("LEFTALT")
        if st & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
            mods.append("LEFTMETA")
        keys = mods + ([name] if name not in mods else [])
        self.keys = keys[:4]
        self.shown.set_markup("<span size='x-large'>%s</span>"
                              % GLib.markup_escape_text(pretty_chord(self.keys)))
        self.set_response_sensitive(Gtk.ResponseType.OK, True)
        return True


def chord_names(value):
    """'KEY_LEFTCTRL + KEY_C' -> ['LEFTCTRL', 'C']; 'none' -> [].
    A sequence ('KEY_V, KEY_F', keys tapped one after another) keeps its
    steps apart with ',' entries: ['V', ',', 'F']."""
    if not value or value.strip().lower() == "none":
        return []
    out = []
    for i, step in enumerate(value.split(",")):
        if i and out:
            out.append(",")
        for t in step.split("+"):
            t = t.strip().upper()
            if t.startswith("KEY_"):
                t = t[4:]
            if t:
                out.append(t)
    return out


def pretty_chord(names):
    pretty = (PRETTY_KEY.get(n, n.title() if len(n) > 1 else n) for n in names)
    return "+".join(pretty).replace("+,+", ", ")


# a modifier key pressed on its own -> the name the chord keeps (left one)
MODIFIER_KEYS = dict(LEFTCTRL="LEFTCTRL", RIGHTCTRL="LEFTCTRL", LEFTSHIFT="LEFTSHIFT",
                     RIGHTSHIFT="LEFTSHIFT", LEFTALT="LEFTALT", RIGHTALT="LEFTALT",
                     LEFTMETA="LEFTMETA", RIGHTMETA="LEFTMETA")


def shortcut_label(names):
    """3DxWare's way: 'SHIFT+C', 'CTRL+ALT+DELETE'."""
    return pretty_chord(names).upper()


def chord_value(names):
    keys = ("," if n == "," else "KEY_" + n if not n.isdigit() or n in KEY_CODES else n
            for n in names)
    return "+".join(keys).replace("+,+", ", ")


