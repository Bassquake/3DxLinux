                               for d in devs)

    def show_page(self, mode, chooser=False):
        """3DxWare's main window for a 3D mouse ("3d"), a wireless mouse
        ("paired") or a receiver, or its "No device found" page ("nodev")."""
        on, mouse = mode != "nodev", mode in ("3d", "paired")
        vis = [(self.dev_label, on and not chooser), (self.name_btn, on and chooser),
               (self.photo, on), (self.icon_slot, on), (self.title_btn, on),
               (self.state_wrap, mode == "3d"), (self.conn_box, mode == "paired"),
               (self.speed_label, mouse), (self.speed, mode == "3d"),
               (self.mouse_speed, mode == "paired"),
               (self.main_buttons[0], mouse), (self.main_buttons[1], mouse),
               (self.lcd_button, mode == "3d")]
        vis += [(w, mode == "receiver") for w in
                [self.recv_title, self.recv_rule, self.recv_text] + self.recv_buttons]
        vis += [(w, mode == "nodev") for w in
                (self.plain_title, self.nodev_icon_box, self.nodev_text_box)]
        for w, v in vis:
            w.set_visible(v)
            if v and w is not self.state_wrap:
                w.show_all()

    def refresh_conn(self, dev):
        """USB, keyboard, receiver and Bluetooth icons (the receiver lit) and
        the battery, as 3DxWare shows them for a wireless mouse."""
        for c in self.conn_box.get_children():
            self.conn_box.remove(c)
        for name, active in (("usb", False), ("keyboard", False), ("dongle", True),
                             ("bluetooth", False)):
            img = image_widget(ASSETS.ui("SmartUI_%s_%s" % (name, "active" if active
                                                             else "inactive")))
            if img:
                img.set_tooltip_text("Connected through the Universal Receiver"
                                     if active else None)
                self.conn_box.pack_start(img, False, False, 0)
        self.conn_box.pack_start(drawing(1, 15, lambda _w, cr: (
            cr.set_source_rgb(*SECTION_LINE), cr.paint()) and None), False, False, 0)
        bat = image_widget(ASSETS.ui(battery_icon(dev.get("battery"), dev.get("charging"))))
        if not bat:
            bat = lab("%s%%" % dev["battery"] if dev.get("battery") is not None else "–",
                      "tdx-status")
        bat.set_tooltip_text(battery_text(dev))
        self.conn_box.pack_start(bat, False, False, 0)
        self.conn_box.show_all()

    def device_popover(self, button):
        """3DxWare's device chooser: a photo tile per device, the shown one grey."""
        pop = Gtk.Popover.new(button)
        pop.set_position(Gtk.PositionType.RIGHT)
        for c in ("tdx", "tdx-devices"):
            pop.get_style_context().add_class(c)
        row = Gtk.Box()
        cur = self.app.current_device()
        for e in device_entries(self.app.status):
            b = Gtk.Button()
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.set_can_focus(False)
            b.get_style_context().add_class("tdx-tile")
            if cur and e["key"] == cur["key"]:
                b.get_style_context().add_class("tdx-tile-current")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            v.pack_start(device_image(e), False, False, 0)
            v.pack_start(lab(device_name(e), xalign=0.5), False, False, 0)
            b.add(v)
            b.connect("clicked", lambda _b, k=e["key"]: (pop.popdown(),
                                                         self.app.select_device(k)))
            row.pack_start(b, False, False, 0)
        pop.add(row)
        row.show_all()
        pop.popup()
        self.popover = pop
        return pop

    def refresh(self):
        self.updating = True
        self.refresh_header()
        st = self.app.status
        cur = self.app.current_device()
        self.mode = cur["kind"] if cur else "nodev"
        self.nodev = cur is None
        self.show_page(self.mode, len(device_entries(st)) > 1)
        self.nodev_text.set_text(
            "No device found.\nPlease connect your 3Dconnexion device." if st.get("running") else
            "The 3Dconnexion driver (tdxd) is not running.\nStart it with: sudo systemctl start tdxd")
        self.photo.update()
        self.dev_label.set_text(device_name(cur))
        self.name_btn_label.set_text(device_name(cur))
        if not st.get("running"):
            state = "tdxd is not running"
        elif cur:
            info = ASSETS.device(cur.get("pid"))
            state = SUPPORT_TEXT.get(info.get("support"), "")
            if not info:
                state = "Firmware %s" % cur.get("firmware", "?")
        else:
            state = "Connect a device"
        if self.mode == "paired":
            self.refresh_conn(cur)
        dpi = mouse_dpi(self.store)
        self.mouse_speed.set_value(min(range(len(MOUSE_DPI_STEPS)),
                                       key=lambda i: abs(MOUSE_DPI_STEPS[i] - dpi)))
        self.mouse_speed.set_tooltip_text("Speed: %d dpi" % dpi)
        self.state_label.set_text(state)
        if self.state_icon:
            self.state_icon.set_visible(bool(state))
        if self.mode != "paired":
            self.speed.set_value(math.log10(max(0.05, self.store.get_float("sensitivity",
                                                                           1.0))))
            self.speed.set_tooltip_text("Speed %sx" % fmt_num(self.store.get_float(
                "sensitivity", 1.0)))
        else:
            self.speed.set_value(0)
        self.lcd_button.set_sensitive(self.has_lcd())
        self.save_label.set_text(self.app.save_state)
        self.updating = False

    def on_mouse_speed(self, sc):
        dpi = MOUSE_DPI_STEPS[int(round(sc.get_value()))]
        if dpi != mouse_dpi(self.store):
            self.store.set("mouse_dpi", str(dpi))

    def on_speed(self, sc):
        v = 10 ** sc.get_value()
        if abs(sc.get_value()) < 0.02:
            v = 1.0
        self.store.set("sensitivity", fmt_num(v))


