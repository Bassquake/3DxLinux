        top.pack_start(left, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.enable = Gtk.CheckButton(label="Use the LCD")
        self.enable.set_tooltip_text("Daemon-wide (stored in the default settings)")
        self.enable.connect("toggled", self.guard(
