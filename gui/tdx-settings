def arrow_head(cr, x, y, ang, size=5):
    cr.move_to(x, y)
    cr.line_to(x - size * math.cos(ang - 0.5), y - size * math.sin(ang - 0.5))
    cr.line_to(x - size * math.cos(ang + 0.5), y - size * math.sin(ang + 0.5))
    cr.close_path()
    cr.fill()


def draw_axis_glyph(widget, cr, axis):
    """Puck plus arrow for one of the six axes (original drawing)."""
    w, h = widget.get_allocated_width(), widget.get_allocated_height()
    cr.translate(w / 2, h / 2)
    r, g, b = fg_color(widget)
    # puck
    cr.save()
    cr.scale(1, 0.4)
    cr.arc(0, 4 / 0.4, 10, 0, 2 * math.pi)
    cr.restore()
    cr.set_source_rgba(r, g, b, 0.30)
    cr.fill()
    cr.set_source_rgb(0.20, 0.50, 0.90)
    cr.set_line_width(2)
    if axis == 0:  # pan left/right
        cr.move_to(-14, -4); cr.line_to(14, -4); cr.stroke()
        arrow_head(cr, 16, -4, 0); arrow_head(cr, -16, -4, math.pi)
    elif axis == 1:  # zoom in/out (toward / away from the user)
        cr.move_to(-9, 6); cr.line_to(9, -12); cr.stroke()
        arrow_head(cr, 11, -14, -math.pi / 4); arrow_head(cr, -11, 8, 3 * math.pi / 4)
    elif axis == 2:  # pan up/down
        cr.move_to(0, -15); cr.line_to(0, 6); cr.stroke()
        arrow_head(cr, 0, -17, -math.pi / 2); arrow_head(cr, 0, 8, math.pi / 2)
    elif axis == 3:  # tilt: rotate about the left/right axis
        cr.save(); cr.scale(0.45, 1); cr.arc(0, -4, 12, -2.4, 2.4); cr.restore(); cr.stroke()
        arrow_head(cr, -4, 5, 2.6)
    elif axis == 4:  # roll: rotate about the front/back axis
        cr.arc(0, -4, 12, math.pi + 0.5, 2 * math.pi - 0.5); cr.stroke()
        arrow_head(cr, 10.5, -9.8, 0.75)
    else:  # spin: rotate about the vertical axis
        cr.save(); cr.scale(1, 0.4); cr.arc(0, -16 / 0.4 * 0.4, 13, 0.3, math.pi * 1.7)
        cr.restore(); cr.stroke()
        arrow_head(cr, 12, -2, 0.2)


def draw_lcd_preview(widget, cr, labels, title, page):
