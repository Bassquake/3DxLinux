    # ---- where the CadMouse buttons are kept
    def specific(self):
        """True when the shown profile has its own CadMouse buttons."""
        p = self.store.profile
        return bool(p) and any(p.has(k) for k in MOUSE_PROFILE_KEYS)

    def conf(self):
        return self.store.profile if self.specific() else self.store.base

    def value(self, key):
        return self.conf().get(key)

    def set_value(self, key, value):
        f = self.conf()
        if value is None:
            f.remove(key)
        else:
            f.set(key, value)
        self.store.changed()

    def on_app_specific(self, sw):
        p = self.store.profile
        if not p:
            return
        if sw.get_active():  # start from the global buttons
            for k in MOUSE_PROFILE_KEYS:
                v = self.store.base.get(k)
                p.set(k, v if v is not None else
                      ("no" if k == "mouse_swap_buttons" else "none"))
        else:
            for k in MOUSE_PROFILE_KEYS:
                p.remove(k)
        self.store.changed()

    def refresh_header(self):
        super().refresh_header()
        if self.store.profile and not self.specific():
            self.title_label.set_text(self.title_label.get_text() + " - Global Settings")

    # ---- the buttons
    def binding(self, v2dk):
        """('default', None) | ('action', name) | ('mouse', BTN_*) | ('keys', [names])"""
        act = (self.value("action_" + v2dk) or "").strip().lower()
        if act and act != "none":
            return "action", act
        v = self.value("key_" + v2dk)
        names = chord_names(v)
        if not names:
            return "default", None
        if len(names) == 1 and names[0].startswith("BTN_"):
            return "mouse", names[0]
        return "keys", names

    def current_item(self, v2dk):
        """The picker entry that is the button's function now, or None."""
        kind, val = self.binding(v2dk)
        if kind == "default":
            d = MOUSE_DEFAULT[v2dk]
            # the radial-menu button's default: Common Tools (tdx-radial)
            kind, val = ("mouse", d) if d else ("action", "commontools")
        for _sec, it in picker_items():
            if picker_value_matches(it["value"], kind, val):
                return it
        return None

    def describe(self, v2dk, default):
        kind, val = self.binding(v2dk)
        it = self.current_item(v2dk)
        if it:
            return it["label"], ASSETS.icon(it["icon"]) if it.get("icon") else None, None
        if kind == "action":
            return ACTION_LABEL.get(val, val), None, None
        if kind == "mouse":
            return val, None, None
        return shortcut_label(val), ASSETS.icon("Keyboard.png"), None

    def refresh(self):
        self.updating = True
        self.refresh_header()
        self.photo.update()
        self.app_switch.set_active(self.specific())
        self.app_switch.set_sensitive(self.store.profile is not None)
        self.app_switch.set_tooltip_text(
            None if self.store.profile else
            "Choose an application in the title to give it its own buttons")
        for v2dk, (_btn, l, slot, default, tb) in self.rows.items():
            if v2dk == self.capturing:
                continue
            text, icon, tip = self.describe(v2dk, default)
            l.set_text(text)
            l.get_style_context().remove_class("tdx-placeholder")
            tb.set_tooltip_text(tip or "Click and type a shortcut")
            self.set_row_icon(slot, icon)
        self.swap.set_active(parse_bool(self.value("mouse_swap_buttons") or "no"))
        self.updating = False

    @staticmethod
    def set_row_icon(slot, icon):
        for c in slot.get_children():
            slot.remove(c)
        img = image_widget(icon, 16)
        if img:
            slot.add(img)
            img.show()

    # ---- 3DxWare's "Type a shortcut...": click a row's text, press the keys
    def start_capture(self, v2dk):
        if self.capturing and self.capturing != v2dk:
            self.stop_capture(self.capturing)
        _btn, l, slot, _d, tb = self.rows[v2dk]
        self.capturing = v2dk
        tb.get_style_context().add_class("tdx-capturing")
        l.get_style_context().add_class("tdx-placeholder")
        l.set_text("Type a shortcut…")
        tb.set_tooltip_text(None)
        self.set_row_icon(slot, ASSETS.icon("Keyboard.png"))
        tb.set_can_focus(True)
        tb.grab_focus()

    def stop_capture(self, v2dk=None):
        v2dk = v2dk or self.capturing
        if not v2dk or v2dk != self.capturing:
            return False
        tb = self.rows[v2dk][4]
        self.capturing = None
        tb.get_style_context().remove_class("tdx-capturing")
        tb.set_can_focus(False)
        self.refresh()
        return True

    def on_capture_key(self, v2dk, ev):
        if v2dk != self.capturing:
            return False
        mods = []
        st = ev.state
        if st & Gdk.ModifierType.CONTROL_MASK:
            mods.append("LEFTCTRL")
        if st & Gdk.ModifierType.SHIFT_MASK:
            mods.append("LEFTSHIFT")
        if st & Gdk.ModifierType.MOD1_MASK:
            mods.append("LEFTALT")
        if st & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
            mods.append("LEFTMETA")
        name = CODE_NAMES.get(ev.hardware_keycode - 8)  # X11/Wayland: evdev + 8
        if ev.is_modifier or name in MODIFIER_KEYS:
            # held so far: show it ("SHIFT+"), wait for the key
            if name and name in MODIFIER_KEYS:
                name = MODIFIER_KEYS[name]
                if name not in mods:
                    mods.append(name)
            self.rows[v2dk][1].set_text(shortcut_label(mods) + "+")
            return True
        if not mods and ev.keyval == Gdk.KEY_Escape:
            self.stop_capture(v2dk)
            return True
        if not name:
            return True
        keys = (mods + [name])[:4]
        self.capturing = None
        self.rows[v2dk][4].get_style_context().remove_class("tdx-capturing")
        self.rows[v2dk][4].set_can_focus(False)
        self.assign(v2dk, chord_value(keys))
        self.refresh()
        return True

    def popup(self, widget, v2dk, default):
        self.picker = ActionPicker(self, widget, v2dk, default)
        self.picker.popup()

    def capture(self, v2dk, default):
        dlg = KeyCaptureDialog(self.box.get_toplevel(), default)
        if dlg.run() == Gtk.ResponseType.OK and dlg.keys:
            self.assign(v2dk, chord_value(dlg.keys))
        dlg.destroy()

    def pick(self, v2dk, value):
        """A picker entry chosen: its value (see PICKER)."""
        if value == "default" or (value == "action:commontools" and
                                  MOUSE_DEFAULT[v2dk] is None):
            self.assign(v2dk, None)  # the radial button's own: its default
        elif value.startswith("action:"):
            self.assign(v2dk, None, action=value[7:])
        elif value.startswith("keys:"):
            self.assign(v2dk, chord_value(chord_names(value[5:])))
        elif value == MOUSE_DEFAULT[v2dk]:
            self.assign(v2dk, None)  # the button's own function: its default
        else:
            self.assign(v2dk, value)

    def assign(self, v2dk, value, action=None):
        """@value: a BTN_* mouse function, a chord, or None for the default;
        @action: a driver action instead (it beats a key, as in tdxd)."""
        f = self.conf()
        key, akey = "key_" + v2dk, "action_" + v2dk
        specific = self.specific()
        if action:
            f.set(akey, action)
            f.remove(key)
        else:
            if specific:  # a profile's own: "none" keeps the global one from showing through
                f.set(akey, "none")
            else:
                f.remove(akey)
            if value is None and specific:
                value = "none"
            if value is None:
                f.remove(key)
            else:
                f.set(key, value)
        self.store.changed()


