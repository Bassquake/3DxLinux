class ConfFile:
    """A tdxd config file edited line by line so comments and order survive."""

    LINE = re.compile(r"^(\s*)([A-Za-z0-9_]+)(\s*=\s*)(.*)$")

    def __init__(self, path):
        self.path = path
        self.lines = []
        self.dirty = False
        self.exists = False
        self.reload()

    def reload(self):
        try:
            with open(self.path, encoding="utf-8", errors="replace") as f:
                self.lines = f.read().splitlines()
            self.exists = True
        except FileNotFoundError:
            self.lines, self.exists = [], False
        self.dirty = False

    @staticmethod
    def _split_comment(rest):
        # same rule as the C parser: whitespace, '#', then whitespace/EOL
        for i, ch in enumerate(rest):
            if (ch == "#" and i > 0 and rest[i - 1].isspace()
                    and (i + 1 == len(rest) or rest[i + 1].isspace())):
                j = i
                while j > 0 and rest[j - 1].isspace():
                    j -= 1
                return rest[:j], rest[j:]
        return rest.rstrip(), ""

    def _parse(self, line):
        s = line.strip()
        if not s or s[0] in "#;":
            return None
        m = self.LINE.match(line)
        if not m:
            return None
        value, comment = self._split_comment(m.group(4))
        return m.group(2), value.strip(), m, comment

    @staticmethod
    def _same(a, b):
        # option names are case-sensitive, button ids after key_/action_ are not
        for pre in ("key_", "action_", "led_color_"):
            if a.startswith(pre) and b.startswith(pre):
                return a.lower() == b.lower()
        return a == b

    def items(self):
        for line in self.lines:
            p = self._parse(line)
            if p:
                yield p[0], p[1]

    def get(self, key, default=None):
        val = default
        for k, v in self.items():
            if self._same(k, key):
                val = v
        return val

    def has(self, key):
        return any(self._same(k, key) for k, _ in self.items())

    def keys_with_prefix(self, prefix):
        return [k for k, _ in self.items() if k.lower().startswith(prefix.lower())]

    def set(self, key, value):
        value = str(value)
        idx = [i for i, l in enumerate(self.lines)
               if (p := self._parse(l)) and self._same(p[0], key)]
        if idx:
            last = idx[-1]
            k, old, m, comment = self._parse(self.lines[last])
            if old == value and len(idx) == 1:
                return
            self.lines[last] = "%s%s%s%s%s" % (m.group(1), k, m.group(3), value, comment)
            for i in reversed(idx[:-1]):
                del self.lines[i]
        else:
            new = "%s = %s" % (key, value)
            # put it under a commented-out example of the same option, if there is one
            pat = re.compile(r"^\s*#\s*%s\s*=" % re.escape(key), re.I)
            at = next((i for i, l in enumerate(self.lines) if pat.match(l)), None)
            if at is not None:
                self.lines.insert(at + 1, new)
            else:
                if self.lines and self.lines[-1].strip():
                    pass
                self.lines.append(new)
        self.dirty = True

    def remove(self, key):
        n = len(self.lines)
        self.lines = [l for l in self.lines
                      if not ((p := self._parse(l)) and self._same(p[0], key))]
        if len(self.lines) != n:
            self.dirty = True

    def text(self):
        return "\n".join(self.lines) + "\n"


class Store:
    """The base config plus one per-application profile being edited."""

    def __init__(self, base_path, profile_dir=None):
        self.base = ConfFile(base_path)
        self.profile_dir = profile_dir or self.base.get("profile_dir", "/etc/tdxd.d")
        self.profile = None  # ConfFile or None (= editing the base file)
        self.listeners = []

    # ---- profiles
    def profile_names(self):
        try:
            names = sorted(f[:-5] for f in os.listdir(self.profile_dir)
                           if f.endswith(".conf") and not f.startswith("."))
        except OSError:
            names = []
        return names

    def profile_path(self, name):
        return os.path.join(self.profile_dir, name + ".conf")

    @staticmethod
    def import_dirs():
        """Where tdxd finds the profiles imported from 3DxWare (after profile_dir),
        in tdxd's order (profile.h)."""
        return ["/usr/local/share/tdxd/3dxware-ui/profiles", "/usr/share/tdxd/3dxware-ui/profiles",
                os.path.expanduser("~/.local/share/tdxd/3dxware-ui/profiles")]

    def imported_path(self, name):
        for d in self.import_dirs():
            p = os.path.join(d, name + ".conf")
            if os.path.isfile(p):
                return p
        return None

    def shipped_path(self, name):
        """The settings profile @name came with, for Restore Defaults: tdxd's own
        (freecad.conf, kept in /usr/share/tdxd/defaults by the packages) or the
        one imported from 3DxWare. None for a profile you made yourself."""
        here = os.path.dirname(os.path.realpath(__file__))
        for d in ("/usr/share/tdxd/defaults", "/usr/local/share/tdxd/defaults",
                  os.path.join(here, "..", "packaging", "profiles")):
            p = os.path.join(d, name + ".conf")
            if os.path.isfile(p):
                return p
        return self.imported_path(name)

    def select(self, name):
        """Edit profile @name (None: the base file). A profile imported from
        3DxWare that isn't in profile_dir yet is shown as it is; the first
        change saves a copy there (tdxd then uses that one, as for 3DxWare's
        own copy of a changed application configuration)."""
        if not name:
            self.profile = None
            return
        f = ConfFile(self.profile_path(name))
        f.imported_from = None
        if not f.exists:
            src = self.imported_path(name)
            if src:
                f.lines = ConfFile(src).lines[:]
                f.imported_from = src
        self.profile = f

    def create_profile(self, name, match):
        f = ConfFile(self.profile_path(name))
        if not f.exists:
            f.lines = ["# tdxd per-application profile, created by tdx-settings.",
                       "# Settings here override /etc/tdxd.conf while a matching "
                       "application is focused.",
                       "match = %s" % match, ""]
            f.dirty = True
        self.profile = f
        return f

    @property
    def target(self):
        return self.profile or self.base

    def files(self):
        return [self.base] + ([self.profile] if self.profile else [])

    # ---- effective values (profile over base over built-in default)
    def get(self, key, default=None):
        if self.profile and key not in DAEMON_ONLY and self.profile.has(key):
            return self.profile.get(key)
        return self.base.get(key, default)

    def get_bool(self, key, default=False):
        v = self.get(key)
        return default if v is None else parse_bool(v)

    def get_float(self, key, default):
        try:
            return float(self.get(key, default))
        except (TypeError, ValueError):
            return default

    def inherited(self, key, default=None):
        """Value the edited file would fall back to without its own setting."""
        if self.profile:
            return self.base.get(key, default)
        return default

    def set(self, key, value):
        f = self.base if key in DAEMON_ONLY else self.target
        f.set(key, value)
        self.changed()

    def reset(self, key):
        """Drop the edited file's own value (back to the base / built-in default)."""
        f = self.base if key in DAEMON_ONLY else self.target
        f.remove(key)
        self.changed()

    def changed(self):
        for cb in self.listeners:
            cb()

    def dirty(self):
        return any(f.dirty for f in self.files())


