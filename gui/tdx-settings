        self.back = self.put(flat_button("Back", 94), bx, h - 44)
        self.back.connect("clicked", lambda *_: self.stop(to_start=self.page == "pairing"))
        self.retry = self.put(flat_button("Retry", 94), bx - 104, h - 44)
        self.retry.connect("clicked", lambda *_: self.start(self.kind))
        self.close = self.put(flat_button("Close", 94), bx, h - 44)
        self.close.connect("clicked", lambda *_: self.stop())
        self.page = "choose"

    def show(self, page):
        self.page = page
        for w, v in ((self.choose, page == "choose"), (self.tiles, page == "choose"),
                     (self.text, page != "choose"), (self.progress, page == "pairing"),
                     (self.back, page in ("choose", "pairing")),
                     (self.retry, page == "timeout"),
                     (self.close, page not in ("choose", "pairing"))):
            w.set_visible(v)
            if v:
                w.show_all()
        self.refresh_header()

    def name_of(self, kind):
        return next(n for k, n, _p, _f in PAIR_KINDS if k == kind)

    def start(self, kind):
        self.kind = kind
        rc, out = self.app.daemon.request("pair", kind)
        if rc:
            self.text.set_text(out.strip().replace("error: ", "").capitalize() or
                               "Pairing could not start.")
            self.show("error")
            return
        name = self.name_of(kind)
        self.text.set_markup(
            "1. Disconnect your %s from the USB cable.\n\n"
            "2. Switch your %s <b>OFF</b> and then switch it <b>ON</b>." %
            (GLib.markup_escape_text(name), GLib.markup_escape_text(name)))
        self.progress.set_text("Detecting…")
        self.started = time.monotonic()
        self.show("pairing")
        if not self.timer:
            self.timer = GLib.timeout_add(1000, self.tick)

    def pairing_state(self):
        st = self.app.daemon.status()
        for r in st.get("receivers", []):
            if r.get("pairing"):
                return r["pairing"]
        return None

    def tick(self):
        if self.page != "pairing":
            self.timer = None
            return False
        p = self.pairing_state()
        if p and p["state"] == "on":
            self.progress.set_text("Detecting… (%d s)" % p.get("left", 0))
            return True
        if not p and time.monotonic() - self.started < 75:
            # no pairing line: the receiver is away for a moment (it drops off
            # USB once a device has paired) - wait for tdxd's result
            return True
        if p and p["state"] == "done":
            self.text.set_markup("Your <b>%s</b> was successfully paired." %
                                 GLib.markup_escape_text(p.get("name", "device")))
            self.show("done")
            self.app.poll_status()
        else:
            self.text.set_text("It is taking too long to detect your device.\n\n"
                               "Press Retry to restart pairing, and follow the steps. "
                               "If your device was paired already, it is ready to use.")
            self.show("timeout")
        self.timer = None
        return False

    def stop(self, to_start=False):
        if self.page == "pairing":
            self.app.daemon.request("pair-stop")
        if to_start:
            self.show("choose")
        else:
            self.box.get_toplevel().destroy()

    def refresh(self):
        self.refresh_header()
        self.show(self.page)  # again after the window's show_all


def draw_round_button(cr, size, glyph, color):
    """3DxWare's grey round button with a white + or x."""
    r = size / 2.0
    cr.set_source_rgb(*color)
    cr.arc(r, r, r, 0, 2 * math.pi)
    cr.fill()
    cr.set_source_rgb(1, 1, 1)
    cr.set_line_width(max(1.6, size / 16.0))
    d = size * (0.28 if glyph == "+" else 0.2)
    if glyph == "+":
        cr.move_to(r - d, r)
        cr.line_to(r + d, r)
        cr.move_to(r, r - d)
        cr.line_to(r, r + d)
    else:
        cr.move_to(r - d, r - d)
        cr.line_to(r + d, r + d)
        cr.move_to(r + d, r - d)
        cr.line_to(r - d, r + d)
    cr.stroke()


GREY_BUTTON = (0x8c / 255.0, 0x8c / 255.0, 0x8c / 255.0)
GREY_BUTTON_HOVER = (0x5a / 255.0, 0x5a / 255.0, 0x5a / 255.0)


class SlideSwitch(Gtk.ToggleButton):
    """3DxWare's slider switch with its label: a dark grey pill with a white
    knob on the left when off, blue with the knob on the right when on, pale
    when unavailable. A toggle button underneath (get_active, "toggled")."""
    W, H = 38, 18

    def __init__(self, label):
        super().__init__()
        self.get_style_context().add_class("tdx-switch")
        self.set_can_focus(False)
        self.set_relief(Gtk.ReliefStyle.NONE)
        box = Gtk.Box(spacing=12)
        box.pack_start(drawing(self.W, self.H, self.draw), False, False, 0)
        box.pack_start(lab(label), False, False, 0)
        self.add(box)
        self.connect("toggled", lambda *_: self.queue_draw())

    def draw(self, _w, cr):
        w, h, r = self.W, self.H, self.H / 2.0
        if not self.get_sensitive():
            track = (0xc8 / 255.0,) * 3
        elif self.get_active():
            track = (0x00 / 255.0, 0x78 / 255.0, 0xd7 / 255.0)
        else:
            track = (0x5a / 255.0,) * 3
        cr.set_source_rgb(*track)
        cr.arc(r, r, r, math.pi / 2, 3 * math.pi / 2)
        cr.arc(w - r, r, r, 3 * math.pi / 2, math.pi / 2)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cx = w - r if self.get_active() else r
        cr.arc(cx, r, r - 3, 0, 2 * math.pi)
        cr.fill()


