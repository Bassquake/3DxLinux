class KwinMice:
    """A CadMouse's pointer settings in KDE Plasma (Wayland), through KWin's
    input devices on D-Bus (/org/kde/KWin/InputDevice/eventN), as System
    Settings > Mouse changes them; KWin applies them at once and keeps them.
    3DxWare's "Enable acceleration" is Windows' pointer precision setting:
    here the CadMouse's acceleration profile, adaptive (on) or flat (off).
    Its wheel "Lines" is KWin's scroll factor (1.0 = Windows' 3 lines).
    Elsewhere (GNOME, X11 ...) nothing is found and the panel greys them out."""
    BUS, MGR = "org.kde.KWin", "/org/kde/KWin/InputDevice"
    DEV = "org.kde.KWin.InputDevice"

    def __init__(self):
        self.bus = None

    def _call(self, path, method, args, reply):
        if self.bus is None:
            try:
                self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            except GLib.Error:
                self.bus = False
        if not self.bus:
            raise GLib.Error("no session bus")
        return self.bus.call_sync(self.BUS, path, "org.freedesktop.DBus.Properties", method,
                                  args, reply, Gio.DBusCallFlags.NONE, 800, None)

    def get(self, path, iface, prop):
        return self._call(path, "Get", GLib.Variant("(ss)", (iface, prop)),
                          GLib.VariantType("(v)")).unpack()[0]

    def put(self, path, prop, value):
        self._call(path, "Set", GLib.Variant("(ssv)", (self.DEV, prop, value)), None)

    def devices(self):
        """KWin's object paths of the CadMouse pointers (256f:c650-c66f: the
        mice themselves and the Universal Receivers' mouse interface)."""
        try:
            names = self.get(self.MGR, "org.kde.KWin.InputDeviceManager", "devicesSysNames")
        except GLib.Error:
            return []
        out = []
        for n in names:
            path = "%s/%s" % (self.MGR, n)
            try:
                if (self.get(path, self.DEV, "vendor") == 0x256F and
                        0xC650 <= self.get(path, self.DEV, "product") <= 0xC66F and
                        self.get(path, self.DEV, "pointer")):
                    out.append(path)
            except GLib.Error:
                continue
        return out

    def acceleration(self, paths):
        try:
            return bool(self.get(paths[0], self.DEV, "pointerAccelerationProfileAdaptive"))
        except GLib.Error:
            return None

    def set_acceleration(self, paths, on):
        for p in paths:
            try:
                self.put(p, "pointerAccelerationProfileAdaptive", GLib.Variant("b", on))
                self.put(p, "pointerAccelerationProfileFlat", GLib.Variant("b", not on))
            except GLib.Error:
                pass

    def lines(self, paths):
        try:
            return max(1, int(round(self.get(paths[0], self.DEV, "scrollFactor") * 3)))
        except GLib.Error:
            return None

    def set_lines(self, paths, n):
        for p in paths:
            try:
                self.put(p, "scrollFactor", GLib.Variant("d", n / 3.0))
            except GLib.Error:
                pass
