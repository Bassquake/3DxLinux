def frameless(w):
    """No window frame from the desktop: the panels draw 3DxWare's own title
    bar, minimize and close buttons. set_decorated(False) alone does it on X11,
    but on Wayland GTK 3 then asks the compositor to decorate the window, and
    KWin draws a second set of buttons. With an empty, hidden title bar GTK
    decorates the window itself (client-side), which here is nothing: no
    title bar, and the CSS drops its shadow and border."""
    bar = Gtk.Box()
    bar.set_no_show_all(True)  # never shown, so no title bar is drawn
    w.set_titlebar(bar)
    w.get_style_context().add_class("tdx-frameless")


