        rd.connect("clicked", self.on_restore)
        self.close = self.put(flat_button("Close", 94), 557, 472)
        self.last_scale = [1.0] * 6

    def refresh(self):
        self.updating = True
        self.refresh_header()
        st = self.store
        trans = not st.get_bool("disable_translation")
        rot = not st.get_bool("disable_rotation")
        self.panzoom.set_active(trans)
        self.rotation.set_active(rot)
        self.dominant.set_active(st.get_bool("dominant"))
        ud = ((st.get("map_ty") or "ty").lower() == "tz"
              and (st.get("map_tz") or "tz").lower() == "ty")
        (self.zoom_ud if ud else self.zoom_fb).set_active(True)
        self.led.set_active(st.get_bool("led", True))
        for i, ax in enumerate(AXES):
            act, sc, rev = self.axis[i]
            group = trans if i < 3 else rot
            v = st.get_float("scale_" + ax, 1.0)
            act.set_active(v != 0)
            act.set_sensitive(group)
            live = group and v != 0
            sc.set_sensitive(live)
            rev.set_sensitive(live)
            self.glyph[i].set_visible_child_name("on" if live else "off")
            if v != 0:
                self.last_scale[i] = abs(v)
                sc.set_value(math.log10(max(0.1, min(10, abs(v)))))
            sc.set_tooltip_text("%s speed %sx" % (AXIS_LABELS[i], fmt_num(abs(v))))
            rev.set_active(st.get_bool("invert_" + ax))
        self.updating = False

    def on_zoom(self, b):
        if self.zoom_ud.get_active():
            self.store.set("map_ty", "tz")
            self.store.set("map_tz", "ty")
        elif self.store.profile and self.store.base.get("map_ty"):
            self.store.set("map_ty", "ty")
            self.store.set("map_tz", "tz")
        else:
            self.store.target.remove("map_ty")
            self.store.reset("map_tz")

    def on_active(self, i):
        act, sc, _ = self.axis[i]
        self.store.set("scale_" + AXES[i], fmt_num(self.last_scale[i]) if act.get_active()
                       else "0")

    def on_scale(self, i):
        v = 10 ** self.axis[i][1].get_value()
        if abs(self.axis[i][1].get_value()) < 0.02:
            v = 1.0
        self.last_scale[i] = v
        self.store.set("scale_" + AXES[i], fmt_num(v))

    def on_calibrate(self, _b):
        rc, out = self.app.daemon.request("calibrate")
        self.msg.set_text(out.strip().splitlines()[0] if out.strip() else
                          ("calibrated" if rc == 0 else "calibrate failed"))

    def on_restore(self, _b):
        for k in ADVANCED_KEYS:
            self.store.target.remove(k)
        self.store.changed()
        self.msg.set_text("Restored")


def mouse_dpi(store):
    try:
        return int(store.get("mouse_dpi", "1400"))
    except ValueError:
        return 1400


