        st = self.app.status
        self.fill(self.versions, [
            ("tdxd", st.get("version", "not running")),
            ("tdx-settings", APP_VERSION),
            ("GTK", "%d.%d.%d" % (Gtk.get_major_version(), Gtk.get_minor_version(),
                                  Gtk.get_micro_version())),
        ])
        for c in self.devices.get_children():
            self.devices.remove(c)
