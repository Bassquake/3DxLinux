def picker_items(sections=PICKER):
    """Every entry (not links or folders), with its section, in order."""
    for name, items in sections:
        for it in items:
            if "folder" in it:
                for sub in it["items"]:
                    yield name, sub
            elif "label" in it:
                yield name, it


def picker_value_matches(item_value, kind, val):
    """Does a picker entry's value describe this binding (kind, val)?"""
    if not item_value:
        return False
    if kind == "action":
        return item_value == "action:" + val
    if kind == "mouse":
        return item_value == val
    if kind == "keys":
        return (item_value.startswith("keys:") and
                chord_names(item_value[5:]) == val)
    return item_value == "default"


class ActionPicker:
    """3DxWare's drop-down of actions for a button: a search box, folder
    sections that open and close (the one holding the button's function in
    bold, that function highlighted), and a grip at the bottom to make it
    taller. Entries that can't work on Linux yet are greyed."""
    W, H_DEFAULT, H_MIN, H_MAX = 250, 316, 160, 900
    ARROW = 9  # the arrow's depth

    def __init__(self, panel, widget, v2dk, default):
        self.panel, self.v2dk, self.default = panel, v2dk, default
        self.current = panel.current_item(v2dk)
        self.open = set()
        # a pop-up window, as GTK's menus are, not a Gtk.Popover: a popover
        # stays inside its window, and the list must reach past the Buttons
        # window's edge (X11: a popup window; Wayland: an xdg popup)
        self.widget = widget
        pop = self.pop = Gtk.Window(type=Gtk.WindowType.POPUP)
        pop.set_type_hint(Gdk.WindowTypeHint.DROPDOWN_MENU)
        top = widget.get_toplevel()
        if isinstance(top, Gtk.Window):
            pop.set_transient_for(top)
        pop.set_attached_to(widget)
        for c in ("tdx", "tdx-picker"):
            pop.get_style_context().add_class(c)
        pop.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        pop.connect("button-press-event", self.on_press)
        pop.connect("key-press-event", self.on_key)
        pop.connect("grab-broken-event", lambda *_: self.close() or False)
        # 3DxWare's arrow on the edge facing the button: the window is
        # transparent around its frame and draws frame and arrow itself
        # (needs a compositor; without one: a plain frame, no arrow)
        screen = pop.get_screen()
        vis = screen.get_rgba_visual() if screen else None
        self.arrowed = bool(vis and screen.is_composited())
        self.flipped, self.arrow_y = False, 24 + 13
        if self.arrowed:
            pop.set_visual(vis)
            pop.set_app_paintable(True)
            pop.get_style_context().add_class("tdx-arrowed")
            pop.connect("draw", self.draw_frame)
        outer = self.outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        if self.arrowed:
            outer.set_margin_start(self.ARROW)
            outer.set_margin_top(1)
            outer.set_margin_bottom(1)
            outer.set_margin_end(1)
        self.search = Gtk.Entry()
        self.search.set_margin_start(10)
        self.search.set_margin_end(10)
        self.search.set_margin_top(10)
        self.search.set_margin_bottom(8)
        glass = ASSETS.ui("SmartUI_Flyout_MagnifyingGlass") or ASSETS.ui("SmartUI_Icon_Magnifier")
        if glass:
            from gi.repository import GdkPixbuf
            try:
                self.search.set_icon_from_pixbuf(Gtk.EntryIconPosition.SECONDARY,
                                                 GdkPixbuf.Pixbuf.new_from_file(glass))
            except GLib.Error:
                pass
        else:
            self.search.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY,
                                                "edit-find-symbolic")
        self.search.connect("changed", lambda *_: self.fill())
        outer.pack_start(self.search, False, False, 0)
        self.sw = Gtk.ScrolledWindow()
        self.sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.sw.set_size_request(self.W, getattr(panel.app, "picker_height", self.H_DEFAULT))
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.list.set_margin_start(10)
        self.list.set_margin_end(10)
        self.sw.add(self.list)
        outer.pack_start(self.sw, True, True, 0)
        grip = self.grip = Gtk.EventBox()
        grip.set_tooltip_text("Drag to make the list taller or shorter")
        img = image_widget(ASSETS.ui("SmartUI_Button_resize_handle_icon")) or lab("·····", "tdx-small",
                                                                                 xalign=0.5)
        grip.add(img)
        grip.set_size_request(-1, 10)
        grip.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.BUTTON_MOTION_MASK)
        grip.connect("button-press-event", self.grip_press)
        grip.connect("button-release-event", self.grip_release)
        grip.connect("motion-notify-event", self.grip_move)
        grip.connect("realize", lambda w: w.get_window().set_cursor(
            Gdk.Cursor.new_from_name(w.get_display(), "ns-resize")))
        outer.pack_start(grip, False, False, 2)
        pop.add(outer)
        self.fill()
        outer.show_all()

    def popup(self):
        """Beside the button's row, to its right (flipped left at the screen's
        edge), with the input grabbed as a menu does: a click anywhere else
        or Esc closes it."""
        w = self.widget
        top = w.get_toplevel()
        t0 = time.monotonic()
        dbg = os.environ.get("TDX_DEBUG_PICKER")

        def mark(what):  # TDX_DEBUG_PICKER=1: where opening it takes its time
            if dbg:
                sys.stderr.write("picker: %-22s %6.3f s\n" % (what, time.monotonic() - t0))
        if dbg:
            sys.stderr.write("picker: display %s, GTK_IM_MODULE=%s, XMODIFIERS=%s\n" % (
                type(Gdk.Display.get_default()).__name__, os.environ.get("GTK_IM_MODULE"),
                os.environ.get("XMODIFIERS")))
            self.pop.connect("map-event", lambda *_: mark("mapped") or False)
            self.pop.connect_after("draw", lambda *_: (mark("drawn") if not getattr(
                self, "_drawn", None) else None, setattr(self, "_drawn", 1)) and False)
            self.search.connect("focus-in-event", lambda *_: mark("search focused") or False)
        self.pop.realize()
        mark("realized")
        gw = self.pop.get_window()
        coords = w.translate_coordinates(top, 0, 0) if isinstance(top, Gtk.Window) else None
        if gw and coords:
            rect = Gdk.Rectangle()
            rect.x, rect.y = coords
            rect.width, rect.height = w.get_allocated_width(), w.get_allocated_height()
            self.arrow_y = 24 + rect.height // 2
            gw.connect("moved-to-rect", self.placed)
            gw.move_to_rect(rect, Gdk.Gravity.NORTH_EAST, Gdk.Gravity.NORTH_WEST,
                            Gdk.AnchorHints.FLIP_X | Gdk.AnchorHints.SLIDE_Y |
                            Gdk.AnchorHints.RESIZE_Y, 2 if self.arrowed else 10, -24)
        # as GtkMenu does: shown from inside the seat grab, with the click
        # that opened it, so Wayland makes it a grabbing popup (shown first
        # and grabbed after, KDE closes it at once)
        self.outer.show_all()
        seat = Gdk.Display.get_default().get_default_seat()
        grabbed = Gdk.GrabStatus.FAILED
        if gw and seat:
            grabbed = seat.grab(gw, Gdk.SeatCapabilities.ALL, True, None,
                                Gtk.get_current_event(),
                                lambda _seat, _win, *_: self.pop.show(), None)
        mark("grab %s" % getattr(grabbed, "value_nick", grabbed))
        if grabbed != Gdk.GrabStatus.SUCCESS:
            self.pop.show()  # no grab (e.g. an X11 grab refused): still usable
        self.pop.grab_add()
        self.search.grab_focus()
        # a popup window never counts as focused, so the entry would draw no
        # text cursor; tell it it has the focus, as GtkTreeView's search
        # popup does, so it is clear you can type
        gw = self.pop.get_window()
        if gw:
            ev = Gdk.Event.new(Gdk.EventType.FOCUS_CHANGE)
            ev.focus_change.window = gw
            ev.focus_change.in_ = 1
            self.search.send_focus_change(ev)
        mark("popup() returned")

    def placed(self, _gw, _anchor, _final, flipped_x, _flipped_y):
        """Where it went: the arrow on the left, or on the right when it
        opened to the row's left (screen edge). (PyGObject hands the two
        rectangles over as bare pointers, so only the flags are used.)"""
        if flipped_x != self.flipped and self.arrowed:
            self.flipped = flipped_x
            self.outer.set_margin_start(1 if flipped_x else self.ARROW)
            self.outer.set_margin_end(self.ARROW if flipped_x else 1)
        self.pop.queue_draw()

    def draw_frame(self, w, cr):
        """White panel with a grey frame and the arrow, on a clear window."""
        W, H, a, y = w.get_allocated_width(), w.get_allocated_height(), self.ARROW, self.arrow_y
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.restore()
        if self.flipped:  # mirror: the arrow on the right
            cr.translate(W, 0)
            cr.scale(-1, 1)
        x0 = a + 0.5
        cr.move_to(x0, 0.5)
        cr.line_to(W - 0.5, 0.5)
        cr.line_to(W - 0.5, H - 0.5)
        cr.line_to(x0, H - 0.5)
        cr.line_to(x0, y + a)
        cr.line_to(0.5, y)
        cr.line_to(x0, y - a)
        cr.close_path()
        cr.set_source_rgb(1, 1, 1)
        cr.fill_preserve()
        cr.set_source_rgb(*SECTION_LINE)
        cr.set_line_width(1)
        cr.stroke()
        return False

    def inside(self, ev):
        gw = self.pop.get_window()
        if not gw:
            return False
        _ok, ox, oy = gw.get_origin()
        return (ox <= ev.x_root < ox + gw.get_width() and
                oy <= ev.y_root < oy + gw.get_height())

    def on_press(self, _w, ev):
        if not self.inside(ev):  # a click elsewhere: close, as a menu does
            self.close()
            return True
        return False

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def close(self):
        if getattr(self, "closed", False):
            return
        self.closed = True
        self.pop.grab_remove()
        seat = Gdk.Display.get_default().get_default_seat()
        if seat:
            seat.ungrab()
        self.pop.destroy()

    # ---- resizing by the grip
    def grip_press(self, _w, ev):
        if ev.button == 1:
            self.drag = (ev.y_root, self.sw.get_allocated_height())
            # keep the pointer for the whole drag: the dots move with the
            # list's bottom edge, so the pointer soon leaves them
            self.grip.grab_add()
        return True

    def grip_release(self, _w, _ev):
        if getattr(self, "drag", None):
            self.grip.grab_remove()
        self.drag = None
        return True

    def grip_move(self, _w, ev):
        # only while held on the dots: the menu-style grab reports the pointer
        # moving over them without a button too
        if not getattr(self, "drag", None):
            return False
        if not ev.state & Gdk.ModifierType.BUTTON1_MASK:  # released elsewhere
            self.grip_release(None, None)
            return False
        y0, h0 = self.drag
        h = int(max(self.H_MIN, min(self.H_MAX, h0 + ev.y_root - y0)))
        self.sw.set_size_request(self.W, h)
        self.pop.resize(1, 1)  # shrink as well as grow with the list
        self.panel.app.picker_height = h
        return True

    # ---- the list
    def holds_current(self, items):
        for it in items:
            if it is self.current:
                return True
            if "folder" in it and self.holds_current(it["items"]):
                return True
        return False

    def fill(self):
        for c in self.list.get_children():
            self.list.remove(c)
        q = self.search.get_text().strip().lower()
        for name, items in PICKER:
            shown = self.filtered(items, q)
            if q and not shown:
                continue
            opened = bool(q) or name in self.open
            self.list.pack_start(self.head(name, opened, self.holds_current(items), 0),
                                 False, False, 0)
            if opened:
                for it in shown:
                    self.add_entry(it, q, 1)
            self.list.pack_start(self.rule(), False, False, 0)
        self.list.show_all()

    def filtered(self, items, q):
        if not q:
            return items
        out = []
        for it in items:
            if "folder" in it:
                sub = self.filtered(it["items"], q)
                if sub:
                    out.append({"folder": it["folder"], "items": sub})
            elif q in (it.get("label") or it.get("link") or "").lower():
                out.append(it)
        return out

    def add_entry(self, it, q, depth):
        if "folder" in it:
            key = "/" + it["folder"]
            opened = bool(q) or key in self.open
            self.list.pack_start(self.head(it["folder"], opened,
                                           self.holds_current(it["items"]), depth, key),
                                 False, False, 0)
            if opened:
                for sub in it["items"]:
                    self.add_entry(sub, q, depth + 1)
            self.list.pack_start(self.rule(depth), False, False, 0)
            return
        b = Gtk.Button()
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_can_focus(False)
        b.get_style_context().add_class("tdx-pick-item")
        hb = Gtk.Box(spacing=8)
        hb.set_margin_start(6 + 10 * (depth - 1))
        if "link" in it:
            l = lab(it["link"], "tdx-pick-link")
            hb.pack_start(l, False, False, 20)
            ok = bool(it.get("custom"))
        else:
            icon = Gtk.Box()
            icon.set_size_request(18, 18)
            img = image_widget(ASSETS.icon(it["icon"]), 18) if it.get("icon") else None
            if img:
                icon.add(img)
            hb.pack_start(icon, False, False, 0)
            hb.pack_start(lab(it["label"]), False, False, 0)
            ok = bool(it.get("value"))
            if it is self.current:
                b.get_style_context().add_class("tdx-pick-current")
        b.add(hb)
        b.set_sensitive(ok)
        if not ok:
            b.set_tooltip_text(NOT_LINUX)
        b.connect("clicked", lambda _b, it=it: self.choose(it))
        self.list.pack_start(b, False, False, 0)

    def head(self, name, opened, bold, depth, key=None):
        key = key or name
        eb = Gtk.EventBox()
        eb.get_style_context().add_class("tdx-pick-section")
        hb = Gtk.Box(spacing=8)
        hb.set_margin_start(4 + 10 * depth)
        hb.set_margin_top(7)
        hb.set_margin_bottom(7)
        folder = image_widget(ASSETS.ui("folder_open" if opened else "folder_closed"))
        if folder:
            hb.pack_start(folder, False, False, 0)
        hb.pack_start(lab(name, "tdx-pick-head" + (" tdx-pick-bold" if bold else "")),
                      False, False, 0)
        chev = image_widget(ASSETS.ui("SmartUI_Button_ArrowUp" if opened
                                      else "SmartUI_Button_ArrowDown"))
        hb.pack_end(chev or lab("^" if opened else "v", "tdx-more"), False, False, 4)
        eb.add(hb)
        eb.add_events(Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK |
                      Gdk.EventMask.LEAVE_NOTIFY_MASK)
        eb.connect("button-release-event", lambda *_: self.toggle(key) or True)
        # hover: grey and bold, as 3DxWare's section headings
        eb.connect("enter-notify-event", lambda w, _e: w.set_state_flags(
            Gtk.StateFlags.PRELIGHT, False) and False)
        eb.connect("leave-notify-event", lambda w, e: e.detail != Gdk.NotifyType.INFERIOR and
                   w.unset_state_flags(Gtk.StateFlags.PRELIGHT) and False)
        return eb

    def rule(self, depth=0):
        r = drawing(self.W - 20 - 10 * depth, 1, lambda _w, cr: (
            cr.set_source_rgb(*SECTION_LINE), cr.paint()) and None)
        r.set_margin_start(10 * depth)
        return r

    def toggle(self, key):
        self.open ^= {key}
        self.fill()

    def choose(self, it):
        self.close()
        if it.get("custom"):
            self.panel.capture(self.v2dk, self.default)
        else:
            self.panel.pick(self.v2dk, it["value"])



