            act.set_tooltip_text(AXIS_LABELS[i] + " active")
            sc = self.put(log_scale(212), 376, cy - 10)
            rev = self.put(Gtk.CheckButton(), 602, cy - 9)
            rev.set_tooltip_text("Reverse " + AXIS_LABELS[i])
            act.connect("toggled", self.guard(lambda b, i=i: self.on_active(i)))
            sc.connect("value-changed", self.guard(lambda s, i=i: self.on_scale(i)))
            rev.connect("toggled", self.guard(
                lambda b, ax=ax: self.store.set("invert_" + ax, "yes" if b.get_active()
                                                else "no")))
            self.axis.append((act, sc, rev))

        self.msg = lab("", "tdx-small")
