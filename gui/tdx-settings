# application

class App:
    def __init__(self, args):
        self.args = args
        self.store = Store(args.config, args.profile_dir)
        sock = args.socket or self.store.base.get("control_socket", "/run/tdxd.sock")
        self.daemon = Daemon(sock, args.status_file)
        self.status = self.daemon.status()
        self.panels = []
        self.windows = {}
        self.save_state = ""
        self.save_timer = None
        self.saving = False        # a pkexec save is running (in a thread)
        self.save_again = False    # ... and more changes came in meanwhile
        self.pw_declined = False   # the password was cancelled: save on close instead
        self.main = self.win = None
        prof = args.profile
        if prof is None and self.status.get("profile") not in (None, "default"):
            prof = self.status["profile"]
        if prof:
            self.store.select(prof)
        self.store.listeners.append(self.on_changed)
        # follow the application used last (follow_tick), unless -p chose one
        self.tdxd_profile = self.status.get("profile")
        self.last_app_keys = (None, {})
        self.selected = None  # key of the device chosen in the device chooser
        self.kwin = KwinMice()  # the CadMouse's acceleration / wheel lines on KDE

    def current_device(self):
        """The device the main window shows: the one chosen in the device
        chooser while it is connected, else the first (a 3D mouse first)."""
        entries = device_entries(self.status)
        for e in entries:
            if e["key"] == self.selected:
                return e
        return entries[0] if entries else None

    def select_device(self, key):
        self.selected = key
        for p in self.panels:
            p.refresh()

    # ---- saving
    def on_changed(self):
        """Like 3DxWare, a change takes effect right away: saved shortly after
        (a slider sends many changes), then tdxd reloads. Root-owned files go
        through pkexec - one password, which polkit keeps for a few minutes
        (auth_admin_keep) - unless the user cancelled it: then on close."""
        for p in self.panels:
            p.refresh()
        needs_pw = not all(writable(f.path) for f in self.store.files() if f.dirty)
        if needs_pw and self.pw_declined:
            self.set_save_state("Saved when you close (password)")
            return
        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(900 if needs_pw else 600, self.flush_async)
        self.set_save_state("")

    def flush_async(self, *_):
        """flush() for live changes: files that need the password are written in
        a thread, so the panel stays responsive while the password dialog is up."""
        self.save_timer = None
        if self.args.no_save:
            return False
        if self.saving:
            self.save_again = True
            return False
        dirty = [f for f in self.store.files() if f.dirty]
        if not dirty:
            return False
        if all(writable(f.path) for f in dirty):
            return self.flush()
        jobs = [(f, f.text()) for f in dirty]
        self.saving = True
        self.set_save_state("Saving…")

        def run():
            errors = []
            for f, data in jobs:
                err = write_file_data(f, data)
                if err:
                    errors.append(err)
                    break
            GLib.idle_add(done, errors)

        def done(errors):
            self.saving = False
            for f, data in jobs:  # changed again while saving: still dirty
                if not errors and f.text() == data:
                    f.dirty = False
                    f.exists = True
            if errors and errors[0] == PKEXEC_CANCELLED:
                self.pw_declined = True
                self.set_save_state("Saved when you close (password)")
            elif errors:
                self.set_save_state("Not saved: " + errors[0])
            else:
                rc, _out = self.daemon.request("reload")
                self.set_save_state("Saved" if rc == 0 else "Saved; tdxd not reloaded")
                GLib.timeout_add(800, self.poll_status)
            if self.save_again or (not errors and self.store.dirty()):
                self.save_again = False
                self.save_timer = GLib.timeout_add(300, self.flush_async)
            return False

        import threading
        self.save_thread = threading.Thread(target=run, daemon=True)
        self.save_thread.start()
        return False

    def set_save_state(self, text):
        self.save_state = text
        if self.main:
            self.main.save_label.set_text(text)

    def flush(self, *_):
        self.save_timer = None
        if self.args.no_save:
            return False
        t = getattr(self, "save_thread", None)
        if self.saving and t:  # let a live save finish first, or it could land after this one
            t.join()
        errors = [e for e in (write_file(f) for f in self.store.files() if f.dirty) if e]
        if errors:
            self.set_save_state("Not saved: " + errors[0])
            return False
        rc, out = self.daemon.request("reload")
        self.set_save_state("Saved" if rc == 0 else "Saved; tdxd not reloaded")
        GLib.timeout_add(800, self.poll_status)
        return False

    def restart(self, show_about=False):
        """Save, then start this panel again (new artwork is read at start)."""
        if self.store.dirty():
            self.flush()
        argv = [a for a in sys.argv[1:] if a != "--show-about"]
        if show_about:
            argv.append("--show-about")
        os.execv(sys.executable, [sys.executable, os.path.realpath(sys.argv[0])] + argv)

    def poll_status(self):
        self.status = self.daemon.status()
        for p in self.panels:
            p.refresh()
        return False

    @staticmethod
    def device_key(st):
        return (bool(st.get("running")),
                tuple((d.get("vid"), d.get("pid"), d.get("node")) for d in st.get("devices", [])),
                tuple((r["pid"], tuple((p["slot"], p["pid"], p["id"], p["battery"], p["charging"],
                                        p.get("active"))
                                       for p in r["paired"])) for r in st.get("receivers", [])))

    def follow_tick(self):
        """Like 3DxWare's panel, show the application used last: tdxd ignores
        focus on its own windows, so its active profile is that application's.
        When it changes the panel switches to it (a profile you chose from the
        title menu stays until then). Also refreshes the Buttons window when
        the application renames its keys (FreeCAD's workbench)."""
        st = self.daemon.status()
        if self.device_key(st) != self.device_key(self.status):
            # a device plugged in or out, or tdxd started / stopped
            gone = ({e["key"] for e in device_entries(self.status)} -
                    {e["key"] for e in device_entries(st)})
            if gone and not self.device_change_expected():
                self.close_panels()  # back to the main window, as 3DxWare
            self.status = st
            for p in self.panels:
                p.refresh()
        if self.args.profile is not None or not st.get("running"):
            return True  # -p: the profile asked for; no tdxd: nothing to follow
        prof = st.get("profile")
        if prof and prof != self.tdxd_profile:
            self.tdxd_profile = prof
            self.status = st
            cur = os.path.basename(self.store.profile.path)[:-5] if self.store.profile else None
            want = None if prof == "default" else prof
            if want != cur:
                self.switch_profile(want)
            return True
        keys = self.daemon.app_keys()
        if keys != self.last_app_keys:
            self.last_app_keys = keys
            for p in self.panels:
                if isinstance(p, ButtonsPanel):
                    p.refresh()
        return True

    # ---- profiles (the window title is the profile chooser)
    def profile_menu(self, widget):
        menu = Gtk.Menu()
        cur = os.path.basename(self.store.profile.path)[:-5] if self.store.profile else None

        def item(label, cb, active=False):
            mi = Gtk.CheckMenuItem(label=label)
            mi.set_draw_as_radio(True)
            mi.set_active(active)
            mi.connect("activate", lambda *_: cb())
            menu.append(mi)

        item("All Applications (default)", lambda: self.switch_profile(None), cur is None)
        names = self.store.profile_names()
        if cur and cur not in names:  # imported from 3DxWare, not changed yet
            names = sorted(names + [cur])
        for n in names:
            item(n, lambda n=n: self.switch_profile(n), n == cur)
        menu.append(Gtk.SeparatorMenuItem())
        mi = Gtk.MenuItem(label="New profile…")
        mi.connect("activate", lambda *_: self.new_profile())
        menu.append(mi)
        menu.show_all()
        menu.popup_at_widget(widget, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)

    def switch_profile(self, name):
        if self.store.dirty():
            self.flush()
        self.store.select(name)
        self.poll_status()

    def new_profile(self):
        dlg = Gtk.Dialog(title="New application profile", transient_for=self.win, modal=True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Create", Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_border_width(12)
        box.set_spacing(6)
        box.add(Gtk.Label(label="Application (process name, glob patterns allowed):", xalign=0))
        e = Gtk.Entry()
        app = self.status.get("app")
        e.set_text(app if app and app != "-" else "")
        e.set_activates_default(True)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box.add(e)
        dlg.show_all()
        ok = dlg.run() == Gtk.ResponseType.OK
        match = e.get_text().strip()
        dlg.destroy()
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", match.split(",")[0].replace("*", "")).strip("-.")
        if ok and name:
            if self.store.dirty():
                self.flush()
            self.store.create_profile(name, match)
            self.on_changed()

    # ---- windows
    def make_window(self, panel, parent=None):
        w = Gtk.Window(title=panel.title)
        if parent:
            w.set_transient_for(parent)
            w.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        else:
            w.set_position(Gtk.WindowPosition.CENTER)
        frameless(w)
        w.set_resizable(False)
        w.add(panel.box)
        return w

    def device_change_expected(self):
        """A device going away that the panel asked for: while pairing the
        receiver drops off USB for a moment, and removing a device takes it
        out of the list. Those windows stay open to show the result."""
        for p in self.panels:
            if isinstance(p, AddDevicePanel) and p.page == "pairing":
                return True
            if isinstance(p, ReceiverAdvancedPanel) and p.removing is not None:
                return True
        return False

    def close_panels(self):
        """A device was unplugged: close every window but the main one (and
        the device chooser), so the main window shows what is left."""
        for w in list(self.windows.values()):
            w.destroy()
        pop = getattr(self.main, "popover", None) if self.main else None
        if pop:
            pop.popdown()
        self.selected = None

    def window(self, cls):
        if cls in self.windows:
            self.windows[cls].present()
            return
        panel = cls(self)
        w = self.make_window(panel, self.win)
        panel.close.connect("clicked", lambda *_: w.destroy())
        panel.close_btn.connect("clicked", lambda *_: w.destroy())
        w.connect("destroy", lambda *_: self.closed(cls, panel))
        w.show_all()
        self.windows[cls] = w

    def closed(self, cls, panel):
        self.windows.pop(cls, None)
        self.panels.remove(panel)
        if self.store.dirty():
            self.flush()

    def show_advanced(self):
        dev = self.current_device()
        self.window(MouseAdvancedPanel if dev and dev["kind"] == "paired" else AdvancedPanel)

    def show_buttons(self):
        dev = self.current_device()
        if dev and dev["kind"] == "paired":
            self.window(MouseButtonsPanel)
            return
        self.window(ButtonsPanel)

    def show_lcd(self):
        """3DxWare's LCD Manager button opens Logitech's LCD Manager; ours opens
        tdx-lcdmanager when tdx-lcdmgr runs, else tdxd's built-in key page settings."""
        rt = os.environ.get("XDG_RUNTIME_DIR")
        sock = os.environ.get("TDX_LCD_SOCKET") or (
            os.path.join(rt, "tdx-lcd.sock") if rt else "/tmp/tdx-lcd-%d.sock" % os.getuid())
        prog = find_program("tdx-lcdmanager")
        if prog and os.path.exists(sock) and not self.args.status_file:
            args = [prog]
            if ASSETS.dir:
                args += ["--assets", ASSETS.dir]
            subprocess.Popen(args, start_new_session=True)
            return
        self.window(LcdPanel)

    def show_about(self):
        self.window(AboutPanel)

    MORE = [("Import settings", "ICO_import", "document-import", "import_dialog"),
            ("Export settings", "ICO_export", "document-export", "export_dialog"),
            ("Reset all settings", "ICO_reset", "edit-undo", "reset_dialog"),
            None,
            ("Manuals", "ICO_help", "help-contents", None),  # greyed out, as in 3DxWare here
            ("Support", None, "audio-headset", "open_support"),
            ("About", "ICO_about", "help-about", "show_about")]

    def build_more_menu(self):
        menu = Gtk.Menu()
        # no column for tick boxes before the icons (GTK keeps one by default),
        # and 3DxWare's light menu (its icons are black) whatever the desktop theme
        menu.set_reserve_toggle_size(False)
        menu.get_style_context().add_class("tdx-more")
        menu.get_toplevel().get_style_context().add_class("tdx-more-window")
        for entry in self.MORE:
            if entry is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            text, art, icon, method = entry
            mi = Gtk.MenuItem()
            box = Gtk.Box(spacing=10)
            img = image_widget(ASSETS.ui(art), 20) if art else None
            if not img:  # the theme's one-colour icon, in the menu's text colour
                img = Gtk.Image.new_from_icon_name(icon + "-symbolic", Gtk.IconSize.MENU)
                img.set_pixel_size(20)
            box.pack_start(img, False, False, 0)
            box.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
            mi.add(box)
            if method:
                mi.connect("activate", lambda _m, f=getattr(self, method): f())
            else:
                mi.set_sensitive(False)
            menu.append(mi)
        menu.show_all()
        return menu

    def more_menu(self, widget):
        """3DxWare's More menu, beside the link."""
        self.more = self.build_more_menu()
        self.more.popup_at_widget(widget, Gdk.Gravity.EAST, Gdk.Gravity.WEST, None)

    def open_support(self):
        try:
            Gtk.show_uri_on_window(self.win, PROJECT_URL + "/issues", Gdk.CURRENT_TIME)
        except GLib.Error:
            subprocess.Popen(["xdg-open", PROJECT_URL + "/issues"], start_new_session=True)

    def settings_changed(self, errors, done_text):
        """After import / reset: read the files again, tell tdxd, show the result."""
        self.store.base.reload()
        name = os.path.basename(self.store.profile.path)[:-5] if self.store.profile else None
        self.store.select(name if name in self.store.profile_names() else None)
        self.daemon.request("reload")
        self.poll_status()
        if errors:
            message(self.win, Gtk.MessageType.ERROR, "Not all settings were changed",
                    "\n".join(e for e in errors if e) or "")
        else:
            message(self.win, Gtk.MessageType.INFO, done_text, "")

    def choose_file(self, title, action, name=None):
        dlg = Gtk.FileChooserDialog(title=title, transient_for=self.win, action=action)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Save" if action == Gtk.FileChooserAction.SAVE else "Open",
                        Gtk.ResponseType.OK)
        flt = Gtk.FileFilter()
        flt.set_name("tdxd settings (*.zip)")
        flt.add_pattern("*.zip")
        dlg.add_filter(flt)
        dlg.set_current_folder(os.path.expanduser("~"))
        if name:
            dlg.set_current_name(name)
            dlg.set_do_overwrite_confirmation(True)
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        return path

    def export_dialog(self):
        if self.store.dirty():
            self.flush()
        path = self.choose_file("Export settings", Gtk.FileChooserAction.SAVE,
                                "tdxd-settings-%s.zip" % time.strftime("%Y%m%d"))
        if not path:
            return
        try:
            n = export_settings(self.store, path)
        except OSError as e:
            message(self.win, Gtk.MessageType.ERROR, "The settings were not exported", str(e))
            return
        message(self.win, Gtk.MessageType.INFO, "Settings exported",
                "%s\n(the base settings and %d profile%s)" % (path, n, "" if n == 1 else "s"))

    def import_dialog(self):
        path = self.choose_file("Import settings", Gtk.FileChooserAction.OPEN)
        if not path:
            return
        try:
            base, profiles = read_settings_archive(path)
        except ValueError as e:
            message(self.win, Gtk.MessageType.ERROR, "The settings were not imported", str(e))
            return
        what = (["the base settings"] if base is not None else []) + \
            (["%d profile%s" % (len(profiles), "" if len(profiles) == 1 else "s")] if profiles else [])
        if not confirm(self.win, "Import settings?",
                       "This replaces %s with the ones from %s. Profiles with other names "
                       "stay." % (" and ".join(what), os.path.basename(path)), "Import"):
            return
        if self.store.dirty():
            self.flush()
        self.settings_changed(import_settings(self.store, base, profiles), "Settings imported")

    def reset_dialog(self):
        if not confirm(self.win, "Reset all settings?",
                       "Speed, buttons, LCD and every other setting go back to their defaults, "
                       "and the application profiles you made or changed are removed "
                       "(the ones imported from 3DxWare stay).", "Reset"):
            return
        self.store.base.dirty = False
        if self.store.profile:
            self.store.profile.dirty = False
        self.settings_changed(reset_settings(self.store), "All settings were reset")

    def quit(self):
        if self.store.dirty():
            self.flush()
        Gtk.main_quit()

    def present(self):
        """Another start of tdx-settings: show this panel instead."""
        if self.win:
            self.win.deiconify()
            self.win.present()

    def run(self):
        set_window_icons(window_icon_files(ASSETS.dir and os.path.join(ASSETS.dir, "appicons"),
                                           "3dxware"), "tdxd-3dxware")
        self.main = MainPanel(self)
        self.win = self.make_window(self.main)
        self.win.connect("delete-event", lambda *_: (self.quit(), True)[1])
        self.win.show_all()
        self.main.refresh()
        GLib.timeout_add(1000, self.follow_tick)
        bring_back()  # after the tray's Quit
        if getattr(self.args, "show_about", False):  # back from importing the 3DxWare look
            GLib.idle_add(lambda: self.show_about() or False)
        Gtk.main()

    # ---- --snapshot
    def snapshot(self, outdir):
        os.makedirs(outdir, exist_ok=True)
        self.main = MainPanel(self)
        shots = [("main", self.main)] + [(n, c(self)) for n, c in (
            ("advanced", AdvancedPanel), ("buttons", ButtonsPanel),
            ("lcd", LcdPanel), ("about", AboutPanel))]
        for name, panel in shots:
            off = Gtk.OffscreenWindow()
            off.add(panel.box)
            off.show_all()
            panel.refresh()
            for _ in range(50):
                while Gtk.events_pending():
                    Gtk.main_iteration()
            w, h = panel.size
            surf = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
            cr = cairo.Context(surf)
            panel.box.draw(cr)
            path = os.path.join(outdir, "tdx-settings-%s.png" % name)
            surf.write_to_png(path)
            print(path, "%dx%d" % (w, h))


def main():
    global ASSETS
    GLib.set_prgname("tdx-settings")  # Wayland app id = tdx-settings.desktop (taskbar icon)
    ap = argparse.ArgumentParser(description="Settings panel for the tdxd 3Dconnexion driver")
    ap.add_argument("-c", "--config", default="/etc/tdxd.conf", help="base configuration file")
    ap.add_argument("--profile-dir", help="per-application profiles (default: profile_dir)")
    ap.add_argument("-p", "--profile", help="edit this profile instead of the active one "
                                            "('' for the default settings)")
    ap.add_argument("-s", "--socket", help="tdxd control socket (default: control_socket)")
    ap.add_argument("--assets", help="3DxWare artwork from tools/extract_3dxware_ui.py "
                                     "(default: ~/.local/share/tdxd/3dxware-ui, "
                                     "/usr/local/share/tdxd/3dxware-ui)")
    ap.add_argument("--no-assets", action="store_true", help="use the built-in drawings")
    ap.add_argument("--snapshot", metavar="DIR", help="render every window to DIR/*.png and exit")
    ap.add_argument("--status-file", help=argparse.SUPPRESS)  # canned `tdxctl status` (tests)
    ap.add_argument("--no-save", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--show-about", action="store_true", help=argparse.SUPPRESS)  # after an import
    ap.add_argument("-V", "--version", action="version", version="tdx-settings " + APP_VERSION)
    args = ap.parse_args()
    ASSETS = Assets(args.assets) if not args.no_assets else Assets("/nonexistent")
    install_css(ASSETS)
    if args.snapshot:
        App(args).snapshot(args.snapshot)
        return 0
    single = single_instance(args)
    if single is None:
        return 0  # the open panel came to the front
    app = App(args)
    if single:
        single.connect("activate", lambda *_: app.present())
    app.run()
    return 0


APP_ID = "org.tdxd.Settings"


def single_instance(args):
    """One settings panel per desktop session, like 3DxWare's: when one is open,
    starting another (the menu entry again, the 3D mouse's MENU key) brings it
    to the front. Returns the Gtk.Application holding the name, None when
    another panel has it (told to come forward; exit), or False without a
    session bus (run anyway)."""
    gapp = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
    # restarted after an import (os.execv): the bus may not have released the
    # old process's name yet
    tries = 20 if getattr(args, "show_about", False) else 1
    for i in range(tries):
        try:
            gapp.register(None)
        except GLib.Error:
            return False
        if not gapp.get_is_remote():
            return gapp
        if i + 1 < tries:
            time.sleep(0.1)
            gapp = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
    gapp.activate()  # the panel that's open: present()
    return None


if __name__ == "__main__":
    sys.exit(main())
