        self.xbtn.set_margin_end(11)
        self.xbtn.add(drawing(24, 24, lambda _w, cr: draw_round_button(
            cr, 24, "x", GREY_BUTTON_HOVER if self.x_hover else GREY_BUTTON)))
        self.xbtn.set_tooltip_text("Remove this device from the receiver")
        self.xbtn.add_events(Gdk.EventMask.BUTTON_RELEASE_MASK |
                             Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.xbtn.connect("button-release-event", lambda *_: on_remove(dev) or True)
        self.xbtn.connect("enter-notify-event", lambda *_: self.set_x_hover(True))
        self.xbtn.connect("leave-notify-event", lambda *_: self.set_x_hover(False))
        self.xbtn.set_no_show_all(True)
        self.xbtn.get_child().show()
        ov.add_overlay(self.xbtn)
        self.removing = removing
        self.connect("enter-notify-event", self.on_cross)
        self.connect("leave-notify-event", self.on_cross)

    def set_x_hover(self, on):
        self.x_hover = on
        self.xbtn.queue_draw()
        return False

    def on_cross(self, _w, ev):
        if ev.detail == Gdk.NotifyType.INFERIOR:
            return False  # into / out of a child (the remove button)
        self.set_hover(ev.type == Gdk.EventType.ENTER_NOTIFY)
        return False

    def set_hover(self, on):
        self.hover = on
        self.xbtn.set_visible(on and not self.removing)
        self.frame.queue_draw()

    def draw_frame(self, _w, cr):
        if not self.hover:
            return
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        cr.set_source_rgb(*SECTION_LINE)
        cr.set_line_width(1)
        cr.rectangle(0.5, 0.5, self.W - 1, self.H - 1)
        cr.stroke()


