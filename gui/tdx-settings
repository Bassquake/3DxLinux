# talking to the system

# ---- starting with the desktop -----------------------------------------------
# The packages enable tdx-tray and tdx-lcdmgr for every user (systemctl --global);
# a user turns them off for themselves by masking their own copies (no password).
# tdxd, the driver, is left alone.
AUTOSTART_UNITS = ["tdx-tray.service", "tdx-lcdmgr.service"]


def systemctl():
    return os.environ.get("TDX_SYSTEMCTL") or "systemctl"  # (tests)


def autostart_enabled():
    """False when the user turned starting with the desktop off (masked)."""
    try:
        out = subprocess.run([systemctl(), "--user", "is-enabled", AUTOSTART_UNITS[0]],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return True
    return not out.startswith("masked")


def set_autostart(on, start_now=False):
    """Start (or not) the tray icon and the LCD Manager with the desktop; with
    @start_now also start them now."""
    try:
        subprocess.run([systemctl(), "--user", "unmask" if on else "mask"] + AUTOSTART_UNITS,
                       capture_output=True, timeout=10)
        if on and start_now:
            subprocess.run([systemctl(), "--user", "start"] + AUTOSTART_UNITS,
                           capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


def bring_back():
    """Opening the panel brings back the tray icon and the LCD Manager after the
    tray's Quit (they stopped for the session). Not when Start with the Desktop
    is off: that switched them off. "start" leaves running ones alone; in the
    background, so the panel opens at once. True if it asked systemd."""
    if not autostart_enabled():
        return False
    try:
        subprocess.Popen([systemctl(), "--user", "start"] + AUTOSTART_UNITS,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return False
    return True


def find_program(name):
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (os.path.join(here, name),
                 os.path.join(here, "..", "build", os.uname().machine, name),
                 os.path.join(here, "..", "lib", "tdxd", name),
                 "/usr/local/lib/tdxd/" + name, "/usr/lib/tdxd/" + name):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return os.path.realpath(cand)
    return shutil.which(name)


class Daemon:
    def __init__(self, socket_path, status_file=None):
        self.socket = socket_path
        self.status_file = status_file
        self.tdxctl = find_program("tdxctl")

    def request(self, *args):
        if self.status_file and args == ("status",):
            with open(self.status_file) as f:
                return 0, f.read()
        if self.status_file:
            return 1, "demo mode: tdxd not contacted\n"
        if not self.tdxctl:
            return 127, "tdxctl not found\n"
        try:
            p = subprocess.run([self.tdxctl, "-s", self.socket] + list(args),
                               capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired) as e:
            return 1, str(e) + "\n"
        return p.returncode, p.stdout + p.stderr

    def app_keys(self):
        """(application, {V3DK: name}): the names the focused application gave
        its keys (the FreeCAD add-on, per workbench), or (None, {})."""
        rc, out = self.request("app-keys")
        lines = out.splitlines() if rc == 0 else []
        app = lines[0][4:].strip() if lines and lines[0].startswith("app ") else "-"
        keys = dict(l.split("\t", 1) for l in lines[1:] if "\t" in l)
        return (None, {}) if app == "-" or not keys else (app, keys)

    def status(self):
        rc, out = self.request("status")
        st = {"running": rc == 0, "devices": [], "receivers": [], "raw": out}
        if rc:
            return st
        for line in out.splitlines():
            if line.startswith("tdxd "):
                st["version"] = line[5:].strip()
            elif line.startswith("profile "):
                st["profile"] = line[8:].strip()
            elif line.startswith("application "):
                m = re.match(r"application (\S+) \(via (\S+)\)", line)
                if m:
                    st["app"], st["via"] = m.group(1), m.group(2)
            elif line.startswith("receiver "):
                m = re.match(r"receiver (.+?) \[([0-9a-f]{4}):([0-9a-f]{4})\] firmware (\S+)", line)
                if m:
                    st["receivers"].append({"name": m.group(1), "vid": m.group(2),
                                            "pid": m.group(3), "firmware": m.group(4),
                                            "paired": []})
            elif line.startswith("pairing ") and st["receivers"]:
                parts = line.split(None, 3)
                p = {"state": parts[1] if len(parts) > 1 else "?"}
                if p["state"] == "on" and len(parts) > 2 and parts[2].isdigit():
                    p["left"] = int(parts[2])
                elif p["state"] == "done" and len(parts) > 3:
                    p["slot"], p["name"] = int(parts[2]), parts[3]
                st["receivers"][-1]["pairing"] = p
            elif line.startswith("paired ") and st["receivers"]:
                m = re.match(r"paired (\d+) (.+?) \[([0-9a-f]{4}):([0-9a-f]{4})\] id (\S+) "
                             r"battery (\S+) charging (\S+) seen (\S+)(?: active (\S+))?"
                             r"(?: serial (\S+))?", line)
                if m:
                    num = lambda v: int(v) if v.isdigit() else None
                    st["receivers"][-1]["paired"].append({
                        "slot": int(m.group(1)), "name": m.group(2), "vid": m.group(3),
                        "pid": m.group(4), "id": m.group(5), "battery": num(m.group(6)),
                        "charging": m.group(7) == "yes", "seen": num(m.group(8)),
                        "active": m.group(9) != "no", "serial": m.group(10)})
            elif line.startswith("  "):
                m = re.match(r"\s+(.+?) \[([0-9a-f]{4}):([0-9a-f]{4})\] (\S+) firmware (\S+)",
                             line)
                if m:
                    st["devices"].append({"name": m.group(1), "vid": m.group(2),
                                          "pid": m.group(3), "node": m.group(4),
                                          "firmware": m.group(5)})
            else:
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[0] in ("speed", "panzoom", "rotation", "dominant"):
                    st[parts[0]] = parts[1]
        return st


def write_file(conf, parent=None):
    """Write @conf, falling back to the pkexec helper. Returns an error string or None."""
    err = write_file_data(conf, conf.text())
    if not err:
        conf.dirty = False
        conf.exists = True
    return err


def write_file_data(conf, data):
    """Write @data to @conf's file (pkexec if it is root's); leaves @conf itself
    alone, so a save thread can call it. An error string or None."""
    d = os.path.dirname(conf.path) or "."
    try:
        if not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        tmp = conf.path + ".tdx-settings.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(data)
        if conf.exists:
            shutil.copymode(conf.path, tmp)
        else:
            os.chmod(tmp, 0o644)
        os.replace(tmp, conf.path)
    except PermissionError:
        return pkexec_write(conf.path, data)
    except OSError as e:
        return "%s: %s" % (conf.path, e.strerror)
    return None


PKEXEC_CANCELLED = "password cancelled"


def pkexec_write(path, data):
    """Write @data to the root-owned @path through `pkexec tdx-settings-helper`.
    None, PKEXEC_CANCELLED (the user dismissed the password dialog) or an error."""
    helper = find_program("tdx-settings-helper")
    pkexec = shutil.which("pkexec")
    if not helper or not pkexec:
        return "%s is not writable (and pkexec / tdx-settings-helper is missing)" % path
    try:
        p = subprocess.run([pkexec, helper, "write", path], input=data, text=True,
                           capture_output=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    if p.returncode in (126, 127):  # pkexec: dialog dismissed / not authorized
        return PKEXEC_CANCELLED
    if p.returncode:
        return (p.stderr or p.stdout or "pkexec failed (%d)" % p.returncode).strip()
    return None


def pkexec_remove(path):
    """Remove the root-owned profile @path through `pkexec tdx-settings-helper`."""
    helper = find_program("tdx-settings-helper")
    pkexec = shutil.which("pkexec")
    if not helper or not pkexec:
        return "%s can't be removed (pkexec / tdx-settings-helper is missing)" % path
    try:
        p = subprocess.run([pkexec, helper, "remove", path], capture_output=True, text=True,
                           timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    if p.returncode in (126, 127):
        return PKEXEC_CANCELLED
    if p.returncode:
        return (p.stderr or p.stdout or "pkexec failed (%d)" % p.returncode).strip()
    return None


def remove_file(path):
    """Remove a settings file (pkexec if it is root's). An error string or None."""
    try:
        os.remove(path)
    except FileNotFoundError:
        return None
    except PermissionError:
        return pkexec_remove(path)
    except OSError as e:
        return "%s: %s" % (path, e.strerror)
    return None


PROFILE_NAME = re.compile(r"^[A-Za-z0-9_-][A-Za-z0-9_.-]*$")


def export_settings(store, path):
    """More > Export settings: the base file and every profile in profile_dir,
    as a zip (tdxd.conf, tdxd.d/NAME.conf). The number of profiles."""
    import zipfile
    names = store.profile_names()
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("tdxd.conf", store.base.text())
        for n in names:
            with open(store.profile_path(n), encoding="utf-8", errors="replace") as f:
                z.writestr("tdxd.d/%s.conf" % n, f.read())
    return len(names)


def read_settings_archive(path):
    """An exported settings zip -> (base text or None, {profile name: text});
    only tdxd.conf and tdxd.d/NAME.conf, each under 1 MiB. ValueError if it
    isn't one."""
    import zipfile
    try:
        z = zipfile.ZipFile(path)
    except (OSError, zipfile.BadZipFile) as e:
        raise ValueError("not a settings file: %s" % e)
    base, profiles = None, {}
    with z:
        for info in z.infolist():
            name = info.filename
            if info.is_dir():
                continue
            if info.file_size > 1048576:
                raise ValueError("%s is too large" % name)
            if name == "tdxd.conf":
                base = z.read(info).decode("utf-8", "replace")
            elif name.startswith("tdxd.d/") and name.endswith(".conf") and \
                    PROFILE_NAME.match(name[7:-5]) and "/" not in name[7:]:
                profiles[name[7:-5]] = z.read(info).decode("utf-8", "replace")
    if base is None and not profiles:
        raise ValueError("no tdxd settings in it")
    return base, profiles


def import_settings(store, base, profiles):
    """Write imported settings: the base file and the profiles (same names are
    replaced, others kept). Errors (list)."""
    errors = []
    jobs = ([(store.base.path, base)] if base is not None else []) + \
        [(store.profile_path(n), t) for n, t in sorted(profiles.items())]
    for path, text in jobs:
        f = ConfFile(path)
        f.lines = text.splitlines()
        err = write_file(f)
        if err:
            errors.append(err)
            if err == PKEXEC_CANCELLED:
                break
    return errors


def shipped_default(name):
    """The default copy of a settings file the package came with (tdxd.conf,
    freecad.conf ...), or None."""
    here = os.path.dirname(os.path.realpath(__file__))
    for d in ("/usr/share/tdxd/defaults", "/usr/local/share/tdxd/defaults",
              os.path.join(here, "..", "packaging"), os.path.join(here, "..", "packaging", "profiles")):
        p = os.path.join(d, name)
        if os.path.isfile(p):
            return p
    return None


def reset_settings(store):
    """More > Reset all settings: the base file back to its default, tdxd's own
    profiles (FreeCAD's) back to theirs, the others in profile_dir removed (the
    imported 3DxWare ones elsewhere stay). Errors (list)."""
    errors = []
    src = shipped_default("tdxd.conf")
    if src:
        f = ConfFile(store.base.path)
        f.lines = ConfFile(src).lines[:]
        err = write_file(f)
        if err:
            return [err]
    for n in store.profile_names():
        path = store.profile_path(n)
        src = shipped_default(n + ".conf")
        if src:
            f = ConfFile(path)
            f.lines = ConfFile(src).lines[:]
            err = write_file(f)
        else:
            err = remove_file(path)
        if err:
            errors.append(err)
            if err == PKEXEC_CANCELLED:
                break
    return errors


def writable(path):
    if os.path.exists(path):
        return os.access(path, os.W_OK) and os.access(os.path.dirname(path) or ".", os.W_OK)
    d = os.path.dirname(path) or "."
    while not os.path.exists(d):
        d = os.path.dirname(d)
    return os.access(d, os.W_OK)


