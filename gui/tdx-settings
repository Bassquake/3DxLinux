class KeyCaptureDialog(Gtk.Dialog):
    """Press a key combination; records evdev key names (hardware keycode - 8)."""

    def __init__(self, parent, button_name):
        super().__init__(title="Keystroke for " + button_name, transient_for=parent, modal=True)
        self.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        self.set_response_sensitive(Gtk.ResponseType.OK, False)
        self.keys = []
        box = self.get_content_area()
        box.set_border_width(14)
        box.set_spacing(8)
        box.add(Gtk.Label(label="Press the key combination to send:"))
        self.shown = Gtk.Label()
        self.shown.set_markup("<span size='x-large'>…</span>")
        box.add(self.shown)
        self.connect("key-press-event", self.on_key)
        self.show_all()

    def on_key(self, _w, ev):
        code = ev.hardware_keycode - 8  # X11/Wayland keycodes are evdev + 8
        name = CODE_NAMES.get(code, str(code))
        mods = []
        st = ev.state
        if st & Gdk.ModifierType.CONTROL_MASK:
            mods.append("LEFTCTRL")
        if st & Gdk.ModifierType.SHIFT_MASK:
            mods.append("LEFTSHIFT")
        if st & Gdk.ModifierType.MOD1_MASK:
            mods.append("LEFTALT")
        if st & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
            mods.append("LEFTMETA")
        keys = mods + ([name] if name not in mods else [])
        self.keys = keys[:4]
        self.shown.set_markup("<span size='x-large'>%s</span>"
                              % GLib.markup_escape_text(pretty_chord(self.keys)))
        self.set_response_sensitive(Gtk.ResponseType.OK, True)
        return True


def chord_names(value):
    """'KEY_LEFTCTRL + KEY_C' -> ['LEFTCTRL', 'C']; 'none' -> []."""
    if not value or value.strip().lower() == "none":
        return []
    out = []
    for t in value.split("+"):
        t = t.strip().upper()
        if t.startswith("KEY_"):
            t = t[4:]
        if t:
            out.append(t)
    return out


def pretty_chord(names):
    return "+".join(PRETTY_KEY.get(n, n.title() if len(n) > 1 else n) for n in names)


def chord_value(names):
    return "+".join("KEY_" + n if not n.isdigit() or n in KEY_CODES else n for n in names)


