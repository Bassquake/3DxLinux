def parse_bool(v):
    v = (v or "").strip().lower()
    if v in ("yes", "true", "on"):
        return True
    try:
        return int(v, 0) != 0
    except ValueError:
        return False


def fmt_num(x):
    s = "%.3f" % x
    return s.rstrip("0").rstrip(".") if "." in s else s


