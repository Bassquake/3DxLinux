            rb = Gtk.RadioButton.new_with_label_from_widget(first, name)
            first = first or rb
            rb.connect("toggled", self.guard(lambda b, v=val: b.get_active() and self.on_bright(v)))
            br.pack_start(rb, False, False, 0)
            self.bright[val] = rb
        self.bright[None].set_tooltip_text("Leave the brightness as the device has it")
        right.pack_start(frame("Brightness", br), False, False, 0)

        g = Gtk.Grid(column_spacing=8, row_spacing=4)
        self.labels = []
        for i in range(10):
            lab = Gtk.Label(label=str(i + 1), xalign=1)
            e = Gtk.Entry()
            e.set_max_length(23)
            e.set_width_chars(12)
            e.connect("changed", self.guard(lambda w, i=i: self.on_label(i)))
            c, r = divmod(i, 5)
            g.attach(lab, c * 2, r, 1, 1)
            g.attach(e, c * 2 + 1, r, 1, 1)
            self.labels.append(e)
        right.pack_start(frame("Key labels", g), False, False, 0)

        img = Gtk.Box(spacing=6)
        self.image = Gtk.FileChooserButton(title="LCD image (320×240 PPM)")
        flt = Gtk.FileFilter()
        flt.set_name("PPM images")
        flt.add_pattern("*.ppm")
        self.image.add_filter(flt)
        self.image.connect("file-set", self.guard(self.on_image))
        img.pack_start(self.image, True, True, 0)
        clr = Gtk.Button(label="Clear")
        clr.connect("clicked", lambda *_: self.store.reset("lcd_image"))
        img.pack_start(clr, False, False, 0)
        right.pack_start(frame("Image instead of labels", img), False, False, 0)
        top.pack_start(right, True, True, 0)
        self.box.pack_start(top, True, True, 0)

        foot = Gtk.Box(spacing=8)
        self.close = Gtk.Button(label="Close")
        foot.pack_end(self.close, False, False, 0)
        self.box.pack_end(foot, False, False, 0)

    def label_values(self):
        return [self.store.get("lcd_label_%d" % (i + 1)) or "Key %d" % (i + 1)
                for i in range(10)]

    def draw_preview(self, w, cr):
        devs = self.app.status.get("devices", [])
        draw_lcd_preview(w, cr, self.label_values(),
                         devs[0]["name"] if devs else "SpacePilot Pro",
                         1 if self.page2.get_active() else 0)

    def refresh(self):
        self.updating = True
        self.enable.set_active(parse_bool(self.store.base.get("lcd", "yes")))
        b = self.store.get("lcd_brightness")
        try:
            b = int(b) if b is not None else None
        except ValueError:
            b = None
        if b is None or b < 0:
            self.bright[None].set_active(True)
        else:
            near = min(BRIGHTNESS, key=lambda nv: abs(nv[1] - b))[1]
            self.bright[near].set_active(True)
        for i, e in enumerate(self.labels):
            v = self.store.get("lcd_label_%d" % (i + 1)) or ""
            if e.get_text() != v:
                e.set_text(v)
            e.set_placeholder_text("Key %d" % (i + 1))
        path = self.store.get("lcd_image")
        if path:
            self.image.set_filename(path)
        else:
            self.image.unselect_all()
        self.preview.queue_draw()
        self.updating = False

    def on_bright(self, v):
        if v is None:
            self.store.reset("lcd_brightness")
        else:
            self.store.set("lcd_brightness", v)

    def on_label(self, i):
        t = self.labels[i].get_text().strip()
        if t:
            self.store.set("lcd_label_%d" % (i + 1), t)
        else:
            self.store.reset("lcd_label_%d" % (i + 1))
        self.preview.queue_draw()

    def on_image(self, fc):
        p = fc.get_filename()
        if p:
            self.store.set("lcd_image", p)


