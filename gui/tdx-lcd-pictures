#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Picture Viewer - Linux port of 3Dconnexion's "Picture Viewer" LCD applet
(zz3DxLCD60Picture.exe, LCDPictureViewer) for the SpacePilot PRO.

Shows the pictures of a folder (optionally its subfolders, optionally in random
order) one after another, every Interval seconds, with the original's
transitions: None, Fade, Wipe, Circle Wipe, Scatter, or a random one each time.

  LEFT / RIGHT  previous / next picture
  OK            pause / resume (play / pause overlay)

Settings as in the original (HKCU\\...\\3DxLCDPicture\\Settings: DefaultFolder,
IncludeSubfolder, Interval, Transition), in ~/.config/tdxd/pictures.json. The
default folder is the 3Dconnexion sample pictures extracted from the installer,
else ~/Pictures.
"""

import math
import os
import random
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import lcdapplet as la  # noqa: E402
import cairo  # noqa: E402

TRANSITIONS = ["None", "Fade", "Wipe", "Circle Wipe", "Scatter"]
EXTS = (".jpg", ".jpeg", ".png", ".bmp", ".gif", ".tif", ".tiff", ".webp")
TRANSITION_S = 0.8


def load_image(path):
    """A 320x240 cairo surface with the picture scaled to fit (letterboxed)."""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import GdkPixbuf, Gdk
    pb = GdkPixbuf.Pixbuf.new_from_file(path)
    pb = pb.apply_embedded_orientation() or pb
    s = min(la.W / pb.get_width(), la.H / pb.get_height())
    w, h = max(1, int(pb.get_width() * s)), max(1, int(pb.get_height() * s))
    pb = pb.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, la.W, la.H)
    cr = cairo.Context(surf)
    cr.set_source_rgb(0, 0, 0)
    cr.paint()
    Gdk.cairo_set_source_pixbuf(cr, pb, (la.W - w) // 2, (la.H - h) // 2)
    cr.paint()
    return surf


class Pictures(la.Applet):
    NAME = "Picture Viewer"
    ART = "pictures"
    CONFIG = "pictures.json"
    CONFIG_DEFAULTS = {"folder": "", "subfolders": False, "random": False, "interval": 5,
                       "transition": "Fade", "random_transition": False}
    FPS = 4

    def __init__(self):
        self.files, self.idx = [], 0
        self.cur = self.prev = None
        self.t_start = 0
        self.t_kind = "None"
        self.paused = False
        self.overlay_until = 0
        self.shown_at = time.time()
        self.scatter = None
        super().__init__()
        self.scan()

    def folder(self):
        f = self.cfg.get("folder") or ""
        if f and os.path.isdir(f):
            return f
        d = self.art.path("default")
        if d:
            return d
        return os.path.expanduser("~/Pictures")

    def config_changed(self):
        super().config_changed()
        if hasattr(self, "files"):
            self.scan()

    def scan(self):
        root = self.folder()
        files = []
        if self.cfg.get("subfolders"):
            for dp, _dn, fn in os.walk(root):
                files += [os.path.join(dp, f) for f in fn if f.lower().endswith(EXTS)]
        elif os.path.isdir(root):
            files = [os.path.join(root, f) for f in os.listdir(root) if f.lower().endswith(EXTS)]
        files.sort()
        if self.cfg.get("random"):
            random.shuffle(files)
        self.files, self.idx = files, 0
        self.cur, self.prev = self.load(0), None
        self.dirty = True

    def load(self, i):
        for k in range(len(self.files)):
            p = self.files[(i + k) % len(self.files)]
            try:
                self.idx = (i + k) % len(self.files)
                return load_image(p)
            except Exception:
                continue
        return None

    def go(self, step):
        if not self.files:
            return
        self.prev = self.cur
        self.cur = self.load((self.idx + step) % len(self.files))
        kinds = TRANSITIONS[1:] if self.cfg.get("random_transition") else [
            self.cfg.get("transition", "Fade")]
        self.t_kind = random.choice(kinds)
        self.t_start = time.time()
        self.scatter = None
        self.shown_at = time.time()

    def tick(self, now):
        busy = self.prev is not None and now - self.t_start < TRANSITION_S
        if self.prev is not None and not busy:
            self.prev = None
            return True
        if not self.paused and self.files and now - self.shown_at >= max(1, int(
                self.cfg.get("interval", 5))):
            self.go(1)
            return True
        if self.overlay_until and now > self.overlay_until:
            self.overlay_until = 0
            return True
        return busy

    def run(self):
        # faster frames during transitions
        self.FPS = 4
        super().run()

    def push(self):
        super().push()
        self.FPS = 20 if self.prev is not None else 4

    def on_buttons(self, pressed, held):
        if pressed & la.RIGHT:
            self.go(1)
        elif pressed & la.LEFT:
            self.go(-1)
        elif pressed & la.OK:
            self.paused = not self.paused
            self.overlay_until = time.time() + 1.5
            self.shown_at = time.time()

    def draw(self, cr):
        if not self.files or self.cur is None:
            if not self.art.paint(cr, "png_1018"):
                cr.set_source_rgb(0.6, 0.62, 0.64)
                cr.paint()
                la.default_header(cr, "")
                cr.set_source_rgb(0.1, 0.1, 0.1)
                la.rounded(cr, 45, 70, 230, 130, 6)
                cr.fill()
                la.text(cr, 55, 120, "No pictures found\nin specified folder", 16, (1, 1, 1),
                        width=210, align="center")
            return
        t = (time.time() - self.t_start) / TRANSITION_S if self.prev is not None else 1.0
        t = max(0.0, min(1.0, t))
        if self.prev is None or self.t_kind == "None" or t >= 1:
            cr.set_source_surface(self.cur, 0, 0)
            cr.paint()
        else:
            cr.set_source_surface(self.prev, 0, 0)
            cr.paint()
            cr.save()
            if self.t_kind == "Fade":
                cr.set_source_surface(self.cur, 0, 0)
                cr.paint_with_alpha(t)
            elif self.t_kind == "Wipe":
                cr.rectangle(0, 0, la.W * t, la.H)
                cr.clip()
                cr.set_source_surface(self.cur, 0, 0)
                cr.paint()
            elif self.t_kind == "Circle Wipe":
                cr.arc(la.W / 2, la.H / 2, t * math.hypot(la.W, la.H) / 2, 0, 2 * math.pi)
                cr.clip()
                cr.set_source_surface(self.cur, 0, 0)
                cr.paint()
            else:  # Scatter: 16x16 blocks appear in random order
                if self.scatter is None:
                    self.scatter = [(x, y) for x in range(0, la.W, 16) for y in range(0, la.H, 16)]
                    random.shuffle(self.scatter)
                for x, y in self.scatter[:int(len(self.scatter) * t)]:
                    cr.rectangle(x, y, 16, 16)
                cr.clip()
                cr.set_source_surface(self.cur, 0, 0)
                cr.paint()
            cr.restore()
        if self.overlay_until:  # play / pause (png_1022 / png_1023)
            name = "png_1023" if self.paused else "png_1022"
            if not self.art.paint(cr, name, (la.W - 88) // 2, (la.H - 88) // 2):
                cr.set_source_rgba(0.9, 0.9, 0.9, 0.85)
                la.rounded(cr, 116, 76, 88, 88, 10)
                cr.fill()
                la.text(cr, 116, 76, "II" if self.paused else "▶", 36, (0.2, 0.2, 0.2),
                        width=88, align="center", valign_h=88)

    # Configure... (the original's "PictureViewer Config" dialog)
    def configure_dialog(self):
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
        dlg = Gtk.Dialog(title="Picture Viewer")
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_border_width(10)
        box.set_spacing(8)

        fr = Gtk.Frame(label="Image Folder")
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        v.set_border_width(8)
        folder = Gtk.Entry(text=self.cfg.get("folder") or self.folder())
        folder.set_width_chars(46)
        v.pack_start(folder, False, False, 0)
        hb = Gtk.Box(spacing=8)
        sub = Gtk.CheckButton(label="Include Subfolders")
        sub.set_active(bool(self.cfg.get("subfolders")))
        choose = Gtk.Button(label="Choose Folder")
        hb.pack_start(sub, False, False, 0)
        hb.pack_end(choose, False, False, 0)
        v.pack_start(hb, False, False, 0)
        rnd = Gtk.CheckButton(label="Random")
        rnd.set_active(bool(self.cfg.get("random")))
        v.pack_start(rnd, False, False, 0)
        fr.add(v)
        box.pack_start(fr, False, False, 0)

        def pick(_b):
            fc = Gtk.FileChooserDialog(title="Select picture folder", transient_for=dlg,
                                       action=Gtk.FileChooserAction.SELECT_FOLDER)
            fc.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
            fc.set_filename(folder.get_text())
            if fc.run() == Gtk.ResponseType.OK:
                folder.set_text(fc.get_filename())
            fc.destroy()
        choose.connect("clicked", pick)

        fr2 = Gtk.Frame(label="Display Time")
        hb2 = Gtk.Box(spacing=6)
        hb2.set_border_width(8)
        secs = Gtk.SpinButton.new_with_range(1, 3600, 1)
        secs.set_value(int(self.cfg.get("interval", 5)))
        hb2.pack_start(secs, False, False, 0)
        hb2.pack_start(Gtk.Label(label="seconds"), False, False, 0)
        fr2.add(hb2)
        box.pack_start(fr2, False, False, 0)

        fr3 = Gtk.Frame(label="Transition Type")
        v3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        v3.set_border_width(8)
        r1 = Gtk.RadioButton.new_with_label(None, "Random")
        r2 = Gtk.RadioButton.new_with_label_from_widget(r1, "Specific Transition:")
        combo = Gtk.ComboBoxText()
        for t in TRANSITIONS:
            combo.append_text(t)
        cur = self.cfg.get("transition", "Fade")
        combo.set_active(TRANSITIONS.index(cur) if cur in TRANSITIONS else 1)
        (r1 if self.cfg.get("random_transition") else r2).set_active(True)
        v3.pack_start(r1, False, False, 0)
        v3.pack_start(r2, False, False, 0)
        v3.pack_start(combo, False, False, 0)
        fr3.add(v3)
        box.pack_start(fr3, False, False, 0)

        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            f = folder.get_text().strip()
            self.cfg.update({
                "folder": "" if f == self.art.path("default") else f,
                "subfolders": sub.get_active(), "random": rnd.get_active(),
                "interval": int(secs.get_value()), "random_transition": r1.get_active(),
                "transition": combo.get_active_text() or "Fade"})
            self.save_config()
        dlg.destroy()


if __name__ == "__main__":
    sys.exit(la.main(Pictures))
