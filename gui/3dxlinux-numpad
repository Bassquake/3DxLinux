#!/usr/bin/env python3
"""3dxlinux-numpad: 3DxWare's Virtual NumPad (3DxNumpad.exe) on Linux.

A number pad on the screen for keyboards without one: the radial menu's
Virtual NumPad (Driver_Toggle_3DxNumPad) shows it, and shows it again to
hide it; a button can too (action_V2DK_... = numpad). Its keys are typed
into the window you are working in, as 3DxNumpad's SendInput does:

    7 8 9 /    the keypad's keys (3DxWare: VK_NUMPAD7.., VK_DIVIDE ..);
    4 5 6 *    3dxlinuxd puts Num Lock on for the digits if it is off, as
    1 2 3 -    VK_NUMPAD0.. ignore it
    0 , . +    "," and "." the characters
    <-  Enter  Backspace and Enter

It never takes the keyboard focus (Wayland: a gtk-layer-shell surface with
no keyboard; X11: a window that accepts no focus), so the keys go where the
text cursor is. Drag its title to move it, the dots at the bottom right to
make it bigger or smaller; the gear shows its options, the X closes it:

    Initial position: Next to input cursor   Linux has no caret position for
        other programs: next to the pointer where the radial menu opened
    Automatically move pointer on top of NumPad   X11 moves the pointer;
        Wayland can't, so the NumPad opens under the pointer instead
    Auto hide   fades out once the pointer has left it (3DxWare: a click
        outside it); back over it in time, it stays

Options, place and size are kept in ~/.config/3dxlinux/numpad.json.
"""
import argparse
import json
import math
import os
import signal
import socket
import sys

import cairo
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GLib, Gtk, Pango, PangoCairo  # noqa: E402
try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell  # noqa: E402
except (ValueError, ImportError):
    GtkLayerShell = None

APP_VERSION = "dev"

# 3DxNumpad's window at 100 % scaling, and its keys (label, evdev keys,
# column, row, columns wide)
W, H = 220, 340
KEYS = [
    ("7", "KEY_KP7", 0, 0, 1), ("8", "KEY_KP8", 1, 0, 1), ("9", "KEY_KP9", 2, 0, 1),
    ("/", "KEY_KPSLASH", 3, 0, 1),
    ("4", "KEY_KP4", 0, 1, 1), ("5", "KEY_KP5", 1, 1, 1), ("6", "KEY_KP6", 2, 1, 1),
    ("*", "KEY_KPASTERISK", 3, 1, 1),
    ("1", "KEY_KP1", 0, 2, 1), ("2", "KEY_KP2", 1, 2, 1), ("3", "KEY_KP3", 2, 2, 1),
    ("–", "KEY_KPMINUS", 3, 2, 1),
    ("0", "KEY_KP0", 0, 3, 1), (",", "KEY_COMMA", 1, 3, 1), (".", "KEY_DOT", 2, 3, 1),
    ("+", "KEY_KPPLUS", 3, 3, 1),
    ("←", "KEY_BACKSPACE", 0, 4, 2), ("↵", "KEY_ENTER", 2, 4, 2),
]
GRID_X, GRID_Y, GRID_W, GRID_H, GAP = 24, 79, 172, 218, 2
TITLE_LINE_Y = 58
SCALE_MIN, SCALE_MAX = 0.75, 3.0
FADE_MS = 250                 # 3DxNumpad's FadingWindow: 0.25 s
AUTO_HIDE_DELAY_MS = 1200
DEFAULTS = {"next_to_cursor": True, "move_pointer": True, "auto_hide": True,
            "x": None, "y": None, "scale": 1.0}

KEY_BG = (0x8d / 255,) * 3
KEY_HOVER = (0x76 / 255,) * 3
KEY_PRESS = (0x40 / 255,) * 3
BORDER = (0x66 / 255,) * 3
BLUE = (0x46 / 255, 0xbd / 255, 0xe7 / 255)
TEXT = (0x1e / 255,) * 3
DIM = (0x66 / 255,) * 3

OPTION_ROWS = [  # (key, label, y)
    ("next_to_cursor", "Next to input cursor", 104),
    ("move_pointer", "Automatically move pointer\non top of NumPad", 146),
    ("auto_hide", "Auto hide", 186),
]
OPTION_TIPS = {
    "next_to_cursor": "Open next to the text cursor. On Linux other programs don't "
                      "tell where it is: next to the pointer where you opened the "
                      "radial menu. Off: where the NumPad was last.",
    "move_pointer": "Move the pointer onto the NumPad when it opens. Wayland lets no "
                    "program move the pointer: there the NumPad opens under it.",
    "auto_hide": "Hide the NumPad once the pointer has left it.",
}


def prefs_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "3dxlinux", "numpad.json")


def load_prefs():
    p = dict(DEFAULTS)
    try:
        with open(prefs_path()) as f:
            p.update({k: v for k, v in json.load(f).items() if k in DEFAULTS})
    except (OSError, ValueError):
        pass
    p["scale"] = min(SCALE_MAX, max(SCALE_MIN, float(p.get("scale") or 1.0)))
    return p


def save_prefs(p):
    try:
        os.makedirs(os.path.dirname(prefs_path()), exist_ok=True)
        with open(prefs_path() + ".tmp", "w") as f:
            json.dump(p, f, indent=1)
        os.replace(prefs_path() + ".tmp", prefs_path())
    except OSError as e:
        print("3dxlinux-numpad: %s" % e, file=sys.stderr)


def pidfile():
    run = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(run, "3dxlinux-numpad-%d.pid" % os.getuid())


def close_running():
    """The NumPad already open: close it (shown again = hidden). True if so."""
    try:
        with open(pidfile()) as f:
            pid = int(f.read().strip())
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if b"3dxlinux-numpad" not in f.read():
                return False
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        return False


def tdxd_request(sock, line):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect(sock)
        s.sendall((line + "\n").encode())
        out = b""
        while True:
            b = s.recv(4096)
            if not b:
                break
            out += b
        return out.decode(errors="replace")
    except OSError as e:
        return "error: %s\n" % e
    finally:
        s.close()


def key_rects():
    """Each key's rectangle at 100 %: (x, y, w, h)."""
    cw = (GRID_W - 3 * GAP) / 4
    rh = (GRID_H - 4 * GAP) / 5
    out = []
    for label, keys, col, row, span in KEYS:
        out.append((GRID_X + col * (cw + GAP), GRID_Y + row * (rh + GAP),
                    span * cw + (span - 1) * GAP, rh))
    return out


def initial_place(prefs, at, monitor, size, x11):
    """Where the NumPad opens: (x, y, warp) - warp: move the pointer to its middle.
    @at: the pointer where the radial menu opened, or None; @monitor (x, y, w, h)."""
    w, h = size
    mx, my, mw, mh = monitor
    warp = False
    if at and prefs["next_to_cursor"]:
        x, y = at[0] + 24, at[1] - h // 3     # beside it, as 3DxNumpad beside the caret
        if x + w > mx + mw:
            x = at[0] - 24 - w
        if prefs["move_pointer"]:
            if x11:
                warp = True
            else:  # no pointer warping on Wayland: open under the pointer instead
                x, y = at[0] - w // 2, at[1] - h // 2
    elif at and prefs["move_pointer"] and not x11:
        x, y = at[0] - w // 2, at[1] - h // 2
    elif prefs["x"] is not None and prefs["y"] is not None:
        x, y = prefs["x"], prefs["y"]
        warp = bool(at) and prefs["move_pointer"] and x11
    else:
        x, y = mx + (mw - w) // 2, my + (mh - h) // 2
        warp = bool(at) and prefs["move_pointer"] and x11
    x = min(max(x, mx), mx + max(0, mw - w))
    y = min(max(y, my), my + max(0, mh - h))
    return int(x), int(y), warp


class NumPad(Gtk.Window):
    def __init__(self, sock, at=None, prefs=None, kind=None):
        disp = Gdk.Display.get_default()
        self.x11 = "X11" in type(disp).__name__
        if kind is None:
            kind = "x11" if self.x11 else (
                "layer" if GtkLayerShell and (not hasattr(GtkLayerShell, "is_supported") or
                                              GtkLayerShell.is_supported()) else "window")
        self.kind = kind
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.sock = sock
        self.prefs = prefs if prefs is not None else load_prefs()
        self.page = "keys"
        self.hover = None
        self.pressed = None
        self.drag = None          # ("move" | "resize", x, y, ...)
        self.opacity = 0.0
        self.hide_timer = None
        self.fading_out = False
        self.was_inside = False
        self.rects = key_rects()
        self.set_title("NumPad")
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_accept_focus(False)       # the keys go to the window with the text cursor
        self.set_focus_on_map(False)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK |
                        Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self.on_draw)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("enter-notify-event", self.on_enter)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("map-event", self.on_map)
        s = self.prefs["scale"]
        self.size = (int(W * s), int(H * s))
        self.set_size_request(*self.size)
        self.resize(*self.size)
        mon = self.monitor_geometry(disp)
        self.pos_x, self.pos_y, self.warp = initial_place(self.prefs, at, mon, self.size, self.x11)
        if self.kind == "layer":
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_namespace(self, "3dxlinux-numpad")
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
            if hasattr(GtkLayerShell, "set_keyboard_mode"):
                GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
            else:
                GtkLayerShell.set_keyboard_interactivity(self, False)
            self.apply_position()
        else:
            self.move(self.pos_x, self.pos_y)

    @staticmethod
    def monitor_geometry(disp):
        m = None
        try:
            seat = disp.get_default_seat()
            _s, x, y = seat.get_pointer().get_position()
            m = disp.get_monitor_at_point(x, y)
        except Exception:  # noqa: BLE001 - no pointer yet (Wayland)
            pass
        m = m or disp.get_primary_monitor() or disp.get_monitor(0)
        if not m:
            return (0, 0, 1920, 1080)
        g = m.get_geometry()
        if "X11" not in type(disp).__name__:  # a layer surface's margins: on its output
            return (0, 0, g.width, g.height)
        return (g.x, g.y, g.width, g.height)

    @property
    def scale(self):
        return self.size[0] / W

    def apply_position(self):
        if self.kind == "layer":
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, max(0, self.pos_x))
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, max(0, self.pos_y))
        else:
            self.move(self.pos_x, self.pos_y)

    # ---- showing and hiding (3DxNumpad's FadingWindow)
    def on_map(self, *_):
        if self.warp:
            disp = Gdk.Display.get_default()
            ptr = disp.get_default_seat().get_pointer()
            ptr.warp(self.get_screen(), self.pos_x + self.size[0] // 2,
                     self.pos_y + self.size[1] // 2)
        GLib.timeout_add(16, self.fade_in)
        return False

    def fade_in(self):
        if self.fading_out:
            return False
        self.opacity = min(1.0, self.opacity + 16 / FADE_MS)
        self.queue_draw()
        return self.opacity < 1.0

    def fade_out(self):
        self.hide_timer = None
        self.fading_out = True
        GLib.timeout_add(16, self.fade_step)
        return False

    def fade_step(self):
        if not self.fading_out:
            return False
        self.opacity = max(0.0, self.opacity - 16 / FADE_MS)
        self.queue_draw()
        if self.opacity <= 0:
            self.close_pad()
            return False
        return True

    def on_enter(self, _w, _ev):
        self.was_inside = True
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
            self.hide_timer = None
        if self.fading_out:  # back in time: it stays (StopFadeOut)
            self.fading_out = False
            GLib.timeout_add(16, self.fade_in)
        return False

    def on_leave(self, _w, ev):
        if ev.detail == Gdk.NotifyType.INFERIOR or self.drag:
            return False
        self.hover = None
        self.queue_draw()
        if self.prefs["auto_hide"] and self.was_inside and self.page == "keys" and \
                not self.hide_timer:
            self.hide_timer = GLib.timeout_add(AUTO_HIDE_DELAY_MS, self.fade_out)
        return False

    def close_pad(self):
        self.save()
        Gtk.main_quit()

    def save(self):
        self.prefs["x"], self.prefs["y"] = self.pos_x, self.pos_y
        self.prefs["scale"] = round(self.scale, 3)
        save_prefs(self.prefs)

    # ---- where things are (100 % coordinates)
    def hit(self, x, y):
        s = self.scale
        x, y = x / s, y / s
        if W - 30 <= x <= W - 6 and 6 <= y <= 30:
            return "close"
        if x >= W - 22 and y >= H - 22:
            return "grip"
        if self.page == "keys":
            for i, (kx, ky, kw, kh) in enumerate(self.rects):
                if kx <= x <= kx + kw and ky <= y <= ky + kh:
                    return i
            if 8 <= x <= 34 and H - 34 <= y <= H - 8:
                return "options"
        else:
            for key, _label, oy in OPTION_ROWS:
                if 14 <= x <= W - 14 and oy - 4 <= y <= oy + (30 if "\n" in _label else 16):
                    return ("opt", key)
            if 132 <= x <= 192 and H - 58 <= y <= H - 34:
                return "ok"
        if y <= TITLE_LINE_Y:
            return "title"
        return None

    def on_motion(self, _w, ev):
        if self.drag:
            kind, px, py = self.drag[:3]
            if kind == "move":
                self.pos_x += int(ev.x - px)
                self.pos_y += int(ev.y - py)
                self.apply_position()
                if self.kind != "layer":  # the window moved: the pointer's place in it didn't
                    self.drag = (kind, ev.x, ev.y)
            else:
                w0, h0 = self.drag[3], self.drag[4]
                # along the diagonal, keeping 3DxNumpad's shape
                d = ((ev.x - px) * W + (ev.y - py) * H) / (W * W + H * H)
                s = min(SCALE_MAX, max(SCALE_MIN, w0 / W + d))
                self.size = (int(W * s), int(H * s))
                self.set_size_request(*self.size)
                self.resize(*self.size)
                self.queue_draw()
            return True
        h = self.hit(ev.x, ev.y)
        if h != self.hover:
            self.hover = h
            tip = OPTION_TIPS.get(h[1]) if isinstance(h, tuple) else None
            self.set_tooltip_text(tip)
            if h == "grip" or h == "title":
                cur = "se-resize" if h == "grip" else "move"
                self.get_window().set_cursor(Gdk.Cursor.new_from_name(self.get_display(), cur))
            else:
                self.get_window().set_cursor(None)
            self.queue_draw()
        return True

    def on_press(self, _w, ev):
        if ev.button != 1:
            return True
        h = self.hit(ev.x, ev.y)
        if h == "title":
            if self.kind == "x11":
                self.begin_move_drag(ev.button, int(ev.x_root), int(ev.y_root), ev.time)
                GLib.timeout_add(300, self.remember_x11_position)
            else:
                self.drag = ("move", ev.x, ev.y)
            return True
        if h == "grip":
            self.drag = ("resize", ev.x, ev.y, self.size[0], self.size[1])
            return True
        self.pressed = h
        self.queue_draw()
        return True

    def remember_x11_position(self):
        self.pos_x, self.pos_y = self.get_position()
        return False

    def on_release(self, _w, ev):
        if ev.button != 1:
            return True
        if self.drag:
            self.drag = None
            self.save()
            return True
        h = self.hit(ev.x, ev.y)
        pressed, self.pressed = self.pressed, None
        self.queue_draw()
        if h != pressed:
            return True
        if isinstance(h, int):
            self.send(KEYS[h][1])
        elif h == "close":
            self.close_pad()
        elif h == "options":
            self.page = "options"
        elif h == "ok":
            self.page = "keys"
            self.save()
        elif isinstance(h, tuple):
            self.prefs[h[1]] = not self.prefs[h[1]]
        self.queue_draw()
        return True

    def send(self, keys):
        out = tdxd_request(self.sock, "keys " + keys)
        if not out.startswith("ok"):
            print("3dxlinux-numpad: " + out.strip(), file=sys.stderr)

    # ---- drawing (3DxNumpad's look, scaled)
    def on_draw(self, _w, cr):
        cr.set_operator(0)
        cr.paint()
        cr.set_operator(2)
        cr.push_group()
        cr.scale(self.scale, self.scale)
        self.draw_pad(cr)
        cr.pop_group_to_source()
        cr.paint_with_alpha(self.opacity)
        return False

    def text(self, cr, s, x, y, font, color, align=None, w=None):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription(font))
        layout.set_markup(s, -1) if s.startswith("<") else layout.set_text(s, -1)
        tw, th = layout.get_pixel_size()
        if align == "center":
            x -= tw / 2
            y -= th / 2
        cr.set_source_rgb(*color)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)
        return tw, th

    def draw_pad(self, cr):
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgb(1, 1, 1)
        cr.fill_preserve()
        cr.set_source_rgb(*BORDER)
        cr.set_line_width(1)
        cr.rectangle(0.5, 0.5, W - 1, H - 1)
        cr.stroke()
        # title: "Num" bold, "Pad" light
        self.text(cr, "<b>Num</b><span weight='light'>Pad</span>", 18, 16, "Sans 17", TEXT)
        # close
        cr.set_source_rgb(*(TEXT if self.hover == "close" else DIM))
        cr.set_line_width(1.3)
        cx, cy, r = W - 18, 18, 5
        cr.move_to(cx - r, cy - r)
        cr.line_to(cx + r, cy + r)
        cr.move_to(cx + r, cy - r)
        cr.line_to(cx - r, cy + r)
        cr.stroke()
        # the blue line, and a shadow under it
        cr.set_source_rgb(*BLUE)
        cr.rectangle(1, TITLE_LINE_Y, W - 2, 1.5)
        cr.fill()

        g = cairo.LinearGradient(0, TITLE_LINE_Y + 1.5, 0, TITLE_LINE_Y + 12)
        g.add_color_stop_rgb(0, 0.91, 0.91, 0.91)
        g.add_color_stop_rgb(1, 1, 1, 1)
        cr.set_source(g)
        cr.rectangle(1, TITLE_LINE_Y + 1.5, W - 2, 10.5)
        cr.fill()
        if self.page == "keys":
            self.draw_keys(cr)
        else:
            self.draw_options(cr)
        self.draw_grip(cr)

    def draw_keys(self, cr):
        for i, ((label, _k, *_), (x, y, w, h)) in enumerate(zip(KEYS, self.rects)):
            cr.rectangle(x, y, w, h)
            cr.set_source_rgb(*(KEY_PRESS if self.pressed == i and self.hover == i else
                                KEY_HOVER if self.hover == i else KEY_BG))
            cr.fill()
            self.text(cr, label, x + w / 2, y + h / 2, "Sans 10", (1, 1, 1), "center")
        self.draw_gear(cr, 21, H - 21, "options" == self.hover)

    def draw_gear(self, cr, cx, cy, hot):
        cr.save()
        cr.translate(cx, cy)
        cr.set_source_rgb(*(TEXT if hot else DIM))
        teeth, ro, ri = 8, 8.5, 6.2
        for k in range(teeth * 2):
            a0 = k * math.pi / teeth
            rad = ro if k % 2 == 0 else ri
            a1 = a0 + math.pi / teeth
            if k == 0:
                cr.move_to(rad * math.cos(a0), rad * math.sin(a0))
            cr.arc(0, 0, rad, a0, a1)
        cr.close_path()
        cr.new_sub_path()
        cr.arc_negative(0, 0, 3, 2 * math.pi, 0)
        cr.set_fill_rule(0)  # winding: the hole stays open
        cr.fill()
        cr.restore()

    def draw_grip(self, cr):
        cr.set_source_rgb(0.6, 0.6, 0.6)
        for dx, dy in ((0, 0), (-4, 0), (0, -4), (-8, 0), (-4, -4), (0, -8)):
            cr.rectangle(W - 7 + dx, H - 7 + dy, 1.6, 1.6)
        cr.fill()

    def draw_options(self, cr):
        self.text(cr, "<b>Initial position</b>", 18, 78, "Sans 9", TEXT)
        for key, label, y in OPTION_ROWS:
            self.draw_check(cr, 20, y + 1, self.prefs[key])
            self.text(cr, label, 40, y - 1, "Sans 9", TEXT)
            if key == "next_to_cursor":
                cr.set_source_rgb(0.82, 0.82, 0.82)
                cr.rectangle(18, 131, W - 36, 1)
                cr.fill()
        # OK
        hot = self.hover == "ok"
        cr.rectangle(132.5, H - 57.5, 60, 24)
        cr.set_source_rgb(*((0.9, 0.95, 0.99) if hot else (1, 1, 1)))
        cr.fill_preserve()
        cr.set_source_rgb(*((0.0, 0.47, 0.84) if hot else (0.68, 0.68, 0.68)))
        cr.set_line_width(1)
        cr.stroke()
        self.text(cr, "OK", 162.5, H - 45.5, "Sans 9", TEXT, "center")

    def draw_check(self, cr, x, y, on):
        cr.rectangle(x + 0.5, y + 0.5, 12, 12)
        cr.set_source_rgb(1, 1, 1)
        cr.fill_preserve()
        cr.set_source_rgb(0.2, 0.2, 0.2)
        cr.set_line_width(1)
        cr.stroke()
        if on:
            cr.set_source_rgb(0.1, 0.45, 0.85)
            cr.set_line_width(2)
            cr.move_to(x + 3, y + 6.5)
            cr.line_to(x + 5.5, y + 9.5)
            cr.line_to(x + 10, y + 3.5)
            cr.stroke()


def main():
    ap = argparse.ArgumentParser(description="3DxWare's Virtual NumPad")
    ap.add_argument("-s", "--socket", default="/run/3dxlinux.sock", help="3dxlinuxd control socket")
    ap.add_argument("--at", help="X,Y: the pointer where the radial menu opened")
    ap.add_argument("-V", "--version", action="version", version="3dxlinux-numpad " + APP_VERSION)
    args = ap.parse_args()
    if close_running():
        return 0
    try:
        with open(pidfile(), "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass
    at = None
    if args.at:
        try:
            at = tuple(int(float(v)) for v in args.at.split(",")[:2])
        except ValueError:
            pass
    pad = NumPad(args.socket or "/run/3dxlinux.sock", at)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: pad.close_pad() or False)
    pad.connect("destroy", lambda *_: Gtk.main_quit())
    pad.show_all()
    try:
        Gtk.main()
    finally:
        try:
            with open(pidfile()) as f:
                if f.read().strip() == str(os.getpid()):
                    os.unlink(pidfile())
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
