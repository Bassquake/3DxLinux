[Desktop Entry]
Type=Application
Name=LCD Manager (tdxd)
GenericName=3D Mouse LCD Manager
Comment=Programs, brightness and contrast for the SpacePilot PRO LCD
Exec=tdx-lcdmanager
TryExec=tdx-lcdmanager
Icon=input-mouse
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=3Dconnexion;SpacePilot;LCD;applet;
# opened from 3Dconnexion Settings (LCD Manager), not the menu; the entry stays
# for the window's taskbar icon (Wayland: the entry named like the app id)
NoDisplay=true
