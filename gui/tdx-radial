#!/usr/bin/env python3
"""tdx-radial: 3DxWare's radial menu (3DxPieMenus.exe) on Linux.

tdxd starts it when a button shows "Common Tools" (a CadMouse's radial-menu
button does by default); a second press closes it. The menu opens centred on
the pointer, as 3DxWare's: four slices round a close button, as in Base.xml's
Base_MenuRM1:

    top     Virtual NumPad  (Driver_Toggle_3DxNumPad: tdx-numpad, next to the menu)
    right   Redo            (Macro_Redo)
    bottom  Properties...   (Driver_ShowDriverGUI: 3Dconnexion Settings)
    left    Undo            (Macro_Undo)

Click a slice to run it. The centre button, a right click, Escape or a click
outside closes the menu; it fades as the pointer moves away (3DxPieMenus'
FnOpacity, down to 0.15). Wayland lets no window place itself at the
pointer, so the menu is drawn on a transparent full-screen window, where the
pointer's position is known. Undo and Redo are keystrokes, sent by tdxd
("keys" on its control socket) to the window that had the focus.
"""
import argparse
import math
import os
import signal
import socket
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango, PangoCairo  # noqa: E402
try:  # Wayland: an overlay layer, which the compositor shows without its own animation
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell  # noqa: E402
except (ValueError, ImportError):
    GtkLayerShell = None

APP_VERSION = "dev"

# Base_MenuRM1 (Common Tools), MenuButton_1..4 clockwise from the top:
# (label, icon, what it does)
COMMON_TOOLS = [
    ("Virtual\nNumPad", "Driver_Toggle_3DxNumPad.png", ("numpad", "tdx-numpad")),
    ("Redo", "Macro_Redo.png", ("keys", "KEY_LEFTCTRL+KEY_LEFTSHIFT+KEY_Z")),
    ("Properties...", "Driver_ShowDriverGUI.png", ("run", "tdx-settings")),
    ("Undo", "Macro_Undo.png", ("keys", "KEY_LEFTCTRL+KEY_Z")),
]
NOT_LINUX = "Not on Linux yet"

# sizes and colours measured on 3DxWare's menu (100 % scaling)
RADIUS = 105          # the disc
RADIUS_8 = 140        # with 8 sections: room for their names
CENTER_R = 20         # the close button
BACK = (0xf0 / 255,) * 3
HOVER = (0xc9 / 255,) * 3
PRESS = (0xb4 / 255,) * 3
LINE = (0x34 / 255,) * 3
CENTER = (0x2c / 255,) * 3
CENTER_HOVER = (0x48 / 255,) * 3
TEXT = (0x1e / 255,) * 3
TEXT_OFF = (0xa0 / 255,) * 3
ICON = 22
FONT = "Sans 8.5"
FADE_IN_MS = 150
SCALE_FROM = 0.3      # the menu grows from 30 % at the pointer as it fades in


def asset_dirs():
    env = os.environ.get("TDX_UI_ASSETS")
    here = os.path.dirname(os.path.realpath(__file__))
    return ([env] if env else []) + [
        os.path.expanduser("~/.local/share/tdxd/3dxware-ui"),
        os.path.join(here, "..", "share", "tdxd", "3dxware-ui"),
        "/usr/local/share/tdxd/3dxware-ui", "/usr/share/tdxd/3dxware-ui"]


def icon_path(name):
    for d in asset_dirs():
        p = os.path.join(d, "icons", name)
        if d and os.path.isfile(p):
            return p
    return None


def pidfile():
    run = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(run, "tdx-radial-%d.pid" % os.getuid())


def close_running():
    """A menu already open: close it (the button pressed again). True if so."""
    try:
        with open(pidfile()) as f:
            pid = int(f.read().strip())
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            if b"tdx-radial" not in f.read():
                return False
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        return False


def tdxd_request(sock, line):
    """One request on tdxd's control socket; its reply."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect(sock)
        s.sendall((line + "\n").encode())
        out = b""
        while True:
            b = s.recv(4096)
            if not b:
                break
            out += b
        return out.decode(errors="replace")
    except OSError as e:
        return "error: %s\n" % e
    finally:
        s.close()


def run_detached(argv):
    """Start @argv so that it outlives the menu. tdxd runs the menu as a systemd
    user unit, and systemd stops everything in it when the menu exits: so the
    program gets a unit of its own, the one tdxd uses for it (tdx-settings-menu
    as the MENU button's, tdx-numpad), so a second one isn't started. Without a
    user manager (WSL), a new session."""
    prog = argv[0]
    unit = "tdx-settings-menu" if prog == "tdx-settings" else prog
    try:
        r = subprocess.run(["systemd-run", "--user", "--unit=" + unit, "--collect", "--quiet"]
                           + argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=5)
        if r.returncode == 0:
            return
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        subprocess.Popen(argv, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    except OSError as e:
        print("tdx-radial: %s: %s" % (prog, e), file=sys.stderr)


def slice_at(dx, dy, n=4):
    """Which of @n slices (0 at the top, clockwise) a point off the centre is in."""
    a = math.degrees(math.atan2(dx, -dy)) % 360  # 0 = up, clockwise
    return int(((a + 180 / n) % 360) // (360 / n)) % n


def slice_action(value):
    """A user menu slice's value, as the Radial Menu Editor saves it (the
    picker's values): what tdx-radial does, or None (empty, not on Linux)."""
    v = (value or "").strip()
    if v.startswith("keys:"):
        chords = []
        for chord in v[5:].split(","):
            names = [n.strip().upper() for n in chord.split("+") if n.strip()]
            if names:
                chords.append("+".join(n if n.startswith("KEY_") else "KEY_" + n for n in names))
        return ("keys", ",".join(chords)) if chords else None
    if v == "action:settings":
        return ("run", "tdx-settings")
    if v == "action:numpad":
        return ("numpad", "tdx-numpad")
    if v.startswith("action:") and len(v) > 7:
        return ("action", v[7:])
    return None  # empty, or a mouse function (not from a menu yet)


def load_menu(sock, menu_id):
    """(name, items) of a user radial menu, from tdxd ("radial ID"), or None."""
    out = tdxd_request(sock, "radial " + menu_id)
    if out.startswith("error"):
        print("tdx-radial: " + out.strip(), file=sys.stderr)
        return None
    kv = dict(line.split("\t", 1) for line in out.splitlines() if "\t" in line)
    n = 8 if kv.get("layout", "4").strip() == "8" else 4
    items = []
    for i in range(1, n + 1):
        value = kv.get(str(i), "")
        label = kv.get("%d_label" % i, "")
        items.append((label.replace("\\n", "\n"), kv.get("%d_icon" % i, ""), slice_action(value)))
    return kv.get("name", menu_id), items


def menu_opacity(dist, radius=RADIUS):
    """3DxPieMenus' FnOpacity: full on the menu, fading beyond it to 0.15."""
    if dist <= radius:
        return 1.0
    return max(0.15, 1.0 - (dist - radius) / (radius * 1.5) * 0.85)


def window_kind():
    """How the menu's window is made, so that no compositor animates it in
    (KWin scales a new window in from its centre: from the middle of the
    screen, for a full-screen one): "layer" a Wayland overlay layer
    (gtk-layer-shell), "popup" an X11 override-redirect window, else
    "fullscreen" (Wayland without gtk-layer-shell)."""
    disp = Gdk.Display.get_default()
    if "X11" in type(disp).__name__:
        return "popup"
    if GtkLayerShell and (not hasattr(GtkLayerShell, "is_supported") or
                          GtkLayerShell.is_supported()):
        return "layer"
    return "fullscreen"


class RadialMenu(Gtk.Window):
    def __init__(self, sock, items=COMMON_TOOLS, kind=None):
        self.kind = kind or window_kind()
        super().__init__(type=Gtk.WindowType.POPUP if self.kind == "popup"
                         else Gtk.WindowType.TOPLEVEL)
        self.sock, self.items = sock, items
        self.radius = RADIUS if len(items) <= 4 else RADIUS_8
        self.anim = None
        self.origin = (0, 0)
        self.at = None           # the pointer when the menu opened
        self.pointer = None
        self.hover = None        # a slice 0..3, "close", or None
        self.pressed = None
        self.fade = 0.0
        self.done = None         # what to do once the window is gone
        self.icons = [self.load_icon(it[1]) for it in items]
        self.set_title("Common Tools")
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK |
                        Gdk.EventMask.KEY_PRESS_MASK)
        self.connect("draw", self.on_draw)
        self.connect("map-event", self.on_map)
        self.connect("enter-notify-event", self.on_motion)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("key-press-event", self.on_key)
        if self.kind == "layer":
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_namespace(self, "tdx-radial")
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
            for edge in (GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT,
                         GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM):
                GtkLayerShell.set_anchor(self, edge, True)
            GtkLayerShell.set_exclusive_zone(self, -1)
            if hasattr(GtkLayerShell, "set_keyboard_mode"):
                GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
            else:
                GtkLayerShell.set_keyboard_interactivity(self, True)
        elif self.kind == "popup":
            # the monitor the pointer is on, whole
            disp = Gdk.Display.get_default()
            _s, x, y = disp.get_default_seat().get_pointer().get_position()
            g = (disp.get_monitor_at_point(x, y) or disp.get_monitor(0)).get_geometry()
            self.move(g.x, g.y)
            self.origin = (g.x, g.y)  # the pointer in screen coordinates, for tdx-numpad
            self.set_default_size(g.width, g.height)
            self.set_size_request(g.width, g.height)
        else:
            self.fullscreen()

    @staticmethod
    def load_icon(name):
        p = icon_path(name)
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_size(p, ICON, ICON) if p else None
        except GLib.Error:
            return None

    # ---- where the pointer is
    def on_map(self, *_):
        # X11 knows the pointer now; Wayland tells it when it enters the window
        disp = Gdk.Display.get_default()
        if self.kind == "popup":
            seat = disp.get_default_seat()
            # an override-redirect window gets no focus: take the keyboard and
            # pointer (Escape, and clicks outside the menu)
            seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None,
                      None)
            _w, x, y, _m = self.get_window().get_device_position(seat.get_pointer())
            if x or y:  # (0, 0): not on this display yet (WSLg); wait for it to enter
                self.place(x, y)
        return False

    def place(self, x, y):
        """The menu opens here: it grows from the pointer as it fades in."""
        self.at = (x, y)
        if self.anim is None:
            self.anim = GLib.timeout_add(16, self.fade_in)
        self.queue_draw()

    @property
    def center(self):
        """The menu's centre: where the pointer was, the whole disc on the screen."""
        if self.at is None:
            return None
        w, h = self.get_allocated_width(), self.get_allocated_height()
        m = self.radius + 2
        return (min(max(self.at[0], m), max(m, w - m)), min(max(self.at[1], m), max(m, h - m)))

    def fade_in(self):
        self.fade = min(1.0, self.fade + 16 / FADE_IN_MS)
        self.queue_draw()
        return self.fade < 1.0

    def hit(self, x, y):
        if self.center is None:
            return None
        dx, dy = x - self.center[0], y - self.center[1]
        d = math.hypot(dx, dy)
        if d <= CENTER_R:
            return "close"
        if d <= self.radius:
            return slice_at(dx, dy, len(self.items))
        return None

    def enabled(self, i):
        return isinstance(i, int) and self.items[i][2] is not None

    def on_motion(self, _w, ev):
        if self.center is None:
            self.place(ev.x, ev.y)
        self.pointer = (ev.x, ev.y)
        h = self.hit(ev.x, ev.y)
        if h != self.hover:
            self.hover = h
            self.set_tooltip_text(NOT_LINUX if isinstance(h, int) and not self.enabled(h)
                                  else None)
        self.queue_draw()
        return False

    def on_press(self, _w, ev):
        if self.center is None:
            self.place(ev.x, ev.y)
            return True
        if ev.button == 1:
            self.pressed = self.hit(ev.x, ev.y)
            self.queue_draw()
        return True

    def on_release(self, _w, ev):
        if ev.button == 3:
            return self.finish(None) or True
        if ev.button != 1 or self.center is None:
            return True
        h = self.hit(ev.x, ev.y)
        pressed, self.pressed = self.pressed, None
        if isinstance(h, int):
            if self.enabled(h) and h == pressed:
                self.finish(self.items[h][2])
            self.queue_draw()  # a greyed slice: stays open
            return True
        self.finish(None)  # the close button, or outside the menu
        return True

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.finish(None)
        return True

    def finish(self, action):
        self.done = action
        self.hide()
        # the window the user was in gets the focus back first
        GLib.timeout_add(150, self.run_and_quit)

    def run_and_quit(self):
        a = self.done
        if a and a[0] == "keys":
            for chord in a[1].split(","):  # a sequence: one chord after another
                out = tdxd_request(self.sock, "keys " + chord)
                if not out.startswith("ok"):
                    print("tdx-radial: " + out.strip(), file=sys.stderr)
        elif a and a[0] == "action":  # a driver function, done by tdxd
            out = tdxd_request(self.sock, "action " + a[1])
            if not out.startswith("ok"):
                print("tdx-radial: " + out.strip(), file=sys.stderr)
        elif a and a[0] == "run":
            run_detached([a[1]])
        elif a and a[0] == "numpad":  # next to where the menu opened
            x, y = self.at if self.at else (0, 0)
            run_detached([a[1], "-s", self.sock, "--at",
                          "%d,%d" % (x + self.origin[0], y + self.origin[1])])
        Gtk.main_quit()
        return False

    # ---- drawing
    def on_draw(self, _w, cr):
        cr.set_operator(0)  # CLEAR: the rest of the screen stays as it is
        cr.paint()
        cr.set_operator(2)  # OVER
        if self.center is None:
            return False
        cx, cy = self.center
        alpha = self.fade
        if self.pointer:
            alpha *= menu_opacity(math.hypot(self.pointer[0] - cx, self.pointer[1] - cy), self.radius)
        cr.push_group()
        # growing from the pointer while it fades in (ease out)
        t = 1 - (1 - min(self.fade, 1.0)) ** 3
        grow = SCALE_FROM + (1 - SCALE_FROM) * t
        px, py = self.at
        cr.translate(px, py)
        cr.scale(grow, grow)
        cr.translate(-px, -py)
        self.draw_menu(cr, cx, cy)
        cr.pop_group_to_source()
        cr.paint_with_alpha(alpha)
        return False

    def draw_menu(self, cr, cx, cy):
        cr.arc(cx, cy, self.radius, 0, 2 * math.pi)
        cr.set_source_rgb(*BACK)
        cr.fill()
        # the slice under the pointer, darker while pressed
        n = len(self.items)
        if isinstance(self.hover, int) and self.enabled(self.hover):
            a0 = math.radians(-90 - 180 / n + 360 / n * self.hover)
            cr.move_to(cx, cy)
            cr.arc(cx, cy, self.radius, a0, a0 + 2 * math.pi / n)
            cr.close_path()
            cr.set_source_rgb(*(PRESS if self.pressed == self.hover else HOVER))
            cr.fill()
        # the dividers, between the slices (4: on the diagonals)
        cr.set_source_rgb(*LINE)
        cr.set_line_width(2)
        for k in range(n):
            a = math.radians(-90 + 180 / n + 360 / n * k)
            cr.move_to(cx + CENTER_R * math.cos(a), cy + CENTER_R * math.sin(a))
            cr.line_to(cx + self.radius * math.cos(a), cy + self.radius * math.sin(a))
        cr.stroke()
        for i, (label, _icon, action) in enumerate(self.items):
            self.draw_item(cr, cx, cy, i, label, action is not None)
        # the close button
        cr.arc(cx, cy, CENTER_R, 0, 2 * math.pi)
        cr.set_source_rgb(*(CENTER_HOVER if self.hover == "close" else CENTER))
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(2)
        s = 6
        cr.move_to(cx - s, cy - s)
        cr.line_to(cx + s, cy + s)
        cr.move_to(cx + s, cy - s)
        cr.line_to(cx - s, cy + s)
        cr.stroke()

    def draw_item(self, cr, cx, cy, i, label, on):
        n = len(self.items)
        a = math.radians(-90 + 360 / n * i)
        dist = self.radius * (0.6 if n <= 4 else 0.66)
        x, y = cx + dist * math.cos(a), cy + dist * math.sin(a)
        layout = PangoCairo.create_layout(cr)
        layout.set_text(label, -1)
        layout.set_alignment(Pango.Alignment.CENTER)
        bw = 86 if n <= 4 else 74  # long names wrap, centred in this width
        layout.set_width(int(bw * Pango.SCALE))
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_font_description(Pango.FontDescription(FONT))
        _tw, th = layout.get_pixel_size()
        tw = bw
        icon = self.icons[i]
        ih = ICON + 4 if icon else 0
        top = y - (ih + th) / 2
        if icon:
            Gdk.cairo_set_source_pixbuf(cr, icon, x - ICON / 2, top)
            cr.paint_with_alpha(1.0 if on else 0.35)
        cr.set_source_rgb(*(TEXT if on else TEXT_OFF))
        cr.move_to(x - tw / 2, top + ih)
        PangoCairo.show_layout(cr, layout)


def main():
    ap = argparse.ArgumentParser(description="3DxWare's Common Tools radial menu")
    ap.add_argument("-s", "--socket", default="/run/tdxd.sock", help="tdxd control socket")
    ap.add_argument("--menu", help="a radial menu of your own (its ID), instead of Common Tools")
    ap.add_argument("-V", "--version", action="version", version="tdx-radial " + APP_VERSION)
    args = ap.parse_args()
    if close_running():
        return 0
    try:
        with open(pidfile(), "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    sock = args.socket or "/run/tdxd.sock"
    items = COMMON_TOOLS
    title = "Common Tools"
    if args.menu:
        menu = load_menu(sock, args.menu)
        if not menu:
            return 1
        title, items = menu
    win = RadialMenu(sock, items)
    win.set_title(title)
    win.connect("destroy", lambda *_: Gtk.main_quit())
    win.show_all()
    try:
        Gtk.main()
    finally:
        try:
            with open(pidfile()) as f:
                if f.read().strip() == str(os.getpid()):
                    os.unlink(pidfile())
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
