def lcdcfg_path():
    return os.environ.get("DXLINUX_LCDCFG", "/run/3dxlinux/LCDCfg.xml")


ICON_SIZES = ("32x32", "48x48", "64x64", "128x128", "256x256", "scalable", "24x24", "16x16")
ICON_EXTS = (".png", ".svg", ".xpm")


def data_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    out = [home] + [d for d in dirs.split(":") if d]
    # Flatpak and Snap applications' menu entries and icons, which a user service
    # (3dxlinux-lcdmgr) may not have in its XDG_DATA_DIRS
    for d in (os.path.join(home, "flatpak", "exports", "share"), "/var/lib/flatpak/exports/share",
              "/var/lib/snapd/desktop"):
        if d not in out:
            out.append(d)
    return out


def desktop_names(fname, text):
    """The program names a .desktop entry stands for: its file name and the last
    part of a reverse-DNS one (org.freecad.FreeCAD -> FreeCAD), the command it
    runs (for "flatpak run ... --command=FreeCAD org.freecad.FreeCAD" that and
    the app id), and StartupWMClass."""
    stem = fname[:-8]
    names = {stem, stem.rsplit(".", 1)[-1]}
    m = re.search(r"(?m)^Exec=(.+)$", text)
    if m:
        words = m.group(1).split()
        names.add(os.path.basename(words[0].strip('"')))
        if os.path.basename(words[0].strip('"')) == "flatpak":
            for w in words[1:]:
                if w.startswith("--command="):
                    names.add(os.path.basename(w[10:]))
                elif not w.startswith(("-", "%", "@@")) and w != "run" and "." in w:
                    names.update((w, w.rsplit(".", 1)[-1]))  # the app id
    for key in ("StartupWMClass", "X-Flatpak"):
        m = re.search(r"(?m)^%s=(.+)$" % key, text)
        if m:
            v = m.group(1).strip()
            names.update((v, v.rsplit(".", 1)[-1]))
    return {n.lower() for n in names if n}


def desktop_icon_names(name, exe):
    """Icon= of the .desktop entries for this program (matched on the entry's
    file name or its Exec command), as the desktop's own launcher shows it."""
    want = {n.lower() for n in (name, os.path.basename(exe or "")) if n}
    names = []
    for d in data_dirs():
        apps = os.path.join(d, "applications")
        try:
            files = sorted(f for f in os.listdir(apps) if f.endswith(".desktop"))
        except OSError:
            continue
        for f in files:
            try:
                with open(os.path.join(apps, f), encoding="utf-8", errors="replace") as fh:
                    text = fh.read(16384)
            except OSError:
                continue
            m_icon = re.search(r"(?m)^Icon=(.+)$", text)
            if m_icon and desktop_names(f, text) & want:
                names.append(m_icon.group(1).strip())
    return names


def find_icon(icon):
    """An icon name (or absolute path) -> a PNG / SVG / XPM file."""
    if os.path.isabs(icon):
        return icon if os.path.isfile(icon) else None
    for d in data_dirs():
        for size in ICON_SIZES:
            for ext in ICON_EXTS:
                p = os.path.join(d, "icons", "hicolor", size, "apps", icon + ext)
                if os.path.isfile(p):
                    return p
    for d in data_dirs():
        for ext in ICON_EXTS:
            p = os.path.join(d, "pixmaps", icon + ext)
            if os.path.isfile(p):
                return p
    return None


_icon_cache = {}


def app_icon(name, exe):
    """An icon file for the focused application: its .desktop entry's icon,
    else one named like the program (freedesktop locations). Cached per
    program - LCDCfg.xml changes on every button press."""
    if (name, exe) not in _icon_cache:
        _icon_cache[(name, exe)] = _app_icon(name, exe)
    return _icon_cache[(name, exe)]


def _app_icon(name, exe):
    names = desktop_icon_names(name, exe)
    for n in filter(None, [name, os.path.basename(exe or "")]):
        names += [n, n.lower()]
    for n in names:
        p = find_icon(n)
        if p:
            return p
    return None


def load_icon(path, size=32):
    """The icon as a size x size cairo surface (SVGs rendered at that size)."""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GdkPixbuf, GLib
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
    except GLib.Error:
        return None
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, pb.get_width(), pb.get_height())
    cr = cairo.Context(surf)
    Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
    cr.paint()
    return surf


class FunctionKeys(la.Applet):
    NAME = "Function Keys"
    ART = "functionkeys"
    CONFIG = "functionkeys.json"
    CONFIG_DEFAULTS = {"page": 0}
    FPS = 5

    def __init__(self):
        super().__init__()
        self.page = int(self.cfg.get("page", 0)) % 3
        self.info = {"buttons": {}, "app": "", "image": "", "pressed": "", "slider": None,
                     "rotation": True, "panzoom": True, "dominant": False}
        self.mtime = 0
        self.icon_path = None
        self.icon = None

    def tick(self, now):
        try:
            m = os.stat(lcdcfg_path()).st_mtime
        except OSError:
            return False
        if m == self.mtime:
            return False
        self.mtime = m
        try:
            root = ET.parse(lcdcfg_path()).getroot()
        except (ET.ParseError, OSError):
            return False
        dev = root.find("Device")
        if dev is None:
            return False
        tf = lambda p: (dev.findtext(p) or "").strip().lower() == "true"  # noqa: E731
        sl = (dev.findtext("InfoLine/Slider") or "").strip()
        self.info = {
            "buttons": {b.findtext("V3DK"): b.findtext("Text") or "" for b in dev.findall("Button")},
            "app": dev.findtext("InfoLine/ApplicationName") or dev.findtext("InfoLine/Text") or "",
            "image": dev.findtext("InfoLine/Image/Source") or "",
            "pressed": dev.findtext("InfoLine/ButtonPressed") or "",
            "slider": int(sl) if sl.isdigit() else None,
            "rotation": tf("Filters/Rotation"), "panzoom": tf("Filters/PanZoom"),
            "dominant": tf("Filters/Dominant"),
        }
        p = app_icon(self.info["app"], self.info["image"])
        if p != self.icon_path:
            self.icon_path = p
            self.icon = load_icon(p) if p else None
        return True

    def on_buttons(self, pressed, held):
        if pressed & la.RIGHT and self.page < 2:
            self.page += 1
        elif pressed & la.LEFT and self.page > 0:
            self.page -= 1
        else:
            return
        self.cfg["page"] = self.page
        try:
            self.save_config()
        except OSError:
            pass

    def label(self, key):
        b = self.info["buttons"]
        if key == "SPEED":
            mi, pl = b.get("V3DK_MINUS", ""), b.get("V3DK_PLUS", "")
            if mi == "Decrease Speed" and pl == "Increase Speed":
                return "Speed"
            return "%s / %s" % (mi, pl) if mi or pl else ""
        return b.get(key, "")

    def draw_header(self, cr):
        x0 = 56
        if self.icon:  # application icon in the 48-px slot, scaled to fit
            s = min(32.0 / self.icon.get_width(), 32.0 / self.icon.get_height())
            cr.save()
            cr.translate(24 - self.icon.get_width() * s / 2, 18 - self.icon.get_height() * s / 2)
            cr.scale(s, s)
            cr.set_source_surface(self.icon, 0, 0)
            cr.paint()
            cr.restore()
        elif self.art.paint(cr, "bitmap_113", 0, 0):  # the applet's own icon (48x35)
            pass
        # motion filter status (green on / red off). Windows shows, left to right,
        # Rotation, Pan/Zoom, Dominant; drawn here from the right edge leftwards.
        # The applet's icons: 114/115 Dominant (cap, one left-right arrow),
        # 116/117 Pan/Zoom (cap, X/Y/Z arrows), 118/119 Rotation (turning arrow).
        x = la.W - 2
        for on, off_name, on_name in ((self.info["dominant"], "bitmap_115", "bitmap_114"),
                                      (self.info["panzoom"], "bitmap_117", "bitmap_116"),
                                      (self.info["rotation"], "bitmap_119", "bitmap_118")):
            s = self.art.get(on_name if on else off_name)
            if s:
                x -= s.get_width()
                cr.set_source_surface(s, x, 0)
                cr.paint()
        la.text(cr, x0, 0, self.info["app"] or "SpacePilot PRO", 15, (0.92, 0.92, 0.92),
                bold=True, width=max(40, x - x0 - 4), valign_h=36)

    def draw(self, cr):
        bg, items = PAGES[self.page]
        if not self.art.paint(cr, bg):
            cr.set_source_rgb(0.1, 0.1, 0.1)
            cr.paint()
            la.default_header(cr, "")
        self.draw_header(cr)
        for key, x, base, col, w in items:
            if not self.art.dir:
                la.text(cr, x - 22, base, FALLBACK_KEYS.get(key, ""), 12, col, bold=True,
                        baseline=True)
            # base = the printed glyph's bottom pixel row; a Pango baseline sits
            # just below the glyphs, and on the device +2 looks level with them
            la.text(cr, x, base + 2, self.label(key), 16, col, width=w, baseline=True)
        if not self.art.dir:
            la.text(cr, 15, 218, "Long press buttons" if self.page < 2 else "", 12, BLUE)
            la.text(cr, 280, 218, ["▶", "◀ ▶", "◀"][self.page], 12, GREY)
        self.draw_popup(cr)

    def draw_popup(self, cr):
        sl, pressed = self.info["slider"], self.info["pressed"]
        if sl is not None:  # "Speed" pop-up with the segmented bar
            box = self.art.get("bitmap_129")
            bx, by = (la.W - 251) // 2, 58
            if box:
                cr.set_source_surface(box, bx, by)
                cr.paint()
            else:
                cr.set_source_rgba(0.08, 0.08, 0.08, 0.95)
                la.rounded(cr, bx, by, 251, 131, 8)
                cr.fill()
                la.text(cr, bx, by + 16, "Speed", 14, WHITE, width=251, align="center")
            frac = max(0.0, min(1.0, (math.log10(max(sl, 1) / 100.0) + 1) / 2))
            bar = self.art.get("bitmap_130")
            if bar:
                cr.save()
                cr.rectangle(bx + 33, by + 75, 184 * frac, 11)
                cr.clip()
                cr.set_source_surface(bar, bx + 33, by + 75)
                cr.paint()
                cr.restore()
            else:
                cr.set_source_rgb(*BLUE)
                cr.rectangle(bx + 33, by + 75, 184 * frac, 11)
                cr.fill()
        elif pressed:
            box = self.art.get("bitmap_162")
            bx, by = (la.W - 256) // 2, 70
            if box:
                cr.set_source_surface(box, bx, by)
                cr.paint()
            else:
                cr.set_source_rgba(0.08, 0.08, 0.08, 0.95)
                la.rounded(cr, bx, by, 256, 100, 8)
                cr.fill()
            la.text(cr, bx + 10, by, pressed, 18, WHITE, bold=True, width=236, align="center",
                    valign_h=100)


if __name__ == "__main__":
    sys.exit(la.main(FunctionKeys))
