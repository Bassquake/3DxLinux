<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="io.github.bassquake.3dxlinux.settings.write">
    <description>Save 3D mouse settings</description>
    <message>Authentication is required to change the 3DxLinux settings in /etc</message>
    <icon_name>input-mouse</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/3dxlinux/3dxlinux-settings-helper</annotate>
  </action>
</policyconfig>
