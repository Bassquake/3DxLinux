def asset_dirs():
    env = os.environ.get("TDX_UI_ASSETS")
    here = os.path.dirname(os.path.realpath(__file__))
    return ([env] if env else []) + [
        os.path.expanduser("~/.local/share/3dxlinux/3dxware-ui"),
        os.path.join(here, "..", "share", "3dxlinux", "3dxware-ui"),
        "/usr/local/share/3dxlinux/3dxware-ui", "/usr/share/3dxlinux/3dxware-ui"]


class Art:
    def __init__(self, path=None, disabled=False):
        self.dir = None
        if not disabled:
            for d in ([path] if path else asset_dirs()):
                if d and os.path.isdir(os.path.join(d, "lcdmon")):
                    self.dir = os.path.join(os.path.realpath(d), "lcdmon")
                    break
        self.cache = {}

    def path(self, name):
        if not self.dir:
            return None
        p = os.path.join(self.dir, "IDR_%s.png" % name)
        return p if os.path.isfile(p) else None

    def surface(self, name):
        if name not in self.cache:
            p = self.path(name)
            try:
                self.cache[name] = cairo.ImageSurface.create_from_png(p) if p else None
            except (cairo.Error, OSError):
                self.cache[name] = None
        return self.cache[name]

    def image(self, name, size=None):
        p = self.path(name)
        if not p:
            return None
        pb = (GdkPixbuf.Pixbuf.new_from_file_at_scale(p, size, size, True) if size
              else GdkPixbuf.Pixbuf.new_from_file(p))
        return Gtk.Image.new_from_pixbuf(pb)


def window_icon_files(folder, prefix):
    """<folder>/<prefix>_<size>.png, smallest first (extract_3dxware_ui.py
    takes them from the Windows program's icon)."""
    try:
        names = os.listdir(folder) if folder else []
    except OSError:
        return []
    found = []
    for n in names:
        m = re.match(re.escape(prefix) + r"_(\d+)\.png$", n)
        if m:
            found.append((int(m.group(1)), os.path.join(folder, n)))
    return [p for _s, p in sorted(found)]


def set_window_icons(files, theme_name):
    """Taskbar / title-bar icon for every window of this program, like the
    Windows version's; the generic input-mouse icon without the artwork."""
    from gi.repository import GdkPixbuf
    pbs = []
    for p in files:
        try:
            pbs.append(GdkPixbuf.Pixbuf.new_from_file(p))
        except GLib.Error:
            pass
    if pbs:
        Gtk.Window.set_default_icon_list(pbs)
    else:
        theme = Gtk.IconTheme.get_default()
        Gtk.Window.set_default_icon_name(theme_name if theme and theme.has_icon(theme_name)
                                         else "input-mouse")


ART = Art()


def paint(cr, name, x, y, w=None, h=None):
    """Paint an artwork image at x,y (stretched to w x h if given). False if missing."""
    s = ART.surface(name)
    if not s:
        return False
    cr.save()
    cr.translate(x, y)
    if w or h:
        cr.scale((w or s.get_width()) / s.get_width(), (h or s.get_height()) / s.get_height())
    cr.set_source_surface(s, 0, 0)
    cr.get_source().set_filter(cairo.FILTER_GOOD)
    cr.paint()
    cr.restore()
    return True


def paint_tiled(cr, name, x, y, w, h):
    """Repeat an image over x,y,w,h at 1:1 (no scaling, so no blended,
    half-transparent edge columns where it meets its neighbours)."""
    s = ART.surface(name)
    if not s:
        return False
    pat = cairo.SurfacePattern(s)
    pat.set_extend(cairo.EXTEND_REPEAT)
    pat.set_filter(cairo.FILTER_NEAREST)
    m = cairo.Matrix()
    m.translate(-x, -y)
    pat.set_matrix(m)
    cr.save()
    cr.rectangle(x, y, w, h)
    cr.clip()
    cr.set_source(pat)
    cr.paint()
    cr.restore()
    return True


def three_slice(cr, prefix, x, y, w):
    """Pane header: L / repeated MID / R images (LCDMon tiles the middle)."""
    l, m, r = (ART.surface(prefix + s) for s in ("_L", "_MID", "_R"))
    if not (l and m and r):
        return False
    x, y, w = int(round(x)), int(round(y)), int(round(w))
    paint_tiled(cr, prefix + "_MID", x + l.get_width(), y, w - l.get_width() - r.get_width(),
                m.get_height())
    paint_tiled(cr, prefix + "_L", x, y, l.get_width(), l.get_height())
    paint_tiled(cr, prefix + "_R", x + w - r.get_width(), y, r.get_width(), r.get_height())
    return True


def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


