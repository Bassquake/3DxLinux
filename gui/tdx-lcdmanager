class LcdManager:
    def __init__(self, args):
        self.args = args
        self.sock = args.socket or tdxlcd.socket_path()
        self.st = None
        self.page = "device"
        self.updating = False
        self.lines = []      # group boxes to draw: (x, y, w, h)
        self.panes = []      # pane headers: (y, title, expanded)
        self.section = None  # (image, title) for section pages
        self.config_open, self.running_open = True, False
        self.sel_prog = 0
        self.refresh_status()

        self.root = Gtk.Overlay()
        self.root.get_style_context().add_class("lm")
        self.root.set_size_request(W, H)
        self.bg = Gtk.DrawingArea()
        self.bg.set_size_request(W, H)
        self.bg.connect("draw", self.draw_bg)
        self.root.add(self.bg)
        self.fix = Gtk.Fixed()
        self.root.add_overlay(self.fix)
        self.root.set_overlay_pass_through(self.fix, False)
        self.build()

    # ---- data
    def refresh_status(self):
        try:
            self.st = tdxlcd.status(self.sock)
        except (OSError, ValueError):
            self.st = None

    def admin(self, cmd):
        try:
            r = tdxlcd.admin(cmd, self.sock)
        except OSError as e:
            r = "error: %s" % e
        self.refresh_status()
        return r

    def setting(self, key, default=0):
        return (self.st or {}).get("settings", {}).get(key, default)

    def general(self, key, default=0):
        return (self.st or {}).get("general", {}).get(key, default)

    # ---- background
    def draw_bg(self, w, cr):
        # sidebar
        g = cairo.LinearGradient(0, 0, 0, H)
        g.add_color_stop_rgb(0, 0.62, 0.62, 0.62)
        g.add_color_stop_rgb(0.30, 0.42, 0.42, 0.42)
        g.add_color_stop_rgb(1, 0.24, 0.24, 0.24)
        cr.set_source(g)
        cr.rectangle(0, 0, SIDE_W, H)
        cr.fill()
        cr.set_source_rgb(0.16, 0.16, 0.16)
        cr.rectangle(SIDE_W - 1, 0, 1, H)
        cr.fill()
        # content background
        g = cairo.LinearGradient(0, 0, 0, 40)
        g.add_color_stop_rgb(0, 0.47, 0.47, 0.47)
        g.add_color_stop_rgb(1, 0.70, 0.70, 0.70)
        cr.set_source(g)
        cr.rectangle(SIDE_W, 0, W - SIDE_W, H)
        cr.fill()
        # sidebar selection glow behind the current icon
        for i, (key, icon, _l) in enumerate(PAGES):
            if key == self.page and not ART.surface(icon + "_ON"):
                cr.set_source_rgba(1.0, 0.75, 0.2, 0.35)
                cr.arc(SIDE_W / 2, 45 + i * 114 + 32, 36, 0, 2 * math.pi)
                cr.fill()
        x, y, pw, ph = PANEL
        if self.section:
            self.draw_panel(cr, x, y, pw, ph)
            self.draw_section(cr, *self.section)
        for (py, title, expanded, height) in self.panes:
            self.draw_pane(cr, x, py, pw, expanded, height)
        for (bx, by, bw, bh) in self.lines:
            cr.set_source_rgb(0.86, 0.86, 0.86)
            cr.set_line_width(1)
            rounded(cr, bx + 0.5, by + 0.5, bw, bh, 3)
            cr.stroke()

    def draw_shadow(self, cr, x, y, w, h):
        for i in range(6, 0, -1):
            cr.set_source_rgba(0, 0, 0, 0.035 * (7 - i))
            cr.rectangle(x - i + 3, y - i + 4, w + 2 * i - 3, h + 2 * i - 3)
            cr.fill()

    def draw_panel(self, cr, x, y, w, h):
        self.draw_shadow(cr, x, y, w, h)
        cr.set_source_rgb(1, 1, 1)
        cr.rectangle(x, y, w, h)
        cr.fill()

    def draw_section(self, cr, icon, title):
        x, y, w, _h = PANEL
        tex = ART.surface("TEXTUREBACKGROUND")
        cr.save()
        cr.rectangle(x, y, w, 380)
        cr.clip()
        if tex:
            paint(cr, "TEXTUREBACKGROUND", x, y, w, 380)
        else:
            g = cairo.LinearGradient(x, y, x + w, y + 380)
            g.add_color_stop_rgb(0, 0.55, 0.82, 0.86)
            g.add_color_stop_rgb(1, 0.80, 0.93, 0.95)
            cr.set_source(g)
            cr.paint()
        fade = cairo.LinearGradient(0, y + 250, 0, y + 380)
        fade.add_color_stop_rgba(0, 1, 1, 1, 0)
        fade.add_color_stop_rgba(1, 1, 1, 1, 1)
        cr.set_source(fade)
        cr.paint()
        cr.restore()
        if not paint(cr, icon, x + 225, y + 99):
            cr.set_source_rgba(1, 1, 1, 0.6)
            cr.arc(x + 300, y + 174, 70, 0, 2 * math.pi)
            cr.fill()

    # LCDMon's pane pieces carry their own shadow margins: the header's solid
    # part starts 8 px right (after a 4-px shadow ramp) and 4 px down in IDR_PANE_HEADER_*_L
    # and ends 7 px before the right edge of *_R; the side shadows (IDR_PANE_SHADOW_L/R, 7 px)
    # sit just outside the panel and the bottom corners (BL/BR, 15 px) meet them.
    HEADER_H = 23

    def draw_pane(self, cr, x, y, w, expanded, height):
        hh = self.HEADER_H
        if expanded:
            cr.set_source_rgb(1, 1, 1)
            cr.rectangle(x, y + hh, w, height - hh)
            cr.fill()
            self.pane_shadow(cr, x, y + hh, w, height - hh)
            if not three_slice(cr, "PANE_HEADER_EXPANDED", x - 8, y - 4, w + 15):
                g = cairo.LinearGradient(0, y, 0, y + hh)
                g.add_color_stop_rgb(0, 0.30, 0.66, 0.74)
                g.add_color_stop_rgb(1, *TEAL)
                cr.set_source(g)
                rounded(cr, x, y, w, hh + 4, 4)
                cr.fill()
        else:
            if not three_slice(cr, "PANE_HEADER_COLLAPSED", x - 8, y - 4, w + 15):
                self.draw_shadow(cr, x, y, w, hh)
                g = cairo.LinearGradient(0, y, 0, y + hh)
                g.add_color_stop_rgb(0, 0.30, 0.66, 0.74)
                g.add_color_stop_rgb(1, *TEAL)
                cr.set_source(g)
                rounded(cr, x, y, w, hh, 4)
                cr.fill()

    def pane_shadow(self, cr, x, y, w, h):
        """Shadow around a pane body (below its header) from LCDMon's pieces."""
        sl, sr = ART.surface("PANE_SHADOW_L"), ART.surface("PANE_SHADOW_R")
        if not (sl and sr and ART.surface("PANE_SHADOW_BOTTOM")):
            self.draw_shadow(cr, x, y - 4, w, h + 4)
            cr.set_source_rgb(1, 1, 1)
            cr.rectangle(x, y, w, h)
            cr.fill()
            return
        for name, sx in (("PANE_SHADOW_L", x - 7), ("PANE_SHADOW_R", x + w)):
            s = ART.surface(name)
            cr.save()
            cr.rectangle(sx, y, 7, h)
            cr.clip()
            for yy in range(y, y + h, s.get_height()):
                cr.set_source_surface(s, sx, yy)
                cr.paint()
            cr.restore()
        paint_tiled(cr, "PANE_SHADOW_BOTTOM", x + 8, y + h, w - 16, 10)
        paint_tiled(cr, "PANE_SHADOW_BL", x - 7, y + h, 15, 10)
        paint_tiled(cr, "PANE_SHADOW_BR", x + w - 8, y + h, 15, 10)

    # ---- layout
    def put(self, widget, x, y):
        self.fix.put(widget, int(x), int(y))
        return widget

    def group(self, title, x, y, w, h):
        self.lines.append((x, y, w, h))
        self.put(lab(title, "group"), x + 8, y - 8)

    def clear(self):
        for c in self.fix.get_children():
            self.fix.remove(c)
        self.lines, self.panes, self.section = [], [], None

    def build(self):
        self.updating = True
        self.clear()
        self.build_sidebar()
        if self.st is None:
            self.build_down()
        else:
            getattr(self, "page_" + self.page)()
        self.fix.show_all()
        self.bg.queue_draw()
        self.updating = False

    def build_sidebar(self):
        up = ART.image("SCROLLER_UP")
        self.put(up or lab("▲", "side", 0.5), 26, 5)
        dn = ART.image("SCROLLER_DOWN")
        self.put(dn or lab("▼", "side", 0.5), 26, 703)
        for i, (key, icon, text) in enumerate(PAGES):
            y = 45 + i * 114
            name = icon + ("_ON" if key == self.page else "")
            img = ART.image(name) or ART.image(icon)
            if not img:
                img = Gtk.Image.new_from_icon_name(FALLBACK_ICON[key], Gtk.IconSize.DIALOG)
                img.set_pixel_size(56)
            b = Gtk.Button()
            b.get_style_context().add_class("flat")
            b.set_can_focus(False)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
            img.set_size_request(64, 64)
            box.pack_start(img, False, False, 0)
            if text is None:
                dev = (self.st or {}).get("device") or "3Dconnexion SpacePilot PRO"
                first, _, rest = dev.partition(" ")
                text = "%s\n%s" % (first, rest) if rest else dev
            l = lab(text, "side", 0.5)
            l.set_justify(Gtk.Justification.CENTER)
            box.pack_start(l, False, False, 0)
            box.set_size_request(SIDE_W - 6, -1)
            b.add(box)
            b.connect("clicked", lambda _b, k=key: self.go(k))
            self.put(b, 3, y)

    def go(self, page):
        self.page = page
        self.refresh_status()
        self.build()

    def build_down(self):
        x, y, w, h = PANEL
        self.section = ("IMAGE_SECTION_SETTINGS", "LCD Manager")
        self.put(lab("LCD Manager", "title"), x + 18, y + 22)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.get_style_context().add_class("banner")
        box.set_size_request(w - 80, -1)
        msg = lab("The LCD Manager service (tdx-lcdmgr) is not running.\n"
                  "Start it to manage the programs on the LCD.")
        msg.set_line_wrap(True)
        box.pack_start(msg, False, False, 0)
        start = win_button("Start LCD Manager", 160)
        start.set_halign(Gtk.Align.START)
        start.connect("clicked", self.start_service)
        box.pack_start(start, False, False, 0)
        self.put(box, x + 40, y + 420)

    def start_service(self, *_):
        if shutil.which("systemctl") and subprocess.run(
                ["systemctl", "--user", "start", "tdx-lcdmgr"], capture_output=True).returncode == 0:
            pass
        else:
            here = os.path.dirname(os.path.realpath(__file__))
            for cand in (os.path.join(here, "tdx-lcdmgr"),
                         os.path.join(here, "..", "build", os.uname().machine, "tdx-lcdmgr"),
                         shutil.which("tdx-lcdmgr")):
                if cand and os.access(cand, os.X_OK):
                    subprocess.Popen([cand], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    break
        GLib.timeout_add(800, lambda: (self.go(self.page), False)[1])

    # ---- device page
    def page_device(self):
        x, _y, w, _h = PANEL
        y = 24  # pane header tops as in LCDMon (screenshot: 24 and 664)
        if self.config_open:
            self.panes.append((y, "Configuration", True, 622))
            self.pane_header("Configuration", y, True, "config")
            self.device_config(x, y)
            ry = y + 622 + 18
        else:
            self.panes.append((y, "Configuration", False, 0))
            self.pane_header("Configuration", y, False, "config")
            ry = y + 40
        self.panes.append((ry, "Programs Running on This Device", self.running_open, 230))
        self.pane_header("Programs Running on This Device", ry, self.running_open, "running")
