    # ---- run / snapshot
    def run(self):
        set_window_icons(window_icon_files(ART.dir and os.path.join(os.path.dirname(ART.dir), "appicons"),
                                           "lcdmanager"), "tdxd-lcdmanager")
        win = self.win = Gtk.Window(title="LCD Manager")
        win.set_resizable(False)
        win.add(self.root)
        win.connect("destroy", Gtk.main_quit)
        win.show_all()
        GLib.timeout_add_seconds(2, self.tick)
        Gtk.main()

    def present(self):
        """Another start of tdx-lcdmanager: show this window instead."""
        win = getattr(self, "win", None)
        if win:
            win.deiconify()
            win.present()

    def tick(self):
        old = self.st
        self.refresh_status()
        if (old is None) != (self.st is None) or (
                old and self.st and [p["running"] for p in old["programs"]]
                != [p["running"] for p in self.st["programs"]]):
            self.build()
        return True

    def snapshot(self, outdir):
        os.makedirs(outdir, exist_ok=True)
        off = Gtk.OffscreenWindow()
        off.add(self.root)
        off.show_all()
        for page in [p[0] for p in PAGES]:
            self.page = page
            self.build()
            for _ in range(40):
                while Gtk.events_pending():
                    Gtk.main_iteration()
            surf = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
            self.root.draw(cairo.Context(surf))
            p = os.path.join(outdir, "tdx-lcdmanager-%s.png" % page)
            surf.write_to_png(p)
            print(p)


def main():
    global ART
    GLib.set_prgname("tdx-lcdmanager")  # Wayland app id = tdx-lcdmanager.desktop (taskbar icon)
    ap = argparse.ArgumentParser(description="LCD Manager window for tdx-lcdmgr")
    ap.add_argument("-s", "--socket", help="tdx-lcdmgr socket (default $XDG_RUNTIME_DIR/tdx-lcd.sock)")
    ap.add_argument("--assets", help="artwork extracted by tools/extract_3dxware_ui.py")
    ap.add_argument("--no-assets", action="store_true", help="use the built-in drawings")
    ap.add_argument("-p", "--page", choices=[p[0] for p in PAGES], default="device")
    ap.add_argument("--snapshot", metavar="DIR", help="render every page to DIR and exit")
    ap.add_argument("-V", "--version", action="version", version="tdx-lcdmanager " + APP_VERSION)
    args = ap.parse_args()
    ART = Art(args.assets, args.no_assets)
    install_css()
    app = LcdManager(args)
    app.page = args.page
    if args.snapshot:
        app.snapshot(args.snapshot)
        return 0
    single = single_instance()
    if single is None:
        return 0  # the open LCD Manager came to the front
    if single:
        single.connect("activate", lambda *_: app.present())
    app.build()
    app.run()
    return 0


APP_ID = "org.tdxd.LcdManager"


def single_instance():
    """One LCD Manager window per desktop session (as the settings panel): when
    one is open, starting another brings it to the front. The Gtk.Application
    holding the name, None when another window has it (told to come forward;
    exit), or False without a session bus (run anyway)."""
    gapp = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
    try:
        gapp.register(None)
    except GLib.Error:
        return False
    if not gapp.get_is_remote():
        return gapp
    gapp.activate()  # the window that's open: present()
    return None


if __name__ == "__main__":
    sys.exit(main())
