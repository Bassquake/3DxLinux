def lab(text, cls=None, xalign=0.0):
    l = Gtk.Label(label=text, xalign=xalign)
    for c in (cls or "").split():
        l.get_style_context().add_class(c)
    return l


def win_button(text, w, h=26):
    b = Gtk.Button(label=text)
    b.get_style_context().add_class("win")
    b.set_size_request(w, h)
    b.set_can_focus(False)
    return b


